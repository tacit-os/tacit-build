# On by default in Tacit: nobody should have to turn this on.
post_install() {
	systemd-tmpfiles --create tacit-cpu-policy.conf >/dev/null 2>&1 || true
	systemctl preset tacit-cpu-policy.service tacit-cpu-policy.path >/dev/null 2>&1 || true
	systemctl start tacit-cpu-policy.path >/dev/null 2>&1 || true
	udevadm control --reload-rules >/dev/null 2>&1 || true
}
# 0.2.0: the choice made in Settings (the path unit watches it; the file it watches is made here). The units are turned
# on by the update to 0.2.0 alone: run on every update, the preset turned them back on for a person who had turned them off
post_upgrade() {
	if (( $(vercmp "$2" 0.2.0) < 0 )); then
		post_install
		return
	fi
	systemd-tmpfiles --create tacit-cpu-policy.conf >/dev/null 2>&1 || true
	udevadm control --reload-rules >/dev/null 2>&1 || true
}
