def step_everyday_video(what):
    """a video in Thyris, paused, across a sleep: after the wake it is still paused where it was, and plays again"""
    person = Person()
    if what == "start":
        G.quit_app(person, "thyris")
        c = thyris_page(person, f"http://127.0.0.1:{PORT}/video.html")
        focus_thyris(person)
        end = now() + 15
        while now() < end and js(c, "document.title") != "ready":
            time.sleep(0.3)
        time.sleep(2)
        t = js(c, "(() => { const v = document.getElementById('v'); v.pause(); return v.currentTime; })()")
        c.close()
        open(f"{STATE}/video.json", "w").write(json.dumps({"t": t}))
        out(ok=t is not None and t > 0, at=t, why=None if t else "the video did not play")
    was = json.load(open(f"{STATE}/video.json"))["t"]
    if not G.thyris_answers():
        G.quit_app(person, "thyris")
        out(ok=False, why="Thyris does not answer after the wake")
    c = G.CDP(G.cdp_page(), timeout=10)
    st = json.loads(js(c, "JSON.stringify({p: document.getElementById('v').paused, t: document.getElementById('v').currentTime})"))
    js(c, "document.getElementById('v').play()")
    time.sleep(2)
    t2 = js(c, "document.getElementById('v').currentTime")
    c.close()
    G.quit_app(person, "thyris")
    why = []
    if not st["p"] or abs(st["t"] - was) > 0.5:
        why.append(f"the paused video moved ({was:.1f} s before the sleep, {st['t']:.1f} s after, paused {st['p']})")
    if not (t2 and t2 != st["t"]):
        why.append("it did not play again")
    out(ok=not why, why="; ".join(why) or None)


