def sound_playing(person, seconds=15, from_thyris=False):
    """a playing stream in PipeWire (from Thyris when asked) and the speaker's monitor hearing samples that are not zero"""
    end = now() + seconds
    level, streams = 0.0, []
    while now() < end:
        o = person.text(["pactl", "-f", "json", "list", "sink-inputs"], 5) or "[]"
        try:
            streams = [s for s in json.loads(o) if not s.get("corked") and not s.get("mute")]
        except ValueError:
            streams = []
        if from_thyris:
            streams = [s for s in streams if G.is_thyris(int(s.get("properties", {}).get("application.process.id", 0) or 0))]
        if streams:
            code, raw, _ = person.run(["timeout", "-s", "INT", "0.6", "parec", "--raw", "--latency-msec=20", "--format=s16le",
                                       "--channels=1", "--rate=16000", "-d", "@DEFAULT_MONITOR@"], 5)
            n = len(raw) // 2
            level = max((abs(v) for v in struct.unpack(f"<{n}h", raw[:n * 2])), default=0) / 32768 if n else 0.0
            if level > 0.01:
                return True, round(level, 3), [s.get("properties", {}).get("application.name", "?") for s in streams]
        time.sleep(0.5)
    return False, round(level, 3), [s.get("properties", {}).get("application.name", "?") for s in streams]


# ---------------------------------------------------------------- creator

def luma(img):
    if not img:
        return 0.0
    _, _, d = img
    vals = [0.2126 * d[i] + 0.7152 * d[i + 1] + 0.0722 * d[i + 2] for i in range(0, len(d) - 2, 3 * 7)]
    return sum(vals) / len(vals) if vals else 0.0


class OBS:
    """obs-websocket 5 (OBS's own remote control, switched on for the run in its settings), over the guest's WebSocket"""

    def __init__(self):
        self.c = G.CDP("ws://127.0.0.1:4455/", timeout=10)
        self.c.message()                                    # Hello
        self.c._frame(1, json.dumps({"op": 1, "d": {"rpcVersion": 1}}).encode())
        while self.c.message().get("op") != 2:              # Identified
            pass
        self.n = 0

    def call(self, kind, data=None):
        self.n += 1
        self.c._frame(1, json.dumps({"op": 6, "d": {"requestType": kind, "requestId": str(self.n), "requestData": data or {}}}).encode())
        while True:
            m = self.c.message()
            if m.get("op") == 7 and m["d"].get("requestId") == str(self.n):
                if not m["d"]["requestStatus"].get("result"):
                    raise OSError(f"OBS {kind}: {m['d']['requestStatus']}")
                return m["d"].get("responseData") or {}


def obs_ready(person):
    """OBS's settings for the run: its remote control on with no password, the first-start wizard passed"""
    d = f"{person.home}/.config/obs-studio"
    os.makedirs(f"{d}/plugin_config/obs-websocket", exist_ok=True)
    json.dump({"alerts_enabled": False, "auth_required": False, "first_load": False, "server_enabled": True,
               "server_password": "", "server_port": 4455}, open(f"{d}/plugin_config/obs-websocket/config.json", "w"))
    g = f"{d}/global.ini"
    if not os.path.exists(g):
        open(g, "w").write("[General]\nFirstRun=true\n")
    subprocess.run(["chown", "-R", f"{person.uid}:", d])


def frames(path):
    """one frame a second of a recording, as pictures (ffmpeg, which OBS needs)"""
    p = subprocess.run(["ffmpeg", "-v", "error", "-i", path, "-vf", "fps=1,scale=480:-1", "-f", "image2pipe", "-vcodec", "ppm", "-"],
                       capture_output=True, timeout=300)
    data, imgs = p.stdout, []
    while data.startswith(b"P6"):
        img = G.parse_ppm(data)
        if not img:
            break
        imgs.append(img)
        head = data.split(b"\n", 3)
        data = data[len(b"\n".join(head[:3])) + 1 + img[0] * img[1] * 3:]
    return imgs


def step_creator_record(seconds="60"):
    """OBS records window B (a window capture through the portal, as OBS's Window Capture (PipeWire) does it) for 60 s
    while window A has the focus; the recording's frames of B must be as bright as a recording of B with the focus
    (at least 90 %). Tacit's inactive_opacity made B see-through, and the recording dark, until the pointer went onto it."""
    person = Person()
    G.materials()
    light = f"{STATE}/light.png"
    if not os.path.exists(light):
        open(light, "wb").write(G.solid(1200, 900, (225, 225, 225)))
        os.chmod(light, 0o644)
    if not entry("obs"):
        out(ok=False, why="OBS Studio is not installed (Apps did not get it)")
    obs_ready(person)
    opacity = (person.hypr("getoption", "decoration:inactive_opacity") or {}).get("float")
    # B: Viewer showing a light grey picture; A: Settings
    G.quit_app(person, "viewer")
    person.spawn([person.which("viewer-open"), light])
    G.launch(person, "settings")
    end = now() + 30
    while now() < end and not (G.windows(person, "viewer") and G.windows(person, "settings")):
        time.sleep(0.3)
    b, a = G.windows(person, "viewer"), G.windows(person, "settings")
    if not (a and b):
        out(ok=False, why="Viewer and Settings did not both open")
    b, a = b[0]["address"], a[0]["address"]
    subprocess.run([sys.executable, "-I", f"{STATE}/daily-bench-guest", "picker", "window", b], capture_output=True)
    launch_entry(person, "obs")
    obs, end = None, now() + 60
    while obs is None and now() < end:
        try:
            obs = OBS()
        except (OSError, ValueError):
            time.sleep(1)
    if obs is None:
        out(ok=False, why="OBS did not start, or its remote control did not answer")
    focus = lambda addr: person.dispatch(f'hl.dsp.focus({{ window = "address:{addr}" }})')
    try:
        scene = obs.call("GetCurrentProgramScene")["currentProgramSceneName"]
        obs.call("CreateInput", {"sceneName": scene, "inputName": "Tacit Daily window", "inputKind": "pipewire-window-capture-source",
                                 "inputSettings": {}, "sceneItemEnabled": True})
        end, live = now() + 30, False
        while now() < end and not live:
            time.sleep(1)
            try:
                shot = obs.call("GetSourceScreenshot", {"sourceName": "Tacit Daily window", "imageFormat": "png", "imageWidth": 160})
                live = len(shot.get("imageData", "")) > 2000
            except OSError:
                pass
        if not live:
            out(ok=False, opacity=opacity, why="OBS's window capture showed nothing (the portal or PipeWire gave it no picture)")
        rec = {}
        for name, addr, secs in (("in use", b, 8), ("not in use", a, int(seconds))):
            focus(addr)
            time.sleep(1)
            obs.call("StartRecord")
            time.sleep(secs)
            rec[name] = obs.call("StopRecord").get("outputPath", "")
        obs.call("RemoveInput", {"inputName": "Tacit Daily window"})
    except OSError as e:
        out(ok=False, opacity=opacity, why=str(e))
    finally:
        subprocess.run([sys.executable, "-I", f"{STATE}/daily-bench-guest", "picker", "reset"], capture_output=True)
    lum = {name: brightness(path) for name, path in rec.items()}
    for p in rec.values():
        if p and os.path.exists(p):
            os.remove(p)
    for app in ("viewer", "settings"):
        G.quit_app(person, app)
    subprocess.run(["pkill", "-u", str(person.uid), "-x", "obs"])
    if not lum.get("in use") or lum.get("not in use") is None:
        out(ok=False, opacity=opacity, why="the recordings could not be read (ffmpeg)")
    ratio = lum["not in use"] / lum["in use"]
    why = dark(ratio, opacity)
    out(ok=why is None, ratio=round(ratio, 3), luma=lum, opacity=opacity, why=why)


def brightness(path):
    """the median brightness of a recording's frames, or None when it cannot be read"""
    fs = frames(path) if path and os.path.exists(path) else []
    return sorted(luma(f) for f in fs)[len(fs) // 2] if fs else None


def dark(ratio, opacity):
    """why the recording of the window not in use is too dark (under 90 % of it in use), or None"""
    if ratio >= 0.9:
        return None
    return (f"the window not in use came out at {ratio:.0%} of its brightness in use "
            f"(Hyprland's inactive_opacity is {opacity}): the recording is dark")


