# ---------------------------------------------------------------- gamer

def step_gamer_steam():
    """Steam started from its menu entry until its window shows (its sign-in, or its own update first); playing a game
    needs the account and a graphics card (HARDWARE-DAILY.md)"""
    person = Person()
    if not launch_entry(person, "steam"):
        out(ok=False, why="Steam is not installed (Apps did not get it)")
    t0 = now()
    while now() < t0 + 300:
        w = [c for c in person.clients() if "steam" in c.get("class", "").lower()]
        if w:
            subprocess.run(["pkill", "-u", str(person.uid), "-x", "steam"])
            out(ok=True, open_s=round(now() - t0, 1), title=w[0].get("title"))
        time.sleep(1)
    subprocess.run(["pkill", "-u", str(person.uid), "-x", "steam"])
    out(ok=False, why="Steam showed no window within 5 minutes")


def step_gamer_discord():
    """Discord started, its window closed: it keeps running in the background, and Activity (its own sampler) shows it"""
    person = Person()
    if not launch_entry(person, "discord"):
        out(ok=False, why="Discord is not installed (Apps did not get it)")
    t0 = now()
    w = []
    while now() < t0 + 120 and not w:
        w = [c for c in person.clients() if "discord" in c.get("class", "").lower()]
        time.sleep(1)
    if not w:
        out(ok=False, why="Discord showed no window within 2 minutes")
    for c in w:
        person.dispatch(f'hl.dsp.focus({{ window = "address:{c["address"]}" }})')
        person.dispatch("hl.dsp.window.close()")
    time.sleep(5)
    alive = subprocess.run(["pgrep", "-u", str(person.uid), "-if", "discord"], capture_output=True).returncode == 0
    code, o, _ = person.run(["timeout", "8", "python3", "-I", f"{person.shell}/scripts/activity/sample.py"], 12)
    shown = "discord" in o.decode(errors="replace").lower()
    subprocess.run(["pkill", "-u", str(person.uid), "-if", "discord"])
    why = [w for w, bad in (("Discord quit when its window closed", not alive), ("Activity does not show it", alive and not shown)) if bad]
    out(ok=not why, why="; ".join(why) or None)


def step_gamer_fullscreen(what):
    """a fullscreen window (Thyris after F11) left with Alt+Tab and come back to: fullscreen again, and it answers"""
    person = Person()
    if what == "start":
        G.quit_app(person, "thyris")
        G.launch(person, "settings")        # the window Alt+Tab goes to
        c = thyris_page(person, f"http://127.0.0.1:{PORT}/zoom.html")
        c.close()
        focus_thyris(person)
        out(ok=bool(G.windows(person, "thyris")))
    w = G.windows(person, "thyris")
    fs = bool(w and w[0].get("fullscreen"))
    active = (person.hypr("activewindow") or {}).get("address")
    if what == "full":
        out(ok=fs, why=None if fs else "F11 did not make Thyris fullscreen")
    if what == "away":
        out(ok=bool(w) and active != w[0]["address"], why=None if active != (w[0]["address"] if w else "") else "Alt+Tab did not leave it")
    back = bool(w) and active == w[0]["address"] and fs and G.thyris_answers()
    G.quit_app(person, "thyris")
    G.quit_app(person, "settings")
    out(ok=back, why=None if back else "Alt+Tab back did not bring it back fullscreen and answering")


