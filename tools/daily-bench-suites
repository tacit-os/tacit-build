    open(log, "w").close()
    os.chmod(log, 0o666)
    person.spawn(["python3", "-I", f"{person.shell}/scripts/store/stored.py", "install", pkg], log=log)
    out(ok=True, package=pkg)


def step_apps_wait(app):
    """how the install is going: its last phase, its result once there is one, and whether the desktop asks for the
    password now (the shell's polkit dialog)"""
    person, pkg = Person(), PACKAGES[app]
    lines = []
    for line in open(f"{STATE}/apps-{pkg}.log", errors="replace"):
        try:
            lines.append(json.loads(line))
        except ValueError:
            pass
    result = next((x for x in reversed(lines) if "result" in x), None)
    phase = next((x.get("phase") for x in reversed(lines) if x.get("phase")), "")
    ok = bool(result) and result.get("result") == "ok"
    out(done=result is not None, ok=ok, result=result, phase=phase, password="quickshell:polkit" in person.layers(),
        entry=entry(app) if ok else None,
        why=None if ok or not result else f"Apps could not get it: {result.get('result')} {result.get('detail', '')}".strip())


