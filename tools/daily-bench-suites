def entry(app):
    """the menu entry of an app got from Apps (a bundle's launcher is in the person's own applications folder)"""
    person = Person()
    for name in ENTRIES[app]:
        for d in (f"{person.home}/.local/share/applications", "/usr/share/applications"):
            if os.path.exists(f"{d}/{name}.desktop"):
                return f"{d}/{name}.desktop"
    return None


def launch_entry(person, app, *args):
    e = entry(app)
    if e:
        person.spawn(["gio", "launch", e, *args], log=f"{STATE}/{app}.log")
    return e


