def step_picker(what, *args):
    """the screen-share picker's choice (xdph's custom_picker_binary), made by the run instead of the person's click:
    `picker window <address>`, `picker screen`, `picker reset` (Tacit's own picker back)"""
    person = Person()
    conf = f"{person.home}/.config/hypr/xdph.conf"
    keep = f"{STATE}/xdph.conf.person"
    if what == "reset":
        if os.path.exists(keep):
            os.replace(keep, conf)
        elif os.path.exists(f"{STATE}/xdph.conf.none") and os.path.exists(conf):
            os.remove(conf)
        for f in (f"{STATE}/xdph.conf.none",):
            if os.path.exists(f):
                os.remove(f)
    else:
        json.dump({"kind": what, "address": args[0] if args else ""}, open(f"{STATE}/pick.json", "w"))
        os.chmod(f"{STATE}/pick.json", 0o644)
        with open(f"{STATE}/pick", "w") as f:
            f.write(f"#!/bin/sh\nexec /usr/bin/python3 -I {STATE}/daily-bench-guest pick-answer \"$@\"\n")
        os.chmod(f"{STATE}/pick", 0o755)
        if not os.path.exists(keep) and not os.path.exists(f"{STATE}/xdph.conf.none"):
            if os.path.exists(conf):
                os.replace(conf, keep)
            else:
                open(f"{STATE}/xdph.conf.none", "w").close()
        os.makedirs(os.path.dirname(conf), exist_ok=True)
        with open(conf, "w") as f:
            f.write(f"screencopy {{\n    custom_picker_binary = {STATE}/pick\n}}\n")
        subprocess.run(["chown", f"{person.uid}:", conf])
    person.run(["systemctl", "--user", "restart", "xdg-desktop-portal-hyprland.service"], 20)
    out(ok=True)


def pick_answer():
    """run by xdph as its picker: the window or screen pick.json names, in xdph's selection line"""
    want = json.load(open(f"{STATE}/pick.json"))
    if want["kind"] == "screen":
        mons = json.loads(subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True).stdout or "[]")
        print(f"[SELECTION]/screen:{mons[0]['name'] if mons else 'Virtual-1'}")
        return
    for ent in os.environ.get("XDPH_WINDOW_SHARING_LIST", "").split("[HA>]"):
        if "[HE>]" not in ent:
            continue
        wid, rest = ent.split("[HC>]", 1)
        f4 = rest.split("[HE>]", 1)[1].strip()
        try:
            if int(f4) == int(want["address"], 16):
                print(f"[SELECTION]/window:{wid.strip()}")
                return
        except ValueError:
            continue


