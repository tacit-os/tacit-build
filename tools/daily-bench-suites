def thyris_page(person, url, extra_flags=""):
    """Thyris (with its DevTools port) on url; the page's DevTools connection"""
    if not (G.running(person, "thyris") and G.thyris_answers()):
        G.quit_app(person, "thyris")
        flags = f"--remote-debugging-port={G.CDP_PORT} --remote-allow-origins=* {extra_flags}".strip()
        person.spawn([person.which("thyris"), "about:blank"], {"QTWEBENGINE_CHROMIUM_FLAGS": flags})
        end = now() + 45
        while now() < end and not G.thyris_answers():
            time.sleep(0.3)
    c = G.CDP(G.cdp_page(), timeout=30)
    c.send("Page.enable")
    c.send("Runtime.enable")
    c.events.clear()
    c.send("Page.navigate", {"url": url})
    c.wait("Page.loadEventFired", 30)
    return c


def js(c, expr, wait=False):
    r = c.send("Runtime.evaluate", {"expression": expr, "returnByValue": True, "awaitPromise": wait})
    return r.get("result", {}).get("result", {}).get("value")


def click(c, element_js):
    """a real click on the element (DevTools' mouse events, the page sees a person's gesture)"""
    rect = json.loads(js(c, f"JSON.stringify((({element_js}).getBoundingClientRect()))"))
    x, y = rect["x"] + rect["width"] / 2, rect["y"] + rect["height"] / 2
    for t in ("mousePressed", "mouseReleased"):
        c.send("Input.dispatchMouseEvent", {"type": t, "x": x, "y": y, "button": "left", "clickCount": 1})


