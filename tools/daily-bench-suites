def step_everyday_screenshot(what):
    """Ctrl+Print: a picture of the whole screen saved in Pictures/Screenshots and put on the clipboard"""
    person = Person()
    d = person.text(["xdg-user-dir", "PICTURES"]) or f"{person.home}/Pictures"
    d += "/Screenshots"
    if what == "before":
        out(ok=True, have=len(glob.glob(f"{d}/*.png")))
    time.sleep(2)
    shots = sorted(glob.glob(f"{d}/*.png"), key=os.path.getmtime)
    why = []
    new = shots[-1] if shots and os.path.getmtime(shots[-1]) > time.time() - 30 else None
    size = None
    if not new:
        why.append("no new picture in Pictures/Screenshots")
    else:
        head = open(new, "rb").read(24)
        size = struct.unpack(">II", head[16:24]) if head[:8] == b"\x89PNG\r\n\x1a\n" else None
        if not size or size[0] < 1000:
            why.append(f"the picture is not a screen's ({size})")
    types = person.text(["wl-paste", "--list-types"]) or ""
    if "image/png" not in types:
        why.append("the clipboard does not hold it")
    out(ok=not why, size=size, why="; ".join(why) or None)


