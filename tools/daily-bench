    # -- the workflow suites
    def install(self, app):
        r = self.guest("apps-install", app)
        typed, end = 0, time.time() + 2400
        while r.get("ok") is not False and time.time() < end:
            time.sleep(5)
            r = self.guest("apps-wait", app)
            if r.get("done"):
                return r
            if r.get("password") and typed < 2:
                if not self.pw:
                    return {"ok": False, "why": "Apps asks for the password (pacman), and the run has none"}
                self.type(self.pw)
                self.key("ret")
                typed += 1
        return {"ok": False, "why": r.get("why") or "Apps did not finish within 40 minutes"}

    def suite(self, name):
        title, steps = SUITES[name]
        rec = self.rec["suites"].setdefault(name, {"title": title, "steps": {}})
        self.guest("serve", "start")
        for sid, mark, core, words, needs in steps:
            s = {"mark": mark, "core": core, "words": words}
            rec["steps"][sid] = s
            if mark in ("ACCOUNT", "HARDWARE"):
                s["status"] = "needs a tester"
                continue
            if needs and rec["steps"].get(needs, {}).get("status") != "passed":
                s.update(status="not run", why=f"needs \"{rec['steps'][needs]['words']}\" first")
                continue
            if sid in PASSWORD_STEPS and not self.pw:
                s.update(status="not run", why="no password for the test account")
                continue
            try:
                r = getattr(self, "s_" + name + "_" + sid.replace("-", "_"))()
            except Exception as e:          # one step's surprise must not end the run: it is that step's failure
                r = {"ok": False, "why": f"the run's own error: {e!r}"}
            s["status"] = "passed" if r.get("ok") else "failed"
            if not r.get("ok"):
                s["why"] = r.get("why") or "failed"
            s["detail"] = {k: v for k, v in r.items() if k not in ("ok", "why")}
            self.log(f"{name}.{sid}: {s['status']} {s.get('why') or ''}")
            self.settle(f"{name}: {sid}")
            self.save()

