def stats(v):
    v = sorted(x for x in v if isinstance(x, (int, float)))
    if not v:
        return None
    n = len(v)
    med = v[n // 2] if n % 2 else (v[n // 2 - 1] + v[n // 2]) / 2
    return {"median": round(med, 2), "low": v[0], "high": v[-1], "n": n}


# ---------------------------------------------------------------- the run, on the cloud machine

class Unmeasured(Exception):
    """the run could not measure: the VM, QEMU or its agent did not answer, twice; never a pass, never Tacit's failure"""


# guest steps not tried a second time when the agent gave no answer: each may have done its part already (the computer
# asleep, a package installed, the home changed), and a second go would measure something else
NO_RETRY = {"suspend", "probe-repo", "update-arm", "lived-in-home", "lang-set", "apps-install", "sampler"}


def outcome(r):
    """worked, failed, or unmeasured: what a mirror, a site or the network failed is unmeasured, not Tacit's"""
    if r.get("outside"):
        return "unmeasured"
    o = r.get("outcome")
    return o if o in ("worked", "failed", "unmeasured") else ("worked" if r.get("ok") else "failed")


class Bench:
    def __init__(self, version, soak, runs, suites, lang=None, lived_in=None, day="", suites_only=False, repeat=1,
                 record=False):
        self.vmcmd = os.path.expanduser("~/tacit-vm/vm")
        self.lang, self.lived_in, self.day, self.suites_only = lang, lived_in, day, suites_only
        self.base, self.server = None, None
        pw = os.path.expanduser("~/tacit-vm/password")
        self.pw = open(pw).read().rstrip("\n") if os.path.exists(pw) else ""
        keys = os.environ.get("TACIT_VM_KEYS", "")
        self.typeflag = [f"--{keys}"] if keys in ("de", "gb") else []     # until the VM says which layout it has
        self.t0 = time.time()
        self.n = 0
        self.rep, self.repeat, self.part = 0, max(1, repeat), "preflight"
        self.fresh_base, self.isolation_why, self.start_saved = False, "not tried", False
        self.recording = None
        if record:
            os.makedirs(os.path.join(HERE, "record"), exist_ok=True)
            self.recording = open(os.path.join(HERE, "record", "exchanges.jsonl"), "a")
        self.rec = {"bench": "tacit-daily", "format": 2, "version": version, "mode": "soak" if soak else "short",
                    "soak_s": soak, "runs": runs, "repeat": self.repeat, "started": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                    "provisional": True, "kvm": os.path.exists("/dev/kvm"), "metrics": {}, "tasks": {},
                    "suites": {}, "reliability": {}, "not_run": [], "hardware_only": HARDWARE_ONLY,
                    "variant": variant(lang, lived_in, soak), "lang_run": lang, "parts": [], "infra": [],
                    "retries": [], "isolated": False}
        self.suites = suites

    # -- the VM: a fault of the machinery (QEMU, QMP, the agent) tried once more, then could-not-measure
    def vm(self, *args, timeout=60):
        t = time.time()
        try:
            p = subprocess.run([self.vmcmd, *map(str, args)], capture_output=True, text=True, timeout=timeout)
            code, o, e = p.returncode, p.stdout, p.stderr
        except subprocess.TimeoutExpired:
            code, o, e = 124, "", f"tools/vm {args[0]}: no answer in {timeout} s"
        if self.recording:      # --record: every exchange with the VM, for tools/daily-bench-test to replay
            self.recording.write(json.dumps({"argv": [str(a) for a in args], "code": code, "out": o, "err": e,
                                             "s": round(time.time() - t, 2), "part": self.part, "repeat": self.rep}) + "\n")
            self.recording.flush()
        return code, o, e

    def act(self, *args, timeout=60):
        """a tools/vm command the step needs done (a key, a click, a wake): a failure tried once more, then Unmeasured"""
        code, o, e = self.vm(*args, timeout=timeout)
        if code:
            self.rec["infra"].append({"what": " ".join(map(str, args[:2])), "why": (o + e).strip()[-200:], "part": self.part})
            code, o, e = self.vm(*args, timeout=timeout)
            if code:
                raise Unmeasured(f"could not measure: tools/vm {args[0]} failed twice ({(o + e).strip()[-160:]})")
        return o

    def until(self, cond, timeout, every=1.0):
        """cond() asked every `every` s until it gives something true, for at most `timeout` s: that value, or the last
        falsy one. The run's one wait for "until"; every other wait is a measurement and says so"""
        end = time.time() + timeout
        while True:
            v = cond()
            if v or time.time() >= end:
                return v
            time.sleep(min(every, max(0.0, end - time.time())))

    def guest(self, *args, timeout=120):
        """one step in the guest: its answer, with its outcome; no answer at all (the agent, QEMU) is tried once more,
        but for a step that may have done its part already, then could-not-measure"""
        whys = []
        for attempt in (1, 2):
            code, o, e = self.vm("run", "--timeout", timeout, "--", "/usr/bin/python3", "-I", GUEST, *args, timeout=timeout + 60)
            for line in reversed(o.splitlines()):
                if line.startswith("{"):
                    try:
                        r = json.loads(line)
                    except ValueError:
                        break
                    r["outcome"] = outcome(r)
                    if whys:
                        r["after_retry"] = whys[0]
                    return r
            whys.append((o + e).strip()[-240:] or f"exit {code}")
            self.rec["infra"].append({"what": f"guest {args[0]}", "why": whys[-1], "part": self.part, "attempt": attempt})
            if args[0] in NO_RETRY:
                break
        return {"ok": False, "outcome": "unmeasured",
                "why": f"could not measure: no answer from the test computer to {args[0]} ({'; '.join(whys)[:300]})"}

    def need(self, r, what):
        """a step's own setup: unless it worked, the step cannot be measured"""
        if outcome(r) != "worked":
            raise Unmeasured(f"could not measure: {what}: {r.get('why')}")
        return r

    def key(self, *names):
        self.act("key", *names)

    def type(self, text):
        self.act("type", *self.typeflag, text)

    def wait(self, kind, arg="", timeout=10):
        """what the run waits for between its keys (a surface, a window, the screen settled), instead of a pause"""
        return self.guest("await", kind, arg, timeout, timeout=timeout + 30)

    def relayout(self):
        """type for the layout Hyprland has now (its first: the one active at a sign-in and after a switch back), as a
        person does: a German computer types German, and one an old override left on US types US"""
        first = str(self.guest("lang-state").get("layout") or "").split(",")[0]
        if first:
            self.typeflag = [f"--{first}"] if first in ("de", "gb") else []

    def log(self, *a):
        print(f"[{(time.time() - self.t0) / 60:5.1f} min]", *a, flush=True)

    # -- the record
    def metric(self, name, section, unit, words, value):
        if value is None:
            return
        m = self.rec["metrics"].setdefault(name, {"section": section, "unit": unit, "words": words, "samples": [], "at": []})
        m["samples"].append(round(value, 2))
        m["at"].append(round((time.time() - self.t0) / 60, 1))

    def task(self, name, r):
        """a daily task's run: worked, failed, or could not be measured, each counted apart"""
        t = self.rec["tasks"].setdefault(name, {"words": TASKS[name], "runs": 0, "worked": 0, "failed": 0, "unmeasured": 0,
                                                 "why": [], "unmeasured_why": [], "outcomes": [], "retries": []})
        o = outcome(r)
        why = r.get("why") or ("failed" if o == "failed" else "could not measure")
        if r.get("outside") and not why.startswith("outside Tacit"):
            why = f"outside Tacit: {why}"
        t["runs"] += 1
        t[o] += 1
        t["outcomes"].append([self.rep, o])
        if o == "failed":
            t["why"].append(why)
        elif o == "unmeasured":
            t["unmeasured_why"].append(why)
        if r.get("retried"):
            t["retries"].append(r["retried"])
        self.log(f"{name}: {o}" + ("" if o == "worked" else f" ({why})"))
        return o == "worked"

    def attempt(self, name, fn, *a):
        """a task, where the machinery failing twice makes it could-not-measure instead of ending the run"""
        try:
            return fn(*a)
        except Unmeasured as e:
            return self.task(name, {"outcome": "unmeasured", "why": str(e)})

    def not_run(self, what, why):
        if not any(x["what"] == what for x in self.rec["not_run"]):
            self.rec["not_run"].append({"what": what, "why": why})

    def save(self, path="daily.json"):
        self.rec["minutes"] = round((time.time() - self.t0) / 60, 1)
        json.dump(self.rec, open(path + ".tmp", "w"), indent=1)
        os.replace(path + ".tmp", path)

    def settle(self, task):
        s = self.guest("settle", task)
        for kind in ("layers", "windows"):
            for x in s.get(kind) or []:
                self.rec["reliability"].setdefault("stuck", []).append(f"after {task}: {x}")

    # -- presses timed in the VM
    def press(self, spec, act, limit=30):
        self.n += 1
        ident = f"{spec}-{self.n}"
        a = self.guest("arm", spec, ident)
        if outcome(a) != "worked":
            return dict(a, outcome="unmeasured", why=f"could not measure: the key listener: {a.get('why')}")
        act()
        return self.guest("result", ident, limit, timeout=limit + 30)

    # -- a known state: QEMU's snapshots of the whole running computer
    def snapshot(self, how, name):
        """vm snapshot save|load|delete <name>, once more on a fault: (worked, what it said)"""
        for _ in (1, 2):
            code, o, e = self.vm("snapshot", how, name, timeout=1200)
            if code == 0:
                return True, ""
            said = (o + e).strip()[-300:]
            self.rec["infra"].append({"what": f"snapshot {how} {name}", "why": said, "part": self.part})
            if "does not support snapshots" in said:
                break
        return False, said

    def start_isolation(self):
        """the computer as found saved first (daily-start, loaded again at the end, so the run leaves it as it was);
        snapshots hold its memory as well as its disk, so the cloud machine's free space is asked first"""
        used = self.guest("before-snapshot").get("used_mb") or 8192
        free = shutil.disk_usage(os.path.expanduser("~/tacit-vm")).free // 2**20
        need = 2 * used + 2048
        if free < need:
            self.isolation_why = f"the cloud machine has {free} MB free, and two snapshots need about {need} MB"
        else:
            ok, said = self.snapshot("save", "daily-start")
            if not ok and "does not support snapshots" in said and self.pw:
                # the UEFI variables are raw, which savevm refuses: made qcow2 once, with the computer off
                self.log("the UEFI variables made qcow2 for snapshots (once): a restart")
                self.vm("run", "--timeout", 15, "--", "systemctl", "poweroff", timeout=40)
                if self.until(lambda: self.vm("status")[0] != 0, 180, every=1) and self.vm("snapshot", "prepare")[0] == 0 \
                        and self.vm("disk", timeout=120)[0] == 0 and outcome(self.through_boot_lock(time.time(), measure=False)) == "worked":
                    ok, said = self.snapshot("save", "daily-start")
            self.start_saved = ok
            self.isolation_why = None if ok else f"the computer could not be saved: {said}"
        self.rec["isolated"] = self.isolation_why is None
        if self.isolation_why:
            self.not_run("a known state for each part (each starts from where the one before left the computer)", self.isolation_why)
        self.log(f"snapshots: {'yes' if self.rec['isolated'] else 'no, ' + self.isolation_why}")

    def save_base(self):
        """the state every part starts from: the run's own setup done (a language, a lived-in update), the desktop
        ready, the sampler on"""
        if not self.rec["isolated"]:
            return
        self.guest("before-snapshot")
        ok, said = self.snapshot("save", "daily-base")
        if ok:
            self.fresh_base = True
        else:
            self.rec["isolated"], self.isolation_why = False, f"the run's base could not be saved: {said}"
            self.not_run("a known state for each part", self.isolation_why)

    def part_from_base(self, name, fn):
        """one part of the run from the known state: daily-base loaded (the first part runs straight from its save) and
        the desktop ready; then the part; then what went wrong in it gathered, before the next load rolls it back"""
        self.part = name
        p = {"name": name, "repeat": self.rep}
        if self.rec["isolated"]:
            if self.fresh_base:
                self.fresh_base, p["from"] = False, "daily-base, just saved"
            else:
                ok, said = self.snapshot("load", "daily-base")
                ready = self.guest("ready", timeout=240) if ok else {}
                if not ok or outcome(ready) != "worked":
                    p.update(outcome="unmeasured", why=f"could not measure: the known state: {said or ready.get('why')}")
                    self.rec["parts"].append(p)
                    self.log(f"part {name}: {p['why']}")
                    return
                p["from"] = "daily-base"
        else:
            p["from"] = f"where the part before left it ({self.isolation_why})"
        self.log(f"part {name} (from {p['from']})")
        try:
            fn()
            p["outcome"] = "measured"
        except Unmeasured as e:
            p.update(outcome="unmeasured", why=str(e))
        self.reliability()
        self.rec["parts"].append(p)
        self.save()

    # -- the parts of a run
    def preflight(self):
        code, o, e = self.vm("agent", timeout=20)
        if code:
            code, o, e = self.vm("agent", timeout=20)
        if code:
            self.rec["error"] = "could not measure: the test computer's guest agent does not answer"
            self.save()
            sys.exit("daily-bench: the test computer's guest agent does not answer. Start the test disk with this "
                     "checkout's tools/vm (off, then vm disk) and wait until its lock screen shows; a system installed "
                     "from a tools/iso image has qemu-guest-agent (tools/vm-smoke says more).")
        for name in ("daily-bench-guest", "daily-bench-suites", "vm-smoke-guest"):
            self.act("run", "--stdin", name, "--", "/bin/sh", "-c", f"mkdir -p /var/tmp/daily && cat > /var/tmp/daily/{name}")
        if (self.lang or self.lived_in) and not self.pw:
            self.rec["error"] = "--lang and --lived-in restart the computer and sign in again: they need the test account's password"
            self.save()
            sys.exit(f"daily-bench: {self.rec['error']}")
        # a lived-in run starts on the release before, and updates to this one
        p = self.guest("preflight", self.lived_in or self.rec["version"])
        self.rec["tacit"], self.rec["hyprland"], self.rec["language"] = p.get("tacit"), p.get("hyprland"), p.get("language")
        if outcome(p) != "worked":
            self.rec["error"] = p.get("why")
            self.save()
            sys.exit(f"daily-bench: {p.get('why')}")
        self.serve()
        self.start_isolation()
        if self.lang:
            self.set_language()
        if self.lived_in:
            self.lived_in_update()
        self.relayout()
        self.guest("sampler", "start")
        self.guest("ready", timeout=240)
        self.rec["disk_start"] = self.guest("disk")
        self.save_base()
        if not self.pw:
            for what in ("the start and the sign-in", "lock and unlock", "sleep and wake", "the update through Restart"):
                self.not_run(what, "no password for the test account (TACIT_VM_PASSWORD, or ~/tacit-vm/password on the cloud machine)")

    def serve(self):
        """the local video and the lived-in run's test repo, served from here to the VM (QEMU's user network takes the
        guest's 10.0.2.2 to this machine's 127.0.0.1)"""
        root = os.path.join(HERE, "serve")
        os.makedirs(root, exist_ok=True)
        for name, target in (("repo", os.path.join(HERE, "repo")), ("media", os.path.expanduser("~/tacit-vm/media"))):
            if os.path.isdir(target) and not os.path.exists(os.path.join(root, name)):
                os.symlink(target, os.path.join(root, name))
        s = socket.socket()
        s.bind(("127.0.0.1", 0))
        port = s.getsockname()[1]
        s.close()
        self.server = subprocess.Popen([sys.executable, "-m", "http.server", str(port), "--bind", "127.0.0.1", "--directory", root],
                                       stdout=open(os.path.join(HERE, "http.log"), "w"), stderr=subprocess.STDOUT)
        self.base = f"http://10.0.2.2:{port}"

    def down(self):
        """the computer gone down for a restart: its agent no longer answering, for at most 4 minutes"""
        if not self.until(lambda: self.vm("agent", timeout=10)[0] != 0, 240, every=2):
            raise Unmeasured("could not measure: did not happen in 240 s: the computer going down for the restart")

    def reboot(self):
        """a restart and the sign-in through the boot lock"""
        self.vm("run", "--timeout", 10, "--", "systemctl", "reboot", timeout=40)
        self.down()
        return self.through_boot_lock(time.time(), measure=False)

    def set_language(self):
        L = LANGS[self.lang]
        r = self.guest("lang-set", L["locale"], L["layout"], timeout=300)
        if outcome(r) != "worked":
            self.rec["error"] = f"the language could not be set: {r.get('why')}"
            self.finish()
            sys.exit(f"daily-bench: {self.rec['error']}")
        u = self.reboot()
        st = self.guest("lang-state")
        self.rec["language"] = {k: st.get(k) for k in ("lang", "layout", "active")}
        self.rec["language"]["set"] = f"{L['words']} ({L['locale']}, keyboard {L['layout']})"
        if outcome(u) != "worked":
            self.rec["error"] = f"no sign-in after setting {L['words']}: {u.get('why')}"
            self.finish()
            sys.exit(f"daily-bench: {self.rec['error']}")
        self.log(f"language: {self.rec['language']}")

    def language_checks(self):
        """what breaks only in another language: the Network page's IP, a VPN's state, the lock with the layout active"""
        self.task("lang-network", self.guest("lang-network", timeout=120))
        self.task("lang-vpn", self.guest("lang-vpn", timeout=150))
        L, why, retried = LANGS[self.lang], [], None
        if L["second"]:
            self.key("alt", "shift")            # the person was typing in their own letters (Setup's Alt+Shift)
            if outcome(self.wait("keymap", L["words"], 5)) != "worked":
                why.append(f"Alt+Shift did not switch to {L['words']} (the keyboard is {self.guest('lang-state').get('active')})")
        r = self.press("lock", lambda: self.key("meta_l", "l"))
        if outcome(r) == "unmeasured":
            raise Unmeasured(r.get("why"))
        if outcome(r) != "worked":
            why.append(f"Super+L did not lock with {L['words']} active ({r.get('why')})")
            self.need(self.guest("lock-now"), "locking through the shell instead")
        u = self.unlock()
        if outcome(u) == "failed":
            why.append(f"the password typed with {L['words']} active did not unlock it")
            self.key("alt", "shift")            # to the Latin layout, as a person would try next, so the run goes on
            u2 = self.unlock()
            retried = {"first": why[-1], "second": "unlocked with the Latin layout" if outcome(u2) == "worked" else u2.get("why")}
            u = u2
        if L["second"] and L["words"].lower()[:4] in str(self.guest("lang-state").get("active", "")).lower():
            self.key("alt", "shift")            # back to the first layout for the rest of the run
        self.settle("lang-lock")
        self.task("lang-lock", {"ok": not why, "why": "; ".join(why) or None, "retried": retried,
                                "outcome": "unmeasured" if outcome(u) == "unmeasured" and not why else None})
        if outcome(u) != "worked" and not self.rec["isolated"]:
            self.rec["error"] = "the computer stayed locked after the language's lock check"
            self.finish()
            sys.exit(f"daily-bench: {self.rec['error']}")

    def lived_in_update(self):
        """the release before, with a lived-in home, updated through Restart from tools/vm-smoke's test repo (its own
        guest steps: the repo in pacman.conf, the download and the install armed as Settings runs them), then judged on
        that home after the restart"""
        self.act("run", "--stdin", "home.json", "--", "/bin/sh", "-c", "cat > /var/tmp/daily/home.json")
        h = self.guest("lived-in-home", "/var/tmp/daily/home.json", self.day, timeout=120)
        self.rec["lived_in"] = {"from": self.lived_in, "home": h.get("settings"), "made": h}
        # the release before reads the home as it starts, and runs on it: its settings file left alone by it for 3 s
        self.guest("ready", "", timeout=240)
        self.relayout()
        code, o, e = self.vm("run", "--timeout", 1800, "--", "/bin/bash", "/var/tmp/daily/vm-smoke-guest", "update",
                             f"{self.base}/repo", timeout=1900)
        if "armed" not in o.splitlines():
            self.rec["lived_in"]["checks"] = {"updated": [False, f"the update was not armed: {(o + e).strip()[-200:]}"]}
            self.vm("run", "--", "/bin/bash", "/var/tmp/daily/vm-smoke-guest", "restore-pacman")
            self.rec["error"] = "the lived-in update did not start"
            self.finish()
            sys.exit(f"daily-bench: {self.rec['error']}")
        u = self.reboot()
        self.vm("run", "--", "/bin/bash", "/var/tmp/daily/vm-smoke-guest", "restore-pacman")
        self.guest("ready", timeout=240)            # the shell and its migration settled
        c = self.guest("lived-in-check", self.rec["version"], timeout=120)
        self.rec["lived_in"]["checks"] = c.get("checks") or {"updated": [None if outcome(c) == "unmeasured" else False,
                                                                         c.get("why") or "no answer"]}
        if outcome(u) != "worked":
            self.rec["lived_in"]["checks"]["signed in"] = [False if outcome(u) == "failed" else None,
                                                           f"after the update's restart: {u.get('why')}"]
        p = self.guest("preflight", self.rec["version"])
        self.rec["tacit"] = p.get("tacit")
        if outcome(p) != "worked":
            self.rec["error"] = f"after the update: {p.get('why')}"
            self.finish()
            sys.exit(f"daily-bench: {self.rec['error']}")

    def app_starts(self, rounds):
        for app in ("settings", "files", "thyris", "praxis", "graphis", "viewer"):
            for _ in range(rounds):
                for kind in ("cold", "warm"):
                    r = self.guest("start", app, kind, timeout=120)
                    self.metric(f"start.{app}.{kind}", "speed", "ms", f"{APP_WORDS[app]}, {kind} start", r.get("answers_ms"))
                    if outcome(r) == "failed":
                        self.rec["reliability"].setdefault("start_failures", []).append(f"{app} ({kind}): {r.get('why')}")
            self.guest("quit", app)
            self.settle(f"{app}'s starts")

    def page_load(self, runs):
        r = self.guest("page-load", runs, timeout=300)
        for row in r.get("runs") or []:
            for k, words in (("load", "a page load in Thyris, to its load event"), ("fcp", "a page load in Thyris, to its first paint")):
                self.metric(f"page.{k}", "speed", "ms", words, row.get(k) or None)
        if outcome(r) == "failed":
            self.rec["reliability"].setdefault("start_failures", []).append(f"page load: {r.get('why')}")
        self.guest("quit", "thyris")

    def search(self):
        self.guest("quit", "graphis")
        r = self.press("search", lambda: self.key("meta_l"))
        self.metric("search.shown", "speed", "ms", "Search, from the key to shown", r.get("ms"))
        if outcome(r) != "worked":
            self.key("esc")
            return self.task("search", dict(r, why=f"search did not show: {r.get('why')}"))
        self.need(self.wait("settled", "", 10), "the dock shown and still")
        self.type("graphis")
        self.need(self.wait("settled", "", 10), "the search's results drawn")
        self.key("ret")
        up = self.guest("up", "graphis", 30, timeout=60)
        self.guest("quit", "graphis")
        self.settle("search")
        return self.task("search", up if outcome(up) == "worked" else dict(up, why=f"Enter on \"graphis\" in search: {up.get('why')}"))

    def notch(self):
        why = []
        for spec, act in (("notch-open", lambda: self.key("meta_l", "spc")), ("notch-esc", lambda: self.key("esc")),
                          ("notch-open", lambda: self.key("meta_l", "spc")), ("notch-click", lambda: self.act("click", 960, 900))):
            r = self.press(spec, act)
            if outcome(r) == "unmeasured":
                raise Unmeasured(r.get("why"))
            if spec == "notch-open":
                self.metric("notch.shown", "speed", "ms", "The notch, from the key to shown", r.get("ms"))
            if outcome(r) != "worked":
                why.append(f"{spec}: {r.get('why')}")
                if spec == "notch-open":
                    break
        self.key("esc")
        self.settle("notch")
        return self.task("notch", {"ok": not why, "why": "; ".join(why)})

    def unlock(self):
        """the password typed into the lock and Enter: unlocked, the shell answering. Typing into the VM can drop a key, so
        a failed unlock is tried once more, and both results are kept (never a silent second chance)"""
        r = self.press("enter-unlocked", lambda: (self.type(self.pw), self.key("ret")), 40)
        if outcome(r) == "failed":
            self.key("esc")
            r2 = self.press("enter-unlocked", lambda: (self.type(self.pw), self.key("ret")), 40)
            r2["retried"] = {"first": r.get("why"), "second": "worked" if outcome(r2) == "worked" else r2.get("why")}
            self.rec["retries"].append({"what": "unlock", "part": self.part, **r2["retried"]})
            return r2
        return r

    def lock(self):
        r = self.press("lock", lambda: self.key("meta_l", "l"))
        if outcome(r) != "worked":
            return self.task("lock", dict(r, why=f"Super+L did not lock: {r.get('why')}"))
        u = self.unlock()
        self.metric("unlock", "speed", "ms", "Unlock, from Enter to the desktop answering", u.get("ms"))
        self.settle("lock")
        return self.task("lock", u if outcome(u) == "worked" else dict(u, why=f"the password did not unlock it: {u.get('why')}"))

    def sleep_wake(self, task="sleep", measure=True):
        """systemctl suspend; QEMU says it sleeps; QMP's system_wakeup; the desktop answers again, through the lock"""
        self.guest("suspend")
        if not self.until(lambda: self.vm("status")[1].strip() == "suspended", 60, every=1):
            r = {"ok": False, "why": "did not happen in 60 s: QEMU saying the computer sleeps, after systemctl suspend"}
            return self.task(task, r) if task in TASKS else r
        time.sleep(5)       # asleep for 5 s: what is done (a lid shut a moment), not a wait for something
        t = time.time()
        self.act("wake")
        if not self.until(lambda: self.vm("agent", timeout=10)[0] == 0, 120, every=0.5):
            r = {"ok": False, "why": "did not happen in 120 s: the system answering after the wake"}
            return self.task(task, r) if task in TASKS else r
        if measure:
            self.metric("wake.agent", "speed", "s", "Wake, until the system answers", time.time() - t)
        d = self.guest("desktop")
        if d.get("locked"):
            u = self.unlock()
            d = self.guest("desktop") if outcome(u) == "worked" else dict(u, why=f"after the wake the password did not unlock it: {u.get('why')}")
        if measure:
            self.metric("wake.desktop", "speed", "s", "Wake, until the desktop answers (through the lock)",
                        time.time() - t if outcome(d) == "worked" else None)
        r = d if outcome(d) == "worked" else dict(d, why=f"after the wake: {d.get('why')}")
        self.settle("sleep")
        return self.task(task, r) if task in TASKS else r

    def boot(self):
        """off, power on (vm disk), to the sign-in screen and through it to a desktop that answers"""
        self.vm("run", "--timeout", 15, "--", "systemctl", "poweroff", timeout=40)
        if not self.until(lambda: self.vm("status")[0] != 0, 120, every=1):
            self.rec["reliability"].setdefault("stuck", []).append("the VM did not power off within 2 minutes: switched off")
            self.act("stop")
            if not self.until(lambda: self.vm("status")[0] != 0, 30, every=0.5):
                raise Unmeasured("could not measure: did not happen in 30 s: QEMU gone after vm stop")
        t0 = time.time()
        self.act("disk", timeout=120)
        return self.through_boot_lock(t0)

    def through_boot_lock(self, t0, measure=True):
        """from the power on (t0) to the sign-in screen, the password typed, to a desktop that answers; measured only for
        a power on (a restart's t0 is when the system went down, not when the firmware started)"""
        seen = {"pre": None, "st": {}}

        def sign_in_shown():
            t = time.time()
            if self.vm("agent", timeout=10)[0]:
                return False
            st = self.guest("boot-state")
            if "uptime" in st:
                if seen["pre"] is None:
                    seen["pre"] = t - t0 - st["uptime"]     # firmware and boot loader: before the kernel's clock starts
                seen["st"] = st
                return bool(st.get("bootlock") and st["bootlock"].get("at") is not None)
            return False
        if not self.until(sign_in_shown, 600, every=1):
            return {"ok": False, "why": "did not happen in 600 s: the sign-in screen, after the power on"}
        if measure:
            self.metric("boot.sign_in", "speed", "s", "Power on to the sign-in screen", seen["pre"] + seen["st"]["bootlock"]["at"])
        self.relayout()
        u = self.press("enter-usable", lambda: (self.type(self.pw), self.key("ret")), 120)
        if outcome(u) == "failed":      # a dropped key while typing: once more, both kept
            self.key("esc")
            u2 = self.press("enter-usable", lambda: (self.type(self.pw), self.key("ret")), 120)
            self.rec["retries"].append({"what": "sign-in", "part": self.part, "first": u.get("why"),
                                        "second": "worked" if outcome(u2) == "worked" else u2.get("why")})
            u = u2
        if measure:
            self.metric("boot.desktop", "speed", "ms", "Sign-in to a desktop that answers", u.get("ms"))
        self.guest("ready", timeout=240)
        self.guest("sampler", "start")
        if self.suites:
            self.guest("serve", "start")
        return u

    def update(self, n, task="update"):
        """the soak's update: a new version of a probe package in a test repo, got as Settings gets it, installed at
        the restart Restart asks for, through the boot lock"""
        r = self.guest("probe-repo", n, timeout=300)
        if outcome(r) == "worked":
            r = self.guest("update-arm", timeout=1800)
        if outcome(r) == "worked":
            r = self.reboot()
            if outcome(r) == "worked":
                r = self.guest("update-done", n)
        self.guest("probe-clean", timeout=300)
        return self.task(task, r) if task in TASKS else r

    def round(self, i):
        self.attempt("sound", lambda: self.task("sound", self.guest("sound", timeout=180)))

        def wallpaper():
            r = self.guest("wallpaper", timeout=120)
            self.metric("wallpaper.shown", "speed", "ms", "A wallpaper change, until the desktop shows it", r.get("shown_ms"))
            self.task("wallpaper", r)
            self.settle("wallpaper")
        self.attempt("wallpaper", wallpaper)
        self.attempt("files-preview", lambda: (self.task("files-preview", self.guest("files-preview", timeout=120)),
                                               self.settle("files-preview")))
        self.attempt("search", self.search)
        self.attempt("notch", self.notch)

        def praxis():
            r = self.guest("praxis", timeout=120)
            self.metric("praxis.list", "speed", "ms", "Praxis, from its start to its session list", r.get("list_ms"))
            self.task("praxis", r)
            self.guest("quit", "praxis")
            self.settle("praxis")
        self.attempt("praxis", praxis)

        def check():
            r = self.guest("update-check", timeout=1000)
            self.metric("update.check", "speed", "s", "A check for updates", r.get("seconds"))
            self.task("update-check", r)
        self.attempt("update-check", check)
        if self.pw:
            self.attempt("lock", self.lock)
            self.attempt("sleep", self.sleep_wake)

    def rounds(self, runs):
        """the daily tasks, `runs` times over, and the memory the long-lived processes took on doing them"""
        before = self.guest("memory").get("pss", {})
        for i in range(runs):
            self.log(f"tasks, round {i + 1} of {runs}")
            self.round(i)
            self.save()
        self.growth(before, self.guest("memory").get("pss", {}))

    def idle(self, total=600, windows=5, window=60, samples=3):
        o = self.guest("open-all", timeout=400)
        if outcome(o) != "worked":
            self.rec["reliability"].setdefault("start_failures", []).append(f"before the rest: {o.get('why')}")
        r = self.guest("idle", total, windows, window, samples, timeout=total + 200)
        for k, v in (r.get("pss") or {}).items():
            for x in v:
                self.metric(f"pss.{k}", "lightness", "MB", f"{APP_WORDS.get(k, k)}: memory after {total // 60} minutes at rest", x)
        for k, v in (r.get("cpu") or {}).items():
            for x in v:
                self.metric(f"cpu.{k}", "lightness", "%", f"{APP_WORDS.get(k, k)}: processor at rest", x)
        for k, v in (r.get("wakeups") or {}).items():
            for x in v:
                self.metric(f"wakeups.{k}", "lightness", "/s", f"{APP_WORDS.get(k, k)}: wakeups at rest", x)
        for x in r.get("system_cpu") or []:
            self.metric("cpu.all", "lightness", "%", "Everything: processor at rest", x)
        self.guest("close-all", timeout=200)
        self.disk()

    def growth(self, before, after, hours=None):
        for k, b in before.items():
            a = after.get(k)
            if a and a.get("pid") == b.get("pid"):
                if hours:
                    self.metric(f"growth.{k}", "lightness", "MB/h", f"{APP_WORDS.get(k, k)}: memory growth an hour", (a["mb"] - b["mb"]) / hours)
                else:
                    self.metric(f"growth.{k}", "lightness", "MB", f"{APP_WORDS.get(k, k)}: memory growth over the tasks", a["mb"] - b["mb"])

    def reliability(self):
        r = self.guest("reliability", timeout=300)
        rel = self.rec["reliability"]
        for k in ("crashes", "qml", "warnings", "not_answering"):
            have = rel.setdefault(k, [])
            have += [x for x in r.get(k) or [] if x not in have]
        j = rel.setdefault("journal", {})
        for k, v in (r.get("journal") or {}).items():
            j[k] = max(j.get(k, 0), v)

    def disk(self):
        d = self.guest("disk")
        for k, v in (d.get("mb") or {}).items():
            self.metric(f"disk.{k}", "lightness", "MB", f"Disk: {k}", v)
        self.rec["disk_end"] = d

    def boots(self, runs):
        for i in range(runs):
            self.log(f"start {i + 1} of {runs}")
            self.boot()
            self.save()

    # -- the workflow suites
    def install(self, app):
        r = self.guest("apps-install", app)
        if outcome(r) != "worked":
            return r
        typed = [0]

        def finished():
            w = self.guest("apps-wait", app)
            if w.get("done") or outcome(w) == "unmeasured":
                return w
            if w.get("password") and typed[0] < 2:
                if not self.pw:
                    return {"ok": False, "outcome": "unmeasured", "why": "Apps asks for the password (pacman), and the run has none"}
                self.type(self.pw)
                self.key("ret")
                typed[0] += 1
            return None
        w = self.until(finished, 2400, every=5)
        return w or {"ok": False, "why": "did not happen in 2400 s: Apps finishing the install"}   # its "outside" says whether a mirror failed

    def suite(self, name):
        title, steps = SUITES[name]
        rec = self.rec["suites"].setdefault(name, {"title": title, "steps": {}})
        self.need(self.guest("serve", "start"), "the local pages served")
        now_ = {}
        for sid, mark, core, words, needs in steps:
            s = rec["steps"].setdefault(sid, {"mark": mark, "core": core, "words": words, "outcomes": []})
            if mark in ("ACCOUNT", "HARDWARE"):
                s["status"] = now_[sid] = "needs a tester"
                continue
            if needs and now_.get(needs) != "worked":
                was = now_.get(needs)
                s.update(status="not run", why=f"needs \"{rec['steps'][needs]['words']}\" first"
                         + (", which could not be measured" if was == "unmeasured" else ""))
                now_[sid] = "not run"
                continue
            if sid in PASSWORD_STEPS and not self.pw:
                s.update(status="not run", why="no password for the test account")
                now_[sid] = "not run"
                continue
            self.part = f"suite {name}: {sid}"
            try:
                r = getattr(self, "s_" + name + "_" + sid.replace("-", "_"))()
            except Unmeasured as e:
                r = {"ok": False, "outcome": "unmeasured", "why": str(e)}
            except Exception as e:          # the bench's own fault: never a pass, never Tacit's failure
                r = {"ok": False, "outcome": "unmeasured", "why": f"could not measure: the bench's own error: {e!r}"}
            o = outcome(r)
            why = r.get("why") or ("failed" if o == "failed" else "could not measure")
            if r.get("outside") and not why.startswith("outside Tacit"):
                why = f"outside Tacit: {why}"
            s["status"] = now_[sid] = o
            s["outcomes"].append([self.rep, o])
            s["why"] = None if o == "worked" else why
            s["detail"] = {k: v for k, v in r.items() if k not in ("ok", "why", "outcome")}
            self.log(f"{name}.{sid}: {o} {s['why'] or ''}")
            self.settle(f"{name}: {sid}")
            self.save()

