def agreement(outcomes):
    """a step's outcomes on one build ([repeat, outcome] each): per repeat, its worst measured one (failed over
    worked); unstable when it both worked and failed; the words for the scorecard"""
    by = {}
    for rep, o in outcomes:
        by.setdefault(rep, []).append(o)
    per = []
    for rep in sorted(by):
        os_ = by[rep]
        per.append("failed" if "failed" in os_ else "worked" if "worked" in os_ else "unmeasured")
    measured = [o for _, o in outcomes if o != "unmeasured"]
    unstable = "worked" in measured and "failed" in measured
    m = [o for o in per if o != "unmeasured"]
    words = (f"{max(m.count('worked'), m.count('failed'))} of {len(m)} repeats the same" if len(per) > 1 and m else "")
    if len(per) > 1 and len(m) < len(per):
        words += f" ({len(per) - len(m)} could not be measured)"
    return unstable, per, words


def aggregate(rec):
    """each task's and suite step's consistency over its runs and repeats: one that both worked and failed on this
    build is unstable, shown as such and left out of the comparison until it is fixed"""
    for t in rec.get("tasks", {}).values():
        t["unstable"], t["by_repeat"], t["agreement"] = agreement(t.get("outcomes", []))
    for su in rec.get("suites", {}).values():
        for st in su["steps"].values():
            if st.get("outcomes"):
                st["unstable"], st["by_repeat"], st["agreement"] = agreement(st["outcomes"])
                if st["unstable"]:
                    st["status"] = "unstable"
    return rec


def variant(lang, lived_in, soak):
    """the kind of run, in its record's name: runs are compared only with runs of their own kind"""
    return ("-lived-in" if lived_in else "") + (f"-{lang}" if lang else "") + ("-soak" if soak else "")


# ---------------------------------------------------------------- the comparison and the scorecard

def margins(out_dir, kind, exclude=None):
    """how far the median moved between two runs of one earlier release (1.5 times it), to widen the provisional margins;
    the release being judged is left out, so its own trouble cannot widen them"""
    seen = {}
    files = sorted(glob_records(out_dir, kind))
    by_version = {}
    for f in files:
        try:
            r = json.load(open(f))
        except (OSError, ValueError):
            continue
        by_version.setdefault(r.get("version"), []).append(r)
    for version, runs in by_version.items():
        if version == exclude:
            continue
        for a in runs:
            for b in runs:
                if a is b:
                    continue
                for k, m in a.get("metrics", {}).items():
                    sa, sb = stats(m["samples"]), stats(b.get("metrics", {}).get(k, {}).get("samples", []))
                    if sa and sb:
                        seen[k] = max(seen.get(k, 0), abs(sa["median"] - sb["median"]) * 1.5)
    return seen


def glob_records(out_dir, kind):
    pat = re.compile(r"daily-[0-9][0-9.]*" + re.escape(kind) + r"(\.\d+)?\.json$")
    for f in os.listdir(out_dir) if os.path.isdir(out_dir) else []:
        if pat.match(f):
            yield os.path.join(out_dir, f)


def compare(cur, prev, learned):
    """every change past its margin, better or worse, and whether it is clear (the two runs' ranges apart)"""
    changes = []
    for k, m in cur["metrics"].items():
        p = prev.get("metrics", {}).get(k)
        a, b = stats(m["samples"]), stats(p["samples"]) if p else None
        if not (a and b):
            continue
        rel, floor = MARGINS.get(m["unit"], (0.2, 0))
        given = max(abs(b["median"]) * rel, floor)
        margin = max(given, min(learned.get(k, 0), 3 * given))     # the spread widens a margin, at most threefold
        d = a["median"] - b["median"]
        if abs(d) > margin:
            worse = d > 0       # every number here is better lower
            clear = a["low"] > b["high"] or a["high"] < b["low"]
            changes.append({"what": m["words"], "metric": k, "before": b["median"], "now": a["median"], "unit": m["unit"],
                            "margin": round(margin, 2), "worse": worse, "clear": clear})
    unstable = []
    for k, t in cur["tasks"].items():
        p = prev.get("tasks", {}).get(k)
        if t.get("unstable") or (p or {}).get("unstable"):
            unstable.append(t["words"])
            continue
        if p and failures(t) != failures(p):
            worse = failures(t) > failures(p)
            changes.append({"what": t["words"], "metric": f"task.{k}", "before": f"{worked(p)} of {p['runs']}",
                            "now": f"{worked(t)} of {t['runs']}", "worse": worse, "clear": True})
    for name, su in cur.get("suites", {}).items():
        ps = prev.get("suites", {}).get(name, {}).get("steps", {})
        for sid, st in su["steps"].items():
            was = ps.get(sid, {})
            if st.get("unstable") or was.get("unstable"):
                unstable.append(f"{su['title']} {st['words']}")
                continue
            if was.get("status") in ("worked", "failed") and st["status"] in ("worked", "failed") and was["status"] != st["status"]:
                changes.append({"what": f"{su['title']} {st['words']}", "metric": f"suite.{name}.{sid}", "before": was["status"],
                                "now": st["status"], "worse": st["status"] == "failed", "clear": True})
    if unstable:
        changes.append({"what": "unstable on one build, left out of the comparison", "metric": "unstable", "before": "",
                        "now": "; ".join(unstable), "worse": False, "clear": False, "note": True})
    pl = (prev.get("lived_in") or {}).get("checks") or {}
    for k, (ok, words) in ((cur.get("lived_in") or {}).get("checks") or {}).items():
        was = (pl.get(k) or [None])[0]
        if ok is not None and was is not None and ok != was:
            changes.append({"what": f"the update over a lived-in home: {k}", "metric": f"lived_in.{k}", "before": "passed" if was else "failed",
                            "now": "passed" if ok else "failed", "worse": not ok, "clear": True})
    rel_c, rel_p = cur.get("reliability", {}), prev.get("reliability", {})
    for k, words in (("crashes", "a crash"), ("qml", "a new QML error"), ("not_answering", "an app not answering"),
                     ("stuck", "a stuck surface"), ("journal", "a new error in the journal")):
        old = {json.dumps(x, sort_keys=True) if not isinstance(x, str) else x for x in rel_p.get(k, [])}
        new = [x for x in rel_c.get(k, []) if (json.dumps(x, sort_keys=True) if not isinstance(x, str) else x) not in old]
        if k == "crashes":
            new = [x for x in rel_c.get(k, []) if x.get("exe") not in {y.get("exe") for y in rel_p.get(k, [])}]
        for x in new[:5]:
            changes.append({"what": words, "metric": f"reliability.{k}", "before": "", "now": x if isinstance(x, str) else x.get("exe", str(x)),
                            "worse": True, "clear": True})
    return changes


def failures(t):
    """a task's failures: Tacit's, not the could-not-measures (the VM, a mirror, a site)"""
    return t.get("failed", t["runs"] - t.get("passed", 0) - t.get("outside", 0))


def worked(t):
    return t.get("worked", t.get("passed", 0))


def fmt(v, unit):
    if v is None:
        return "-"
    if unit == "ms":
        return f"{v / 1000:.2f} s" if v >= 1000 else f"{v:.0f} ms"
    if unit == "s":
        return f"{v:.1f} s"
    if unit in ("MB", "MB/h"):
        return f"{v:.0f} {unit}" if abs(v) >= 10 else f"{v:.1f} {unit}"
    if unit == "/s":
        return f"{v:.0f}/s"
    return f"{v:.1f} {unit}"


def verdict(steps):
    """works, works with problems (a step that failed, or is unstable), does not work (a core step failed), or not
    judged here (a core step not measured); what could not be measured is neither a pass nor a failure"""
    ran = [x for x in steps.values() if x["status"] in ("worked", "failed", "unstable") or x.get("seen")]
    failed = [x for x in steps.values() if x["status"] in ("failed", "unstable") or x.get("seen") == "failed"]
    if not ran:
        return "not judged here", []
    if any(x["core"] and x["status"] == "failed" for x in failed):
        return "does not work", failed
    if failed:
        return "works with problems", failed
    if any(x["core"] and x["status"] in ("not run", "unmeasured") for x in steps.values()):
        return "not judged here", []
    return "works", []


def merge_hardware(rec, hw):
    """what a tester saw on hardware (tools/hardware-daily): their pass or fail, with who and on what; never the run's"""
    for key, h in (hw or {}).get("steps", {}).items():
        suite, _, sid = key.partition(".")
        st = rec.get("suites", {}).get(suite, {}).get("steps", {}).get(sid)
        if st and st["mark"] in ("ACCOUNT", "HARDWARE") and h.get("seen") in ("passed", "failed"):
            st.update(seen=h["seen"], by=h.get("by", ""), on=h.get("on", ""), note=h.get("note", ""))


def counts(rec):
    """every check's runs (the daily tasks' and the suites' steps') by outcome"""
    c = {"worked": 0, "failed": 0, "unmeasured": 0}
    for t in rec.get("tasks", {}).values():
        for k in c:
            c[k] += t.get(k, 0)
    for su in rec.get("suites", {}).values():
        for st in su["steps"].values():
            for _, o in st.get("outcomes", []):
                c[o] += 1
    return c


def scorecard(rec, prev=None, changes=None, hw=None):
    merge_hardware(rec, hw)
    aggregate(rec)
    v = rec["version"]
    mode = "8-hour soak" if rec["mode"] == "soak" else "short run"
    rep = rec.get("repeat", 1)
    L = [f"# Tacit Daily: {v}", "",
         f"{mode.capitalize()} in the test VM, {rec.get('started', '')[:10]}, {rec.get('minutes', 0):.0f} minutes, tacit {rec.get('tacit') or '?'}"
         + ("" if rec.get("kvm", True) else " (no KVM: slow)") + (f", {rep} times over on this build" if rep > 1 else "") + ".",
         "Report only: this does not hold a release back yet. The margins are provisional until 2-3 releases set the normal spread."]
    lg = rec.get("language") or {}
    L.append(f"Language: {lg.get('lang') or '?'}, keyboard {lg.get('layout') or '?'}"
             + (f" (set for this run: {lg['set']})." if lg.get("set") else " (the computer's own)."))
    if rec.get("lived_in"):
        L.append(f"Started on {rec['lived_in']['from']} with a lived-in home ({rec['lived_in'].get('home')}), updated through Restart.")
    nr_ = {x["what"]: x["why"] for x in rec.get("not_run", [])}
    iso = next((w for k, w in nr_.items() if k.startswith("a known state")), None)
    L.append("Each part started from the same saved state of the computer (a snapshot), and the computer was left as found."
             if rec.get("isolated") else f"Each part started where the one before left the computer: {iso or 'no snapshots'}.")
    L.append("")
    if rec.get("error"):
        L += [f"**The run stopped: {rec['error']}**", ""]
    tasks = rec.get("tasks", {})
    c = counts(rec)
    good = [t for t in tasks.values() if failures(t) == 0 and not t.get("unstable") and worked(t)]
    unstable = [t["words"] for t in tasks.values() if t.get("unstable")] + [
        f"{su['title']} {st['words']}" for su in rec.get("suites", {}).values() for st in su["steps"].values() if st.get("unstable")]
    L += ["## In short", ""]
    L.append(f"- Checks: {c['worked']} worked, {c['failed']} failed, {c['unmeasured']} could not be measured "
             "(the VM, a mirror or a site, not Tacit; neither a pass nor a failure).")
    L.append(f"- Daily tasks: {len(good)} of {len(tasks)} worked every time they were measured." if tasks else "- Daily tasks: none ran.")
    if unstable:
        L.append(f"- Unstable on this build (both worked and failed): {len(unstable)}, shown below and left out of the comparison.")
    lived = (rec.get("lived_in") or {}).get("checks") or {}
    if lived:
        judged = [x for x in lived.values() if x[0] is not None]
        L.append(f"- The update over a lived-in home: {sum(1 for x in judged if x[0])} of {len(judged)} checks passed"
                 + (f", {len(lived) - len(judged)} not judged." if len(judged) < len(lived) else "."))
    for name, su in rec.get("suites", {}).items():
        word, _ = verdict(su["steps"])
        L.append(f"- {su['title']} {word.capitalize()}.")
    real = [x for x in (changes or []) if not x.get("note")]
    if prev is not None:
        worse = [x for x in real if x["worse"]]
        L.append(f"- Against {prev['version']}: {len(real)} changes past the margin, {len(worse)} for the worse"
                 + (f", {sum(x['clear'] for x in worse)} of them clear." if worse else "."))
        block = [x for x in worse if x["clear"]] + [{"what": t["words"]} for t in tasks.values() if failures(t) and not t.get("unstable")]
        L.append(f"- Once this is a gate, it would {'hold the release back, for: ' + '; '.join(x['what'] for x in block[:4]) if block else 'let the release through'}.")
    L.append("")
    if tasks:
        L += ["## Daily tasks", "", "| Task | Worked | Failed | Could not measure | What went wrong |", "|---|---|---|---|---|"]
        for t in tasks.values():
            why = "; ".join(sorted(set(t["why"])))[:160]
            mark = f"unstable ({t.get('agreement') or str(worked(t)) + ' of ' + str(t['runs']) + ' worked'}): " if t.get("unstable") else ""
            L.append(f"| {t['words']} | {worked(t)} | {failures(t)} | {t.get('unmeasured', 0)} | {mark}{why} |")
        L.append("")
    if lived:
        L += [f"## The update over a lived-in home (from {rec['lived_in']['from']}, {rec['lived_in'].get('home')})", ""]
        for k, (ok, words) in lived.items():
            L.append(f"- {'ok' if ok else 'not judged' if ok is None else 'FAIL'}: {k}: {words}")
        L.append("")
    for name, su in rec.get("suites", {}).items():
        word, failed = verdict(su["steps"])
        L += [f"## {su['title']} {word.capitalize()}.", ""]
        for f in failed:
            if f.get("unstable"):
                L.append(f"- Unstable: {f['words']} ({f.get('agreement') or 'worked and failed'}; the last failure: {f.get('why')})")
            else:
                L.append(f"- Problem: {f['words']}: {f.get('why') or f.get('note') or 'failed'}"
                         + (f" (seen by {f.get('by')} on {f.get('on')})" if f.get("seen") else ""))
        ok = [x["words"] for x in su["steps"].values() if x["status"] == "worked"]
        if ok:
            L.append(f"- Worked in the VM: {'; '.join(ok)}.")
        seen = [f"{x['words']} ({x['seen']}, {x.get('by')} on {x.get('on')})" for x in su["steps"].values() if x.get("seen") == "passed"]
        if seen:
            L.append(f"- Seen working by a tester: {'; '.join(seen)}.")
        um = [f"{x['words']} ({x.get('why')})" for x in su["steps"].values() if x["status"] == "unmeasured"]
        if um:
            L.append(f"- Could not measure: {'; '.join(um)}.")
        nr = [f"{x['words']} ({x.get('why')})" for x in su["steps"].values() if x["status"] == "not run"]
        if nr:
            L.append(f"- Not run: {'; '.join(nr)}.")
        tester = [f"{x['words']} [{x['mark']}]" for x in su["steps"].values() if x["status"] == "needs a tester" and not x.get("seen")]
        if tester:
            L.append(f"- Needs a tester (HARDWARE-DAILY.md): {'; '.join(tester)}.")
        L.append("")
    for section, title in (("speed", "Speed"), ("lightness", "Lightness"), ("outside", "Measured on a site, outside Tacit")):
        rows = [(k, m) for k, m in rec.get("metrics", {}).items() if m["section"] == section]
        if not rows:
            continue
        L += [f"## {title}", "", "Median, and the lowest to the highest of the times it was taken.", "",
              "| | Median | Spread | Times |" + (f" {prev['version']} |" if prev else ""), "|---|---|---|---|" + ("---|" if prev else "")]
        for k, m in rows:
            st = stats(m["samples"])
            if not st:
                continue
            pv = stats(prev["metrics"][k]["samples"]) if prev and k in prev.get("metrics", {}) else None
            L.append(f"| {m['words']} | {fmt(st['median'], m['unit'])} | {fmt(st['low'], m['unit'])} to {fmt(st['high'], m['unit'])} | {st['n']} |"
                     + (f" {fmt(pv['median'], m['unit']) if pv else '-'} |" if prev else ""))
        L.append("")
    rel = rec.get("reliability", {})
    L += ["## Reliability", ""]
    for k, words in (("crashes", "Crashes"), ("qml", "New QML errors"), ("not_answering", "Not answering"),
                     ("stuck", "Stuck surfaces"), ("start_failures", "Starts that failed")):
        items = rel.get(k) or []
        show = "; ".join((x if isinstance(x, str) else x.get("exe") or x.get("text") or str(x)) for x in items[:4])
        L.append(f"- {words}: {len(items)}{': ' + show[:200] if items else ''}")
    j_ = rel.get("journal") or {}
    L.append(f"- Errors in the journal: {sum(j_.values())} ({len(j_)} kinds){': ' + '; '.join(list(j_)[:3])[:200] if j_ else ''}")
    L.append("")
    um = [(t["words"], w) for t in tasks.values() for w in sorted(set(t.get("unmeasured_why", [])))]
    um += [(f"{su['title']} {x['words']}", x.get("why")) for su in rec.get("suites", {}).values() for x in su["steps"].values()
           if x["status"] == "unmeasured"]
    um += [(f"the part {p_['name']}" + (f" (repeat {p_['repeat'] + 1})" if rep > 1 else ""), p_.get("why"))
           for p_ in rec.get("parts", []) if p_.get("outcome") == "unmeasured"]
    infra = rec.get("infra", [])
    if um or infra:
        L += ["## Could not measure", "", "Not Tacit's failures and not passes: the VM's machinery (each fault tried once more), "
              "a mirror or a site (outside Tacit), or a step's own setup.", ""]
        L += [f"- {w}: {why}" for w, why in um]
        if infra:
            L.append(f"- Faults of the VM's machinery along the way: {len(infra)} (each tried once more; the first: "
                     f"{infra[0]['what']}: {str(infra[0]['why'])[:120]})")
        L.append("")
    tried = rec.get("retries", [])
    if tried:
        L += ["## Tried twice", "", "A check that failed and was done once more (typing into the VM can drop a key); both results are kept.", ""]
        L += [f"- {x['what']} ({x.get('part')}): first {x.get('first')}; then {x.get('second')}" for x in tried]
        L.append("")
    if unstable:
        L += ["## Unstable on this build", "", "These both worked and failed on the same build. Each is left out of the comparison "
              "until it is the same every time.", ""]
        L += [f"- {w}" for w in unstable]
        L.append("")
    if prev is not None:
        L += [f"## Changes since {prev['version']}", ""]
        if not real:
            L.append("Nothing moved past its margin.")
        for x in real:
            u = x.get("unit")
            b = fmt(x["before"], u) if u else x["before"]
            n = fmt(x["now"], u) if u else x["now"]
            if x["metric"].startswith("reliability."):
                L.append(f"- New: {x['what']}: {n}")
                continue
            L.append(f"- {'Worse' if x['worse'] else 'Better'}{' (clear)' if x['clear'] and u else ''}: {x['what']}: {b} to {n}"
                     + (f" (margin {fmt(x['margin'], u)})" if u else ""))
        L.append("")
    if hw:
        L += [f"## On a computer: {hw.get('on', '?')}, by {hw.get('by', '?')}, {hw.get('date', '')} (tools/hardware-daily)", ""]
        for k, x in (hw.get("numbers") or {}).items():
            if x is not None:
                L.append(f"- {HW_WORDS.get(k, k)}: " + (", ".join(f"{a} {b}" for a, b in x.items()) if isinstance(x, dict) else str(x)))
        for k, x in (hw.get("steps") or {}).items():
            if k.startswith("daily."):
                L.append(f"- {HW_WORDS.get(k, k)}: {x.get('seen')}{': ' + x['note'] if x.get('note') else ''}")
        L.append("")
    L += ["## Not measured here", ""]
    for x in rec.get("not_run", []):
        L.append(f"- {x['what']}: not run ({x['why']}).")
    L.append(f"- Only on a computer: {', '.join(rec.get('hardware_only', HARDWARE_ONLY))}. The protocol is HARDWARE-DAILY.md.")
    return "\n".join(L) + "\n"


# ---------------------------------------------------------------- here: send, run there, fetch, write

def duration(s):
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([hms])", s or "")
    if not m:
        sys.exit(f"daily-bench: a duration is like 8h, 30m or 90s, not {s!r}")
    return float(m.group(1)) * {"h": 3600, "m": 60, "s": 1}[m.group(2)]


def parse(argv):
    a = {"version": None, "soak": 0, "compare": None, "suites": [], "runs": 3, "report": False, "machine": False,
         "lang": None, "lived_in": None, "home": "lived.json", "day": "", "suites_only": False, "repeat": 1, "record": None}
    i = 0
    while i < len(argv):
        x = argv[i]
        if x == "--soak":
            a["soak"] = duration(argv[i + 1]); i += 1
        elif x == "--compare":
            a["compare"] = argv[i + 1]; i += 1
        elif x == "--suite":
            name = argv[i + 1]; i += 1
            if name == "all":
                a["suites"] = list(SUITES)
            elif name in SUITES:
                a["suites"].append(name)
            else:
                sys.exit(f"daily-bench: no suite {name} ({', '.join(SUITES)}, all)")
        elif x == "--runs":
            a["runs"] = int(argv[i + 1]); i += 1
        elif x == "--report":
            a["report"] = True
        elif x == "--lang":
            a["lang"] = argv[i + 1]; i += 1
            if a["lang"] not in LANGS:
                sys.exit(f"daily-bench: no language {a['lang']} ({', '.join(LANGS)})")
        elif x == "--lived-in":
            # here a flag; on the cloud machine it carries the release before (--lived-in <previous>)
            if i + 1 < len(argv) and re.fullmatch(r"\d+(\.\d+)+", argv[i + 1]) and a["version"]:
                a["lived_in"] = argv[i + 1]; i += 1
            else:
                a["lived_in"] = True
        elif x == "--home":
            a["home"] = argv[i + 1]; i += 1
        elif x == "--arch-day":
            a["day"] = argv[i + 1]; i += 1
        elif x == "--suites-only":
            a["suites_only"] = True
        elif x == "--repeat":
            a["repeat"] = int(argv[i + 1]); i += 1
            if a["repeat"] < 1:
                sys.exit("daily-bench: --repeat takes 1 or more")
        elif x == "--record":
            # here a folder; on the cloud machine a flag (the exchanges go to its own record/ and are fetched back)
            if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
                a["record"] = argv[i + 1]; i += 1
            else:
                a["record"] = True
        elif x == "--machine":
            a["machine"] = True
        elif x.startswith("-") or a["version"]:
            sys.exit(__doc__)
        else:
            a["version"] = x
        i += 1
    if not a["version"]:
        sys.exit(__doc__)
    if a["soak"] and (a["lang"] or a["lived_in"]):
        sys.exit("daily-bench: --lang and --lived-in go with the short run, not --soak")
    if a["suites_only"] and not a["suites"]:
        sys.exit("daily-bench: --suites-only needs --suite")
    return a


def previous_release(root, version):
    try:
        r = json.load(open(f"{root}/tacit/notes.json"))["releases"]
    except (OSError, ValueError, KeyError):
        return None
    names = [x.get("version") for x in r]
    return names[names.index(version) + 1] if version in names and names.index(version) + 1 < len(names) else None


def write(root, a, name):
    out_dir = f"{root}/out/x86_64"
    rec = json.load(open(f"{out_dir}/{name}.json"))
    kind = rec.get("variant", "-soak" if rec["mode"] == "soak" else "")
    cmp_version = a["compare"] or previous_release(root, a["version"])
    prev, changes = None, None
    if cmp_version:
        f = f"{out_dir}/daily-{cmp_version}{kind}.json"      # a release's first run of this kind
        if f == f"{out_dir}/{name}.json":
            f = None
        if f and os.path.exists(f):
            prev = json.load(open(f))
            changes = compare(rec, prev, margins(out_dir, kind, exclude=rec["version"]))
            rec["compare"] = {"with": cmp_version, "changes": changes}
            json.dump(rec, open(f"{out_dir}/{name}.json", "w"), indent=1)
        else:
            print(f"daily-bench: no run of {cmp_version} to compare with ({f})", file=sys.stderr)
    hw = f"{out_dir}/hardware-{a['version']}.json"
    md = scorecard(rec, prev, changes, json.load(open(hw)) if os.path.exists(hw) else None)
    open(f"{out_dir}/{name}.md", "w").write(md)
    print(f"written: out/x86_64/{name}.json, out/x86_64/{name}.md")
    return rec


def lived_in_parts(root, a, d):
    """for --lived-in: tools/vm-smoke's test repo of this release (REPO_ONLY), the lived-in settings file, and the
    release before and the day of Arch, for the cloud machine's half"""
    previous = previous_release(root, a["version"])
    if not previous:
        sys.exit(f"daily-bench: notes.json names no release before {a['version']}")
    releases = os.environ.get("TACIT_SHELL_RELEASES", "/home/abdul/dev/tacit-fix/wt-115/tests/config/releases")
    home = os.path.join(releases, a["home"])
    if not os.path.exists(home):
        sys.exit(f"daily-bench: no settings file {home} (TACIT_SHELL_RELEASES: the shell's tests/config/releases)")
    shutil.copy(home, f"{d}/home.json")
    p = subprocess.run([f"{HERE}/vm-smoke", a["version"]], env=dict(os.environ, REPO_ONLY=f"{d}/repo"), capture_output=True, text=True)
    if p.returncode or not os.path.isdir(f"{d}/repo"):
        sys.exit(f"daily-bench: tools/vm-smoke could not make the test repo: {(p.stdout + p.stderr).strip()[-400:]}")
    day = subprocess.run([f"{HERE}/arch-day"], capture_output=True, text=True).stdout.strip()
    return ["--lived-in", previous, "--arch-day", day]


def make_media(dest, seconds=600):
    """the local video, made with ffmpeg if it is not there already for this recipe: a moving test pattern (testsrc2,
    1280x720 at 30 frames a second) with a 440 Hz tone, as VP9 in WebM and as H.264 in MP4, Opus sound in both"""
    os.makedirs(dest, exist_ok=True)
    recipe = hashlib.sha256(json.dumps([MEDIA, TONE, seconds]).encode()).hexdigest()[:12]
    stamp = os.path.join(dest, "recipe")
    if open(stamp).read().strip() == recipe if os.path.exists(stamp) else False:
        if all(os.path.exists(os.path.join(dest, n)) for n in MEDIA):
            return [os.path.join(dest, n) for n in MEDIA]
    for name, codec in MEDIA.items():
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-f", "lavfi", "-i", f"testsrc2=size=1280x720:rate=30:duration={seconds}",
                        "-f", "lavfi", "-i", f"sine=frequency=440:sample_rate=48000:duration={seconds}", "-map", "0:v", "-map", "1:a",
                        *codec, *TONE, "-c:a", "libopus", "-b:a", "96k", os.path.join(dest, name)], check=True)
    open(stamp, "w").write(recipe + "\n")
    return [os.path.join(dest, n) for n in MEDIA]


def send_media(out_dir, on, at):
    """the local video to the cloud machine's ~/tacit-vm/media, each file only when what is there differs"""
    files = make_media(f"{out_dir}/daily-media")
    there = dict(reversed(line.split(None, 1)) for line in on("cd ~/tacit-vm/media && sha256sum * 2>/dev/null").stdout.splitlines()
                 if len(line.split(None, 1)) == 2)
    for f in files:
        sha = hashlib.sha256(open(f, "rb").read()).hexdigest()
        if there.get(os.path.basename(f)) != sha:
            if subprocess.run(["gcloud", "compute", "scp", *at, f, f"{MACHINE}:~/tacit-vm/media/"], capture_output=True).returncode:
                sys.exit(f"daily-bench: could not copy {os.path.basename(f)} to the cloud machine")


def main():
    a = parse(sys.argv[1:])
    if a["machine"]:
        os.chdir(HERE)
        b = Bench(a["version"], a["soak"], a["runs"], a["suites"], a["lang"], a["lived_in"], a["day"], a["suites_only"],
                  a["repeat"], bool(a["record"]))
        b.soak(a["soak"], a["runs"]) if a["soak"] else b.short(a["runs"])
        return
    root = os.path.dirname(HERE)
    out_dir = f"{root}/out/x86_64"
    os.makedirs(out_dir, exist_ok=True)
    base = f"daily-{a['version']}{variant(a['lang'], a['lived_in'], a['soak'])}"
    if a["report"]:
        names = sorted((f[:-5] for f in os.listdir(out_dir) if re.fullmatch(re.escape(base) + r"(\.\d+)?\.json", f)), key=len)
        if not names:
            sys.exit(f"daily-bench: no record {base}.json in out/x86_64")
        for name in names:          # every run of the version, each against what it is compared with
            write(root, a, name)
        return
    name, n = base, 1
    while os.path.exists(f"{out_dir}/{name}.json"):
        n += 1
        name = f"{base}.{n}"
    tmp = tempfile.mkdtemp()
    try:
        d = f"{tmp}/daily"
        os.makedirs(d)
        for f in ("vm", "daily-bench", "daily-bench-guest", "daily-bench-suites", "vm-smoke-guest"):
            shutil.copy(f"{HERE}/{f}", d)
        extra = []
        if a["lived_in"]:
            extra = lived_in_parts(root, a, d)
        if os.environ.get("TACIT_VM_PASSWORD"):
            fd = os.open(f"{d}/password", os.O_WRONLY | os.O_CREAT, 0o600)
            os.write(fd, os.environ["TACIT_VM_PASSWORD"].encode())
            os.close(fd)
        with tarfile.open(f"{tmp}/daily.tar", "w") as t:
            t.add(d, "daily")
        at = ["--project", PROJECT, "--zone", ZONE]
        def on(cmd, timeout=600, tries=2):
            """a command on the cloud machine; ssh itself failing (255) is tried once more"""
            for _ in range(tries):
                p = subprocess.run(["timeout", str(timeout), "gcloud", "compute", "ssh", MACHINE, *at, "--command", cmd],
                                   capture_output=True, text=True)
                if p.returncode != 255:
                    return p
            return p
        if on("rm -rf ~/tacit-vm/daily && mkdir -p ~/tacit-vm/media").returncode:
            sys.exit("daily-bench: could not measure: the cloud machine does not answer (gcloud compute ssh failed twice)")
        if "creator" in a["suites"]:
            send_media(out_dir, on, at)
        if all(subprocess.run(["gcloud", "compute", "scp", *at, f"{tmp}/daily.tar", f"{MACHINE}:~/tacit-vm/"], capture_output=True).returncode
               for _ in range(2)):
            sys.exit("daily-bench: could not measure: the run could not be copied to the cloud machine (twice)")
        args = " ".join([a["version"], "--runs", str(a["runs"])] + (["--soak", f"{int(a['soak'])}s"] if a["soak"] else [])
                        + sum((["--suite", s] for s in a["suites"]), []) + (["--lang", a["lang"]] if a["lang"] else [])
                        + (["--suites-only"] if a["suites_only"] else []) + extra
                        + (["--repeat", str(a["repeat"])] if a["repeat"] > 1 else []) + (["--record"] if a["record"] else []))
        # the run outlasts an ssh session: started apart, then waited for (as tools/vm-smoke does)
        on("cd ~/tacit-vm && tar -xf daily.tar && rm daily.tar && cp daily/vm vm "
           "&& { [ ! -f daily/password ] || mv daily/password password; } "
           f"&& (setsid nohup bash -c 'cd ~/tacit-vm/daily && python3 ./daily-bench --machine {args} > run.log 2>&1; echo $? > done' "
           "> /dev/null 2>&1 < /dev/null &)")
        wait = 2
        while on("test -f ~/tacit-vm/daily/done", 120).returncode:
            time.sleep(wait)        # the poll's interval, longer each time up to a minute: the run takes its own time
            wait = min(60, wait * 2)
        print(on("cat ~/tacit-vm/daily/run.log").stdout)
        if subprocess.run(["gcloud", "compute", "scp", *at, f"{MACHINE}:~/tacit-vm/daily/daily.json", f"{out_dir}/{name}.json"],
                          capture_output=True).returncode:
            sys.exit(f"daily-bench: no record came back from {MACHINE}")
        if a["record"]:
            os.makedirs(a["record"], exist_ok=True)
            subprocess.run(["gcloud", "compute", "scp", *at, f"{MACHINE}:~/tacit-vm/daily/record/exchanges.jsonl",
                            f"{a['record']}/exchanges.jsonl"], capture_output=True)
            shutil.copy(f"{out_dir}/{name}.json", f"{a['record']}/daily.json")
            json.dump({"version": a["version"], "args": sys.argv[1:], "recorded": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                       "from": "a real run on the test VM"}, open(f"{a['record']}/meta.json", "w"), indent=1)
    finally:
        shutil.rmtree(tmp)
    rec = write(root, a, name)
    if a["record"]:
        shutil.copy(f"{out_dir}/{name}.md", f"{a['record']}/daily.md")
        print(f"recorded: {a['record']} (exchanges.jsonl, daily.json, daily.md, meta.json)")
    if rec.get("error"):        # a run that stopped: its scorecard says so, and so does the exit
        sys.exit(f"daily-bench: the run stopped: {rec['error']}")


if __name__ == "__main__":
    main()
