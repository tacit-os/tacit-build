            self.round(i)
            self.save()
        self.log("10 minutes at rest")
        self.idle()
        self.growth(self.memory0, self.guest("memory").get("pss", {}))
        self.reliability()
        self.disk()
        self.save()
        for name in self.suites:
            self.log(f"suite {name}")
            self.suite(name)
        self.reliability()
        if self.pw:
            for i in range(runs):
                self.log(f"start {i + 1} of {runs}")
                self.boot()
                self.save()
            self.reliability()
        self.finish()

    def soak(self, seconds, runs):
        self.preflight()
        start, hours = time.time(), seconds / 3600
        reserve = min(1500, seconds * 0.05)        # the last part: 10 minutes at rest, the update and its restart
        every = seconds / 8                         # "hourly" over an 8-hour soak
        last_sample, i = 0.0, 0
        mem0 = self.memory0
        while time.time() < start + seconds - reserve:
            i += 1
            self.log(f"soak round {i}")
            self.app_starts(1)
            self.page_load(2)
            self.round(i)
            if time.time() - last_sample >= every:
                last_sample = time.time()
                m = self.guest("memory").get("pss", {})
                for k, v in m.items():
                    self.metric(f"soak.pss.{k}", "lightness", "MB", f"{APP_WORDS.get(k, k)}: memory over the soak", v["mb"])
                self.disk()
            self.save()
        self.rec["soak_rounds"] = i
        self.idle()
        self.growth(mem0, self.guest("memory").get("pss", {}), hours=max(hours, 1e-6))
        self.reliability()
        self.disk()
        for name in self.suites:
            self.suite(name)
        if self.pw:
            self.update(1)
            self.reliability()
        self.finish()

    def finish(self):
        self.guest("restore", timeout=200)
        self.guest("serve", "stop")
        self.guest("sampler", "stop")
        self.rec["ended"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        self.save()
        self.log("done")


