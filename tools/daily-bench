# ---------------------------------------------------------------- the comparison and the scorecard

def margins(out_dir, mode, exclude=None):
    """how far the median moved between two runs of one earlier release (1.5 times it), to widen the provisional margins;
    the release being judged is left out, so its own trouble cannot widen them"""
    seen = {}
    files = sorted(glob_records(out_dir, mode))
    by_version = {}
    for f in files:
        try:
            r = json.load(open(f))
        except (OSError, ValueError):
            continue
        by_version.setdefault(r.get("version"), []).append(r)
    for version, runs in by_version.items():
        if version == exclude:
            continue
        for a in runs:
            for b in runs:
                if a is b:
                    continue
                for k, m in a.get("metrics", {}).items():
                    sa, sb = stats(m["samples"]), stats(b.get("metrics", {}).get(k, {}).get("samples", []))
                    if sa and sb:
                        seen[k] = max(seen.get(k, 0), abs(sa["median"] - sb["median"]) * 1.5)
    return seen


def glob_records(out_dir, mode):
    pat = re.compile(r"daily-[0-9][^/]*?(-soak)?(\.\d+)?\.json$")
    for f in os.listdir(out_dir) if os.path.isdir(out_dir) else []:
        m = pat.match(f)
        if m and bool(m.group(1)) == (mode == "soak"):
            yield os.path.join(out_dir, f)


def compare(cur, prev, learned):
    """every change past its margin, better or worse, and whether it is clear (the two runs' ranges apart)"""
    changes = []
    for k, m in cur["metrics"].items():
        p = prev.get("metrics", {}).get(k)
        a, b = stats(m["samples"]), stats(p["samples"]) if p else None
        if not (a and b):
            continue
        rel, floor = MARGINS.get(m["unit"], (0.2, 0))
        given = max(abs(b["median"]) * rel, floor)
        margin = max(given, min(learned.get(k, 0), 3 * given))     # the spread widens a margin, at most threefold
        d = a["median"] - b["median"]
        if abs(d) > margin:
            worse = d > 0       # every number here is better lower
            clear = a["low"] > b["high"] or a["high"] < b["low"]
            changes.append({"what": m["words"], "metric": k, "before": b["median"], "now": a["median"], "unit": m["unit"],
                            "margin": round(margin, 2), "worse": worse, "clear": clear})
    for k, t in cur["tasks"].items():
        p = prev.get("tasks", {}).get(k)
        if p and t["runs"] - t["passed"] != p["runs"] - p["passed"]:
            worse = (t["runs"] - t["passed"]) > (p["runs"] - p["passed"])
            changes.append({"what": t["words"], "metric": f"task.{k}", "before": f"{p['passed']} of {p['runs']}",
                            "now": f"{t['passed']} of {t['runs']}", "worse": worse, "clear": True})
    for name, s in cur.get("suites", {}).items():
        ps = prev.get("suites", {}).get(name, {}).get("steps", {})
        for sid, st in s["steps"].items():
            was = ps.get(sid, {}).get("status")
            if was in ("passed", "failed") and st["status"] in ("passed", "failed") and was != st["status"]:
                changes.append({"what": f"{s['title']} {st['words']}", "metric": f"suite.{name}.{sid}", "before": was,
                                "now": st["status"], "worse": st["status"] == "failed", "clear": True})
    rel_c, rel_p = cur.get("reliability", {}), prev.get("reliability", {})
    for k, words in (("crashes", "a crash"), ("qml", "a new QML error"), ("not_answering", "an app not answering"),
                     ("stuck", "a stuck surface"), ("journal", "a new error in the journal")):
        old = {json.dumps(x, sort_keys=True) if not isinstance(x, str) else x for x in rel_p.get(k, [])}
        new = [x for x in rel_c.get(k, []) if (json.dumps(x, sort_keys=True) if not isinstance(x, str) else x) not in old]
        if k == "crashes":
            new = [x for x in rel_c.get(k, []) if x.get("exe") not in {y.get("exe") for y in rel_p.get(k, [])}]
        for x in new[:5]:
            changes.append({"what": words, "metric": f"reliability.{k}", "before": "", "now": x if isinstance(x, str) else x.get("exe", str(x)),
                            "worse": True, "clear": True})
    return changes


def fmt(v, unit):
    if v is None:
        return "-"
    if unit == "ms":
        return f"{v / 1000:.2f} s" if v >= 1000 else f"{v:.0f} ms"
    if unit == "s":
        return f"{v:.1f} s"
    if unit in ("MB", "MB/h"):
        return f"{v:.0f} {unit}" if abs(v) >= 10 else f"{v:.1f} {unit}"
    if unit == "/s":
        return f"{v:.0f}/s"
    return f"{v:.1f} {unit}"


def verdict(steps):
    ran = [s for s in steps.values() if s["status"] in ("passed", "failed") or s.get("seen")]
    failed = [s for s in steps.values() if s["status"] == "failed" or s.get("seen") == "failed"]
    if not ran:
        return "not judged here", []
    if any(s["core"] for s in failed):
        return "does not work", failed
    if failed:
        return "works with problems", failed
    if any(s["core"] and s["status"] == "not run" for s in steps.values()):
        return "not judged here", []
    return "works", []


def merge_hardware(rec, hw):
    """what a tester saw on hardware (tools/hardware-daily): their pass or fail, with who and on what; never the run's"""
    for key, h in (hw or {}).get("steps", {}).items():
        suite, _, sid = key.partition(".")
        st = rec.get("suites", {}).get(suite, {}).get("steps", {}).get(sid)
        if st and st["mark"] in ("ACCOUNT", "HARDWARE") and h.get("seen") in ("passed", "failed"):
            st.update(seen=h["seen"], by=h.get("by", ""), on=h.get("on", ""), note=h.get("note", ""))


def scorecard(rec, prev=None, changes=None, hw=None):
    merge_hardware(rec, hw)
    v = rec["version"]
    mode = "8-hour soak" if rec["mode"] == "soak" else "short run"
    L = [f"# Tacit Daily: {v}", "",
         f"{mode.capitalize()} in the test VM, {rec.get('started', '')[:10]}, {rec.get('minutes', 0):.0f} minutes, tacit {rec.get('tacit') or '?'}"
         + ("" if rec.get("kvm", True) else " (no KVM: slow)") + ".",
         "Report only: this does not hold a release back yet. The margins are provisional until 2-3 releases set the normal spread.", ""]
    if rec.get("error"):
        L += [f"**The run stopped: {rec['error']}**", ""]
    tasks = rec.get("tasks", {})
    good = [t for t in tasks.values() if t["passed"] == t["runs"]]
    L += ["## In short", ""]
    L.append(f"- Daily tasks: {len(good)} of {len(tasks)} worked every time." if tasks else "- Daily tasks: none ran.")
    for name, s in rec.get("suites", {}).items():
        word, _ = verdict(s["steps"])
        L.append(f"- {s['title']} {word.capitalize()}.")
    if prev is not None:
        worse = [c for c in changes if c["worse"]]
        L.append(f"- Against {prev['version']}: {len(changes)} changes past the margin, {len(worse)} for the worse"
                 + (f", {sum(c['clear'] for c in worse)} of them clear." if worse else "."))
        block = [c for c in worse if c["clear"]] + [{"what": t["words"]} for t in tasks.values() if t["passed"] < t["runs"]]
        L.append(f"- Once this is a gate, it would {'hold the release back, for: ' + '; '.join(c['what'] for c in block[:4]) if block else 'let the release through'}.")
    L.append("")
    if tasks:
        L += ["## Daily tasks", "", "| Task | Worked | What went wrong |", "|---|---|---|"]
        for t in tasks.values():
            why = "; ".join(sorted(set(t["why"])))[:160]
            L.append(f"| {t['words']} | {t['passed']} of {t['runs']} | {why} |")
        L.append("")
    for name, s in rec.get("suites", {}).items():
        word, failed = verdict(s["steps"])
        L += [f"## {s['title']} {word.capitalize()}.", ""]
        for f in failed:
            L.append(f"- Problem: {f['words']}: {f.get('why') or f.get('note') or 'failed'}"
                     + (f" (seen by {f.get('by')} on {f.get('on')})" if f.get("seen") else ""))
        ok = [x["words"] for x in s["steps"].values() if x["status"] == "passed"]
        if ok:
            L.append(f"- Worked in the VM: {'; '.join(ok)}.")
        seen = [f"{x['words']} ({x['seen']}, {x.get('by')} on {x.get('on')})" for x in s["steps"].values() if x.get("seen") == "passed"]
        if seen:
            L.append(f"- Seen working by a tester: {'; '.join(seen)}.")
        nr = [f"{x['words']} ({x.get('why')})" for x in s["steps"].values() if x["status"] == "not run"]
        if nr:
            L.append(f"- Not run: {'; '.join(nr)}.")
        tester = [f"{x['words']} [{x['mark']}]" for x in s["steps"].values() if x["status"] == "needs a tester" and not x.get("seen")]
        if tester:
            L.append(f"- Needs a tester (HARDWARE-DAILY.md): {'; '.join(tester)}.")
        L.append("")
    for section, title in (("speed", "Speed"), ("lightness", "Lightness")):
        rows = [(k, m) for k, m in rec.get("metrics", {}).items() if m["section"] == section]
        if not rows:
            continue
        L += [f"## {title}", "", "Median, and the lowest to the highest of the times it was taken.", "",
              "| | Median | Spread | Times |" + (f" {prev['version']} |" if prev else ""), "|---|---|---|---|" + ("---|" if prev else "")]
        for k, m in rows:
            s = stats(m["samples"])
            if not s:
                continue
            p = stats(prev["metrics"][k]["samples"]) if prev and k in prev.get("metrics", {}) else None
            L.append(f"| {m['words']} | {fmt(s['median'], m['unit'])} | {fmt(s['low'], m['unit'])} to {fmt(s['high'], m['unit'])} | {s['n']} |"
                     + (f" {fmt(p['median'], m['unit']) if p else '-'} |" if prev else ""))
        L.append("")
    rel = rec.get("reliability", {})
    L += ["## Reliability", ""]
    for k, words in (("crashes", "Crashes"), ("qml", "New QML errors"), ("not_answering", "Not answering"),
                     ("stuck", "Stuck surfaces"), ("start_failures", "Starts that failed")):
        items = rel.get(k) or []
        show = "; ".join((x if isinstance(x, str) else x.get("exe") or x.get("text") or str(x)) for x in items[:4])
        L.append(f"- {words}: {len(items)}{': ' + show[:200] if items else ''}")
    j = rel.get("journal") or {}
    L.append(f"- Errors in the journal: {sum(j.values())} ({len(j)} kinds){': ' + '; '.join(list(j)[:3])[:200] if j else ''}")
    L.append("")
    if prev is not None:
        L += [f"## Changes since {prev['version']}", ""]
        if not changes:
            L.append("Nothing moved past its margin.")
        for c in changes:
            u = c.get("unit")
            b = fmt(c["before"], u) if u else c["before"]
            n = fmt(c["now"], u) if u else c["now"]
            if c["metric"].startswith("reliability."):
                L.append(f"- New: {c['what']}: {n}")
                continue
            L.append(f"- {'Worse' if c['worse'] else 'Better'}{' (clear)' if c['clear'] and u else ''}: {c['what']}: {b} to {n}"
                     + (f" (margin {fmt(c['margin'], u)})" if u else ""))
        L.append("")
    if hw:
        L += [f"## On a computer: {hw.get('on', '?')}, by {hw.get('by', '?')}, {hw.get('date', '')} (tools/hardware-daily)", ""]
        for k, x in (hw.get("numbers") or {}).items():
            if x is not None:
                L.append(f"- {HW_WORDS.get(k, k)}: " + (", ".join(f"{a} {b}" for a, b in x.items()) if isinstance(x, dict) else str(x)))
        for k, x in (hw.get("steps") or {}).items():
            if k.startswith("daily."):
                L.append(f"- {HW_WORDS.get(k, k)}: {x.get('seen')}{': ' + x['note'] if x.get('note') else ''}")
        L.append("")
    nr = rec.get("not_run", [])
    L += ["## Not measured here", ""]
    for x in nr:
        L.append(f"- {x['what']}: not run ({x['why']}).")
    L.append(f"- Only on a computer: {', '.join(rec.get('hardware_only', HARDWARE_ONLY))}. The protocol is HARDWARE-DAILY.md.")
    return "\n".join(L) + "\n"


# ---------------------------------------------------------------- here: send, run there, fetch, write

def duration(s):
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([hms])", s or "")
    if not m:
        sys.exit(f"daily-bench: a duration is like 8h, 30m or 90s, not {s!r}")
    return float(m.group(1)) * {"h": 3600, "m": 60, "s": 1}[m.group(2)]


def parse(argv):
    a = {"version": None, "soak": 0, "compare": None, "suites": [], "runs": 3, "report": False, "machine": False}
    i = 0
    while i < len(argv):
        x = argv[i]
        if x == "--soak":
            a["soak"] = duration(argv[i + 1]); i += 1
        elif x == "--compare":
            a["compare"] = argv[i + 1]; i += 1
        elif x == "--suite":
            name = argv[i + 1]; i += 1
            if name == "all":
                a["suites"] = list(SUITES)
            elif name in SUITES:
                a["suites"].append(name)
            else:
                sys.exit(f"daily-bench: no suite {name} ({', '.join(SUITES)}, all)")
        elif x == "--runs":
            a["runs"] = int(argv[i + 1]); i += 1
        elif x == "--report":
            a["report"] = True
        elif x == "--machine":
            a["machine"] = True
        elif x.startswith("-") or a["version"]:
            sys.exit(__doc__)
        else:
            a["version"] = x
        i += 1
    if not a["version"]:
        sys.exit(__doc__)
    return a


def previous_release(root, version):
    try:
        r = json.load(open(f"{root}/tacit/notes.json"))["releases"]
    except (OSError, ValueError, KeyError):
        return None
    names = [x.get("version") for x in r]
    return names[names.index(version) + 1] if version in names and names.index(version) + 1 < len(names) else None


def write(root, a, name):
    out_dir = f"{root}/out/x86_64"
    rec = json.load(open(f"{out_dir}/{name}.json"))
    soak = "-soak" if rec["mode"] == "soak" else ""
    cmp_version = a["compare"] or previous_release(root, a["version"])
    prev, changes = None, None
    if cmp_version:
        f = f"{out_dir}/daily-{cmp_version}{soak}.json"      # a release's first run (a second run compares with it)
        if f == f"{out_dir}/{name}.json":
            f = None
        if f and os.path.exists(f):
            prev = json.load(open(f))
            changes = compare(rec, prev, margins(out_dir, rec["mode"], exclude=rec["version"]))
            rec["compare"] = {"with": cmp_version, "changes": changes}
            json.dump(rec, open(f"{out_dir}/{name}.json", "w"), indent=1)
        else:
            print(f"daily-bench: no run of {cmp_version} to compare with ({f})", file=sys.stderr)
    hw = f"{out_dir}/hardware-{a['version']}.json"
    md = scorecard(rec, prev, changes, json.load(open(hw)) if os.path.exists(hw) else None)
    open(f"{out_dir}/{name}.md", "w").write(md)
    print(f"written: out/x86_64/{name}.json, out/x86_64/{name}.md")
    return rec


def main():
    a = parse(sys.argv[1:])
    if a["machine"]:
        os.chdir(HERE)
        b = Bench(a["version"], a["soak"], a["runs"], a["suites"])
        b.soak(a["soak"], a["runs"]) if a["soak"] else b.short(a["runs"])
        return
    root = os.path.dirname(HERE)
    out_dir = f"{root}/out/x86_64"
    os.makedirs(out_dir, exist_ok=True)
    base = f"daily-{a['version']}{'-soak' if a['soak'] else ''}"
    if a["report"]:
        names = sorted((f[:-5] for f in os.listdir(out_dir) if re.fullmatch(re.escape(base) + r"(\.\d+)?\.json", f)), key=len)
        if not names:
            sys.exit(f"daily-bench: no record {base}.json in out/x86_64")
        for name in names:          # every run of the version, each against what it is compared with
            write(root, a, name)
        return
    name, n = base, 1
    while os.path.exists(f"{out_dir}/{name}.json"):
        n += 1
        name = f"{base}.{n}"
    tmp = tempfile.mkdtemp()
    try:
        d = f"{tmp}/daily"
        os.makedirs(d)
        for f in ("vm", "daily-bench", "daily-bench-guest", "daily-bench-suites", "vm-smoke-guest"):
            shutil.copy(f"{HERE}/{f}", d)
        if os.environ.get("TACIT_VM_PASSWORD"):
            fd = os.open(f"{d}/password", os.O_WRONLY | os.O_CREAT, 0o600)
            os.write(fd, os.environ["TACIT_VM_PASSWORD"].encode())
            os.close(fd)
        with tarfile.open(f"{tmp}/daily.tar", "w") as t:
            t.add(d, "daily")
        at = ["--project", PROJECT, "--zone", ZONE]
        on = lambda cmd, timeout=600: subprocess.run(["timeout", str(timeout), "gcloud", "compute", "ssh", MACHINE, *at, "--command", cmd],
                                                     capture_output=True, text=True)
        on("rm -rf ~/tacit-vm/daily && mkdir -p ~/tacit-vm")
        if subprocess.run(["gcloud", "compute", "scp", *at, f"{tmp}/daily.tar", f"{MACHINE}:~/tacit-vm/"], capture_output=True).returncode:
            sys.exit("daily-bench: could not copy the run to the cloud machine")
        args = " ".join([a["version"], "--runs", str(a["runs"])] + (["--soak", f"{int(a['soak'])}s"] if a["soak"] else [])
                        + sum((["--suite", s] for s in a["suites"]), []))
        # the run outlasts an ssh session: started apart, then waited for (as tools/vm-smoke does)
        on("cd ~/tacit-vm && tar -xf daily.tar && rm daily.tar && cp daily/vm vm "
           "&& { [ ! -f daily/password ] || mv daily/password password; } "
           f"&& (setsid nohup bash -c 'cd ~/tacit-vm/daily && python3 ./daily-bench --machine {args} > run.log 2>&1; echo $? > done' "
           "> /dev/null 2>&1 < /dev/null &)")
        while on("test -f ~/tacit-vm/daily/done", 120).returncode:
            time.sleep(60)
        print(on("cat ~/tacit-vm/daily/run.log").stdout)
        if subprocess.run(["gcloud", "compute", "scp", *at, f"{MACHINE}:~/tacit-vm/daily/daily.json", f"{out_dir}/{name}.json"],
                          capture_output=True).returncode:
            sys.exit(f"daily-bench: no record came back from {MACHINE}")
    finally:
        shutil.rmtree(tmp)
    write(root, a, name)


if __name__ == "__main__":
    main()
