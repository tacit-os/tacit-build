    # -- the two modes, each part from the known state, the whole --repeat times
    def short(self, runs):
        self.preflight()
        for self.rep in range(self.repeat):
            if self.repeat > 1:
                self.log(f"repeat {self.rep + 1} of {self.repeat}")
            if self.lang:
                self.part_from_base("language", self.language_checks)
            if not self.suites_only:
                self.part_from_base("starts", lambda: (self.app_starts(runs), self.page_load(5)))
                self.part_from_base("tasks", lambda: self.rounds(runs))
                self.log("10 minutes at rest")
                self.part_from_base("rest", self.idle)
            for name in self.suites:
                self.part_from_base(f"suite {name}", lambda name=name: self.suite(name))
            if self.pw and not self.lang and not self.suites_only:     # a language run's starts are not the computer's usual
                self.part_from_base("starts from power on", lambda: self.boots(runs))
        self.finish()

    def soak(self, seconds, runs):
        self.preflight()
        start, hours = time.time(), seconds / 3600
        reserve = min(1500, seconds * 0.05)        # the last part: 10 minutes at rest, the update and its restart
        every = seconds / 8                         # "hourly" over an 8-hour soak

        def rounds():
            # one part: the soak is the same desktop for hours (its decay is the point), so no state is loaded within it
            last_sample, i = 0.0, 0
            mem0 = self.guest("memory").get("pss", {})
            while time.time() < start + seconds - reserve:
                i += 1
                self.log(f"soak round {i}")
                self.app_starts(1)
                self.page_load(2)
                self.round(i)
                if time.time() - last_sample >= every:
                    last_sample = time.time()
                    for k, v in self.guest("memory").get("pss", {}).items():
                        self.metric(f"soak.pss.{k}", "lightness", "MB", f"{APP_WORDS.get(k, k)}: memory over the soak", v["mb"])
                    self.disk()
                self.save()
            self.rec["soak_rounds"] = i
            self.idle()
            self.growth(mem0, self.guest("memory").get("pss", {}), hours=max(hours, 1e-6))
        self.part_from_base("soak", rounds)
        for name in self.suites:
            self.part_from_base(f"suite {name}", lambda name=name: self.suite(name))
        if self.pw:
            self.part_from_base("update", lambda: self.update(1))
        self.finish()

    def finish(self):
        """the computer left as found: daily-start loaded (with no snapshots, the run's own changes undone one by one)"""
        self.part = "finish"
        aggregate(self.rec)
        restored = False
        if self.start_saved:
            ok, said = self.snapshot("load", "daily-start")
            if ok:
                restored = True
                for name in ("daily-base", "daily-start"):
                    self.snapshot("delete", name)
            else:
                self.rec["infra"].append({"what": "putting the computer back (daily-start)", "why": said, "part": "finish"})
        if not restored:
            self.guest("restore", timeout=200)
            self.guest("serve", "stop")
            if self.lived_in:
                self.guest("lived-in-restore")
            if self.lang:           # back in its own language: set back, restarted, signed in with its own keys
                self.guest("lang-restore")
                try:
                    self.reboot()
                except Unmeasured as e:
                    self.rec["infra"].append({"what": "the restart into the computer's own language", "why": str(e), "part": "finish"})
                self.guest("serve", "stop")
            self.guest("sampler", "stop")
        self.rec["left_as_found"] = "daily-start loaded" if restored else "the run's changes undone one by one"
        if self.server:
            self.server.terminate()
        self.rec["ended"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        self.save()
        self.log("done")


