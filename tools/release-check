#!/bin/bash
# tools/release-check <version>                 the gates a Tacit release passes before tools/publish (RELEASE.md)
# tools/release-check <version> --vm-passed "…"  records that the VM round for <version> passed, with what was checked
# tools/release-check <version> --iso            after tools/iso: the install image holds <version>
#
# Each gate prints ok or FAIL, and the command fails if any did; tools/publish will not run until it passes. It changes
# nothing but the VM record.
set -u
here=$(dirname "$(dirname "$(readlink -f "$0")")"); cd "$here"
version=${1:-}; [ -n "$version" ] || { echo "usage: tools/release-check <version> [--vm-passed \"what was checked\"]" >&2; exit 2; }
out=out/x86_64
record=$out/vm-passed-$version
if [ "${2:-}" = --vm-passed ]; then
	[ -n "${3:-}" ] || { echo "release-check: say what the VM round checked" >&2; exit 2; }
	printf '%s\n%s\narch day %s\n' "$(date -Is)" "$3" "$(tools/arch-day)" > "$record" && echo "recorded: $record"
	exit 0
fi
if [ "${2:-}" = --iso ]; then
	# after tools/publish and tools/iso (RELEASE.md, step 8): the install image holds this release, so a new install does
	# not start on an older one's bugs
	iso=$out/iso-$version
	[ -f "$iso" ] || { echo "release-check: no ISO made for $version (tools/iso)" >&2; exit 1; }
	tv=$(cd tacit && bash -c 'source PKGBUILD; echo "$pkgver-$pkgrel"')
	[ "$(sed -n 2p "$iso")" = "tacit $tv" ] || { echo "release-check: the ISO has $(sed -n 2p "$iso"), the recipe is tacit $tv: make it again (tools/iso)" >&2; exit 1; }
	echo "release-check: the ISO for $version: $(sed -n 3p "$iso"), $(sed -n 4p "$iso"), $(sed -n 5p "$iso")"
	exit 0
fi
failed=0
ok()   { printf '  ok    %s\n' "$*"; }
bad()  { printf '  FAIL  %s\n' "$*"; failed=1; }
note() { printf '  note  %s\n' "$*"; }

# where each private repo is checked out on this machine
declare -A clone=(
	[tacit-shell]=$HOME/.config/quickshell/tacit [tacit-opsis]=$HOME/dev/browser [tacit-agent-host]=$HOME/dev/agent-host [tacit-kit]=$HOME/dev/tacit-kit
	[tacit-portal]=$HOME/dev/tacit-portal [tacit-boot]=$HOME/dev/tacit-boot [tacit-font]=$HOME/dev/tacit-font
	[tacit-icons]=$HOME/dev/tacit-icons [tacit-foot]=$HOME/dev/tacit-foot [tacit-text]=$HOME/dev/tacit-text
	[book4-edge-linux]=$HOME/dev/book4-edge-linux [tacit-kit]=$HOME/dev/tacit-kit
)

echo "== the release: tacit $version"
tv=$(cd tacit && bash -c 'source PKGBUILD; echo "$pkgver"')
[ "$tv" = "$version" ] && ok "tacit's pkgver is $version" || bad "tacit's pkgver is $tv, not $version"
python3 - "$version" <<'EOF' && ok "notes.json leads with $version and says what changed" || bad "notes.json: no $version entry with changes first"
import json, sys
r = json.load(open("tacit/notes.json"))["releases"][0]
sys.exit(0 if r.get("version") == sys.argv[1] and r.get("changes") else 1)
EOF

echo "== sources: every pin is pushed and none is behind what was fixed"
for f in */PKGBUILD; do
	d=${f%/PKGBUILD}
	src=$(grep -o 'github.com/ciscobugger/[A-Za-z0-9_.-]*\.git#[a-z]*=[^"]*' "$f" | head -1)
	[ -n "$src" ] || continue
	repo=$(sed 's|github.com/ciscobugger/\(.*\)\.git#.*|\1|' <<<"$src")
	ref=$(sed 's|.*#[a-z]*=||' <<<"$src"); kind=$(sed 's|.*#\([a-z]*\)=.*|\1|' <<<"$src")
	ref=$(cd "$d" && bash -c "source PKGBUILD; echo \"$ref\"")
	c=${clone[$repo]:-}
	if [ -z "$c" ] || [ ! -e "$c/.git" ]; then note "$d: $repo not checked out here"; continue; fi
	if [ "$kind" = tag ]; then
		git -C "$c" ls-remote --exit-code --tags origin "refs/tags/$ref" >/dev/null 2>&1 || { bad "$d: tag $ref is not on GitHub"; continue; }
		after=$(git -C "$c" rev-list --count "$ref..origin/HEAD" 2>/dev/null || git -C "$c" rev-list --count "$ref..HEAD")
		[ "$after" = 0 ] && ok "$d: $ref" || note "$d: $ref, $after commits after it are not in this release"
	elif [ -z "$(git -C "$c" remote)" ]; then
		# a clone with no remote is the private history of a published copy (publish-source): the pin is the public
		# repo's own commit, so it is checked there
		gh api "repos/ciscobugger/$repo/commits/$ref" --jq .sha >/dev/null 2>&1 && ok "$d: ${ref:0:7} (published)" \
			|| bad "$d: commit ${ref:0:7} is not on github.com/ciscobugger/$repo"
		continue
	else
		git -C "$c" fetch -q origin 2>/dev/null
		git -C "$c" branch -r --contains "$ref" 2>/dev/null | grep -q . || { bad "$d: commit ${ref:0:7} is not pushed"; continue; }
		# a release made on its own branch (release-<version>) is measured against that branch, not against whatever
		# the clone has checked out; a fix release (1.2.1) is made on its release's branch (release-1.2)
		rb=release-$version
		if ! git -C "$c" rev-parse -q --verify "origin/$rb" >/dev/null; then
			# made here and not pushed, it is still the one: measured against release-1.2 (older than 1.2.14's pins) or the
			# checkout instead, a pin left behind passed
			git -C "$c" rev-parse -q --verify "refs/heads/$rb" >/dev/null && { bad "$d: $rb is not on GitHub ($c): push it first"; continue; }
			rb=release-${version%.*}
		fi
		if git -C "$c" rev-parse -q --verify "origin/$rb" >/dev/null; then
			base="origin/$rb"
			unpushed=$(git -C "$c" rev-list --count "origin/$rb..$rb" 2>/dev/null || echo 0)
		else
			base=HEAD
			unpushed=$(git -C "$c" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
		fi
		behind=$(git -C "$c" rev-list --count "$ref..$base")
		[ "$behind" = 0 ] && ok "$d: ${ref:0:7} (${base#origin/})" || bad "$d: ${ref:0:7} is $behind commits behind ${base#origin/}: pin the new commit or say why not"
		[ "$unpushed" = 0 ] || bad "$d: $unpushed commits on ${base#origin/} in $c are not pushed"
		continue
	fi
	unpushed=$(git -C "$c" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
	[ "$unpushed" = 0 ] || bad "$d: $unpushed commits in $c are not pushed"
done

echo "== packages: each new version built, against the day of Arch Tacit ships"
db=/var/tmp/release-check; mkdir -p "$db"
# an earlier run's copy is no live database: read, it skipped what the release before had published
rm -f "$db/tacit.db.tar.zst"
gcloud storage cp -q gs://tacit-packages-2aafc574/x86_64/tacit.db.tar.zst "$db/" >/dev/null 2>&1 || note "the live repo's database could not be read: every package is checked"
live=$(tar -tf "$db/tacit.db.tar.zst" 2>/dev/null | sed -n 's|/$||p')
day=$(tools/arch-day)
# without it a package with no record of its day ("" = "") passed as built against it
[ -n "$day" ] || bad "tools/arch-day gives no day of Arch (the mirror's wrangler.jsonc): no package can be checked against the one Tacit ships"
# the commit that gave recipe $1 its version $2 (the newest to change its version lines, to that)
made() {
	local c
	for c in $(git log --format=%H -G'^(epoch|pkgver|pkgrel)=' -- "$1/PKGBUILD"); do
		[ "$(git show "$c:$1/PKGBUILD" | bash -c 'source /dev/stdin; echo "${epoch:+$epoch:}$pkgver-$pkgrel"' 2>/dev/null)" = "$2" ] && { echo "$c"; return; }
	done
}
# the release before this one: the commit that made the live tacit, whose recipes the live packages were built from
prev=$(made tacit "$(sed -n 's/^tacit-\([^-]*-[^-]*\)$/\1/p' <<<"$live")")
newest=0
for f in */PKGBUILD; do
	d=${f%/PKGBUILD}
	[ "$d" = tacit-device-book4-edge ] && continue      # aarch64, built on the Book4
	v=$(cd "$d" && bash -c 'source PKGBUILD; echo "${epoch:+$epoch:}$pkgver-$pkgrel"' 2>/dev/null) || continue
	if grep -qx "$d-$v" <<<"$live"; then
		# already published, so not part of this release, unless its recipe changed since (a pin moved, an install script
		# fixed) with the old version: nobody would get the change. Since the release before, or the later commit that
		# gave it this version when it was published on its own
		since=$(made "$d" "$v")
		[ -n "$since" ] || { bad "$d $v: published, and no commit here gives it that version"; continue; }
		[ -n "$prev" ] && git merge-base --is-ancestor "$since" "$prev" && since=$prev
		changed=$(git diff --name-only "$since" -- "$d" | sed "s|^$d/||" | paste -sd ' ')
		[ -z "$changed" ] || bad "$d $v: published, and its recipe changed since ($changed): give it a new pkgrel"
		continue
	fi
	p=$(ls -t $out/$d-$v-*.pkg.tar.zst 2>/dev/null | head -1)
	[ -n "$p" ] || { bad "$d $v: not built"; continue; }
	# the recipe is every file of its folder but what git ignores (makepkg's clones, src/, pkg/): an install script, a
	# preset or a patch fixed after the build would ship as it was. tacit/notes.json is compared by what it says instead:
	# its "verified" is written after the VM round (the notes' gate below) and shown to nobody
	newer=$(git ls-files -co --exclude-standard -- "$d" | while read -r x; do [ "$x" != tacit/notes.json ] && [ "$x" -nt "$p" ] && { echo "${x#"$d"/}"; break; }; done)
	[ -z "$newer" ] || { bad "$d $v: its recipe changed after it was built ($newer)"; continue; }
	if [ "$d" = tacit ] && ! bsdtar -xOf "$p" usr/share/tacit/notes.json 2>/dev/null | python3 -c '
import json, sys
said = lambda f: [{k: v for k, v in r.items() if k != "verified"} for r in json.load(f)["releases"]]
sys.exit(0 if said(sys.stdin) == said(open("tacit/notes.json")) else 1)' 2>/dev/null; then
		bad "$d $v: its notes changed after it was built (notes.json, beyond \"verified\")"; continue
	fi
	t=$(stat -c %Y "$p"); [ "$t" -gt "$newest" ] && newest=$t
	against=$(cat "$out/$d.built-against" 2>/dev/null || echo "")
	if [ -z "$against" ]; then bad "$d $v: no record of the Arch day it was built against"
	elif [ "$against" = "$day" ]; then ok "$d $v, against Arch $day"
	# an older day is no candidate: tacit-boot and tacit-portal built on it pin its Hyprland, which the day shipped may not have
	elif [[ "$against" < "$day" ]]; then bad "$d $v: built against $against, before the day Tacit ships ($day): build it again on $day"
	else note "$d $v: built against $against, Tacit ships $day (a candidate day: move it with tools/arch-day after the VM)"; fi
done

# a pin nothing meets fails every computer's update: each part tacit needs at a version is met by its recipe here, which
# the gate above has seen built or live
echo "== tacit's pins: each one met by its part's recipe"
for dep in $(cd tacit && bash -c 'source PKGBUILD; printf "%s\n" "${depends[@]}"'); do
	n=${dep%%[<>=]*}; [ "$n" != "$dep" ] || continue        # no version asked
	rest=${dep#"$n"}; pin=${rest##*[<>=]}; op=${rest%"$pin"}
	v=$(cd "$n" 2>/dev/null && bash -c 'source PKGBUILD; echo "${epoch:+$epoch:}$pkgver-$pkgrel"' 2>/dev/null) || { bad "tacit needs $dep: there is no $n recipe here"; continue; }
	r=$(vercmp "$v" "$pin")
	case "$op" in
		'>=') [ "$r" -ge 0 ] ;; '>') [ "$r" -gt 0 ] ;; '=') [ "$r" = 0 ] ;; '<=') [ "$r" -le 0 ] ;; '<') [ "$r" -lt 0 ] ;; *) false ;;
	esac && ok "tacit needs $dep: $n $v" || bad "tacit needs $dep, and the $n recipe is $v"
done

echo "== the VM round"
if [ ! -f "$record" ]; then bad "no VM round recorded for $version (tools/release-check $version --vm-passed \"…\")"
elif [ "$(stat -c %Y "$record")" -lt "$newest" ]; then bad "the VM round for $version came before the newest package: test again"
else ok "VM round: $(sed -n 2p "$record")"; fi

# The VM round looks at the screen; tools/vm-smoke exercises what 1.2.14's round missed (Thyris played nothing, the
# volume stopped at 99 on every updated computer) and records each check, pass or fail.
echo "== the VM smoke (tools/vm-smoke)"
smoke=$out/vm-smoke-$version
if [ ! -f "$smoke" ]; then bad "no VM smoke for $version (tools/vm-smoke $version)"
elif [ "$(sed -n 2p "$smoke" | cut -d, -f1)" != "tacit $version" ]; then bad "$smoke is for $(sed -n 2p "$smoke" | cut -d, -f1), not tacit $version"
elif [ "$(stat -c %Y "$smoke")" -lt "$newest" ]; then bad "the VM smoke for $version came before the newest package: run it again"
else
	for c in update plugins volume-100 thyris-sound apps-qml shell-log; do
		line=$(grep -E "^(pass|fail) $c:" "$smoke" | tail -1)
		case "$line" in pass*) ok "$line" ;; fail*) bad "$line" ;; *) bad "the VM smoke has no $c check" ;; esac
	done
fi

# A release note says what someone saw working on a running system (the owner, 2026-11-12: 1.2.14's notes claimed
# three fixes nobody had seen work). Each note of this release names how in the release's "verified", by the note's
# text: "vm: <check>", a check the VM smoke passed, "vm-hand: <what was seen in the VM, by whom>" (the owner,
# 2026-11-12: a VM check by hand counts), or "hardware: <who saw it, on what>". The others are listed for the owner to
# try, and stay out of the notes until someone has.
echo "== the notes: each one seen working"
python3 - "$version" "$smoke" <<'EOF' || failed=1
import json, os, re, sys
version, smoke = sys.argv[1:]
r = json.load(open("tacit/notes.json"))["releases"][0]
if r.get("version") != version:
    sys.exit(0)     # said above
passed = set()
if os.path.exists(smoke):
    passed = {m.group(1) for m in (re.match(r"pass (\S+):", line) for line in open(smoke)) if m}
changes, verified = r.get("changes", []), r.get("verified", {})
untried, bad = [], False
for note in changes:
    how = verified.get(note, "").strip()
    vm = re.fullmatch(r"vm: (\S+)", how)
    said = any(how.startswith(p) and how[len(p):].strip() for p in ("vm-hand:", "hardware:"))
    if (vm and vm.group(1) in passed) or said:
        print(f"  ok    {note[:60]}{'…' if len(note) > 60 else ''} ({how})")
    else:
        if vm:
            print(f"  FAIL  {note[:60]}… says {how}, which the VM smoke did not pass")
        untried.append(note)
for note in verified:
    if note not in changes:
        print(f"  FAIL  \"verified\" names a note that is not among the changes: {note[:60]}…")
        bad = True
if untried:
    print("  FAIL  needs a try on hardware; out of the notes until someone sees it work:")
    for note in untried:
        print(f"          - {note}")
sys.exit(1 if untried or bad else 0)
EOF

echo
[ "$failed" = 0 ] && echo "release-check: $version can be published" || echo "release-check: $version is not ready"
exit "$failed"
