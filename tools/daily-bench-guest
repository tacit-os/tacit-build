def step_settle(task):
    """after a task: a surface or a window it left that the desktop at rest did not have, once the surfaces and windows
    have stopped changing (the same twice in a row, 0.5 s apart, for at most 6 s: a closing one has gone by then)"""
    person, m = Person(), mark_file()
    last = [None]

    def steady():
        now_ = (sorted(person.layers()), sorted(c.get("address", "") for c in person.clients()))
        same, last[0] = now_ == last[0], now_
        return same
    poll(steady, 6, every=0.5)
    extra = sorted(set(person.layers()) - set(m.get("layers", [])) - TRANSIENT)
    left = [f"{c.get('class')}: {c.get('title')}" for c in person.clients() if c.get("address") not in m.get("windows", [])]
    out(task=task, layers=extra, windows=left)


def step_sampler(what):
    """beside the run: Hyprland's "not answering" (the dialog it runs for an app that missed its pings, which Tacit's
    hyprland-dialog turns into the notch's prompt), noted each second; and an idle inhibitor, so the 5-minute lock, the
    screen going off and the 15-minute sleep come only when the run asks for them"""
    pidf = f"{STATE}/sampler.pid"
    if what == "stop":
        try:
            os.killpg(int(open(pidf).read()), signal.SIGTERM)
        except (OSError, ValueError):
            pass
        out(ok=True)
    p = subprocess.Popen([sys.executable, "-I", os.path.abspath(__file__), "sample"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    open(pidf, "w").write(str(p.pid))
    out(ok=True, pid=p.pid)


def sample():
    inhibit = subprocess.Popen(["systemd-inhibit", "--what=idle", "--who=Tacit Daily", "--why=a benchmark run",
                                "sleep", "infinity"])
    seen = set()
    with open(f"{STATE}/anr.jsonl", "a") as log:
        while True:
            for pid in pids():
                a = b" ".join(cmdline(pid))
                if b"Application Not Responding" in a and pid not in seen:
                    seen.add(pid)
                    text = a.split(b"--text", 1)[-1][:200].decode(errors="replace").strip()
                    log.write(json.dumps({"wall": time.time(), "pid": pid, "text": text}) + "\n")
                    log.flush()
            if inhibit.poll() is not None:
                inhibit = subprocess.Popen(["systemd-inhibit", "--what=idle", "--who=Tacit Daily",
                                            "--why=a benchmark run", "sleep", "infinity"])
            time.sleep(1)       # the sampler's beat (a measurement's cadence, not a wait for something)


def typing(ident):
    """started apart by arm-typing: every key pressed until 3 s pass with none (at most 40 s), with the offset from the
    monotonic clock to the wall clock, which a page's times are on"""
    keys, presses, end = Keys(), [], now() + 40
    open(f"{STATE}/typing-{ident}.ready", "w").close()
    while now() < end and not (presses and now() - presses[-1] > 3):
        presses += [t for t, c, v in keys.read(0.1) if v == 1]
    res = f"{STATE}/typing-{ident}.json"
    json.dump({"presses": presses, "offset": time.time() - time.monotonic()}, open(res + ".tmp", "w"))
    os.replace(res + ".tmp", res)


def step_arm_typing(ident):
    for f in glob.glob(f"{STATE}/typing-{ident}.*"):
        os.remove(f)
    subprocess.Popen([sys.executable, "-I", os.path.abspath(__file__), "typing", ident], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    until("the key listener ready (its file written)", lambda: os.path.exists(f"{STATE}/typing-{ident}.ready"), 5, every=0.02, setup=True)
