def du(path):
    total = 0
    for root, _, files in os.walk(path, onerror=lambda e: None):
        for n in files:
            try:
                total += os.lstat(f"{root}/{n}").st_blocks * 512
            except OSError:
                pass
    return round(total / 2**20, 1)


