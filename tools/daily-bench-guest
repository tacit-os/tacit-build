PROBE_QML = """import QtQuick
import Quickshell
import qs.services
// Tacit Daily's probe: what the shell's own services make of this computer, in the person's language, as Settings'
// Network page (Network.ipAddress) and the VPN section (Vpn.connections) show it, printed every half second
ShellRoot {
    Component.onCompleted: console.log("DAILY-PROBE-START " + Network.ipAddress + Vpn.connected)
    Timer {
        interval: 500; running: true; repeat: true
        onTriggered: console.log("DAILY-PROBE " + JSON.stringify({ ip: Network.ipAddress, gateway: Network.gateway,
                                                                  vpn: Vpn.connections, connected: Vpn.connected }))
    }
}
"""


IDLE_STUB = """pragma Singleton
import QtQuick
import Quickshell
Singleton {
    property bool inhibit: false
    readonly property bool watching: false
    function inhibitForSession() {}
    function toggleInhibit(active) {}
}
"""


def probe(shell, work, env, want=lambda st: False, timeout=20, popen=None):
    """the shell's Network and Vpn services read by a probe in a copy of the shell (the installed one untouched), off
    screen, with a scratch home (the person's settings untouched) and the given environment (the person's language):
    their view as it is once want(view) holds, or as it stands after `timeout` s; {"error": ...} when it did not run"""
    copy = f"{work}/shell"
    os.makedirs(work, exist_ok=True)
    if not os.path.exists(f"{copy}/services/Network.qml"):
        subprocess.run(["rm", "-rf", copy])
        subprocess.run(["cp", "-a", shell, copy], check=True)
    open(f"{copy}/daily-probe.qml", "w").write(PROBE_QML)
    # Idle keeps the screen awake through a window of its own, which needs a desktop; the probe has none, and Idle has no
    # part in what it reads: in this private copy only, Idle without the window
    open(f"{copy}/services/Idle.qml", "w").write(IDLE_STUB)
    home = f"{work}/home"
    os.makedirs(home, exist_ok=True)
    e = dict(env, HOME=home, XDG_CONFIG_HOME=f"{home}/.config", XDG_STATE_HOME=f"{home}/.local/state",
             XDG_CACHE_HOME=f"{home}/.cache", XDG_DATA_HOME=f"{home}/.local/share", QT_QPA_PLATFORM="offscreen",
             QT_QUICK_BACKEND="software", QT_QPA_OFFSCREEN_NO_GLX="1")
    for k in ("WAYLAND_DISPLAY", "DISPLAY"):
        e.pop(k, None)
    argv = ["qs", "-n", "-p", f"{copy}/daily-probe.qml"]
    p = (popen or (lambda a, env: subprocess.Popen(a, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)))(argv, e)
    view, text, buf, end = None, b"", b"", now() + timeout
    try:
        while now() < end:
            r, _, _ = select.select([p.stdout], [], [], max(0.0, end - now()))
            if not r:
                break
            chunk = os.read(p.stdout.fileno(), 65536)
            if not chunk:
                break
            text, buf = (text + chunk)[-4000:], buf + chunk
            *lines, buf = buf.split(b"\n")
            for line in lines:
                m = re.search(rb"DAILY-PROBE (\{.*\})", line)
                if m:
                    view = json.loads(m.group(1))
            if view is not None and want(view):
                break
    finally:
        p.kill()
        p.wait()
    return view if view is not None else {"error": text.decode(errors="replace")[-400:] or "no word from the probe"}


def person_probe(person, want):
    os.makedirs(f"{STATE}/probe", exist_ok=True)
    subprocess.run(["chown", "-R", f"{person.uid}:", f"{STATE}/probe"])
    popen = lambda argv, env: subprocess.Popen(person.argv(["env", "-i", *[f"{k}={v}" for k, v in env.items()], *argv]),
                                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    r = probe(person.shell, f"{STATE}/probe", person.env, want, popen=popen)
    if "error" in r:
        raise Unmeasurable(f"the probe did not run: {r['error']}")
    return r


def step_lang_network():
    """Settings' Network page's IP (Network.ipAddress, what the page shows, or "None"), read in the person's language"""
    person = Person()
