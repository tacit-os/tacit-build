def step_await(kind, arg="", timeout="10"):
    """what the run waits for between its keys, instead of a pause: a surface open (layer) or gone (nolayer), an app's
    window (window), a window whose class or title holds arg (titled), the screen settled, the keyboard's active layout
    holding arg (keymap), the session locked or unlocked"""
    person, t = Person(), float(timeout)
    conds = {"layer": (f"{arg} shown", lambda: arg in person.layers()),
             "nolayer": (f"{arg} gone", lambda: arg not in person.layers()),
             "window": (f"a window of {arg}", lambda: windows(person, arg)),
             "titled": (f"a window named {arg!r}", lambda: [c for c in person.clients() if arg.lower() in (c.get("class", "") + " " + c.get("title", "")).lower()]),
             "keymap": (f"the keyboard on {arg}", lambda: arg.lower() in language(person)["active"].lower()),
             "locked": ("the session locked", person.locked), "unlocked": ("the session unlocked", lambda: not person.locked())}
    if kind == "settled":
        settled(person, t)
    else:
        what, cond = conds[kind]
        until(what, cond, t, every=0.1)
    out(ok=True)


def step_before_snapshot():
    """before the run saves the computer: the file cache dropped (so the snapshot holds only what is in use) and how much
    memory that is, which the cloud machine needs free on its disk"""
    os.sync()
    open("/proc/sys/vm/drop_caches", "w").write("3\n")
    m = {line.split(":")[0]: int(line.split()[1]) for line in open("/proc/meminfo")}
    out(ok=True, used_mb=round((m["MemTotal"] - m["MemFree"]) / 1024))


def step_ready(settle_file=""):
    """the desktop ready for the next part: the boot lock gone, the shell answering, the notch on the screen,
    PipeWire answering, the screen settled, and a settings file just written left alone by the shell for 3 s
    (the same size and time twice, 1.5 s apart). Up to 120 s"""
