def step_boot_state():
    """during a start: the uptime, and the boot lock (the sign-in screen) with the uptime at which it was up: the
    "Configuration Loaded" line of its log, or its start when that is not there"""
    up = float(open("/proc/uptime").read().split()[0])
    try:
        person = Person()
    except NoDesktop:
        out(uptime=up, bootlock=None, desktop=False)
    pid = bootlock_pid(person.uid)
    lock = None
    if pid:
        lock = {"pid": pid, "at": round(starttime(pid) / os.sysconf("SC_CLK_TCK"), 2), "how": "its start"}
        try:
            for line in open(f"/run/user/{person.uid}/quickshell/by-pid/{pid}/log.log", errors="replace"):
                m = re.match(r"(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d(?:\.\d+)?)\s.*Configuration Loaded", line)
                if m:
                    wall = time.mktime(time.strptime(m.group(1).split(".")[0], "%Y-%m-%d %H:%M:%S"))
                    wall += float("0." + m.group(1).split(".")[1]) if "." in m.group(1) else 0
                    lock.update(at=round(up - (time.time() - wall), 2), how="its log")
                    break
        except OSError:
            pass
    out(uptime=up, bootlock=lock, desktop=usable(person))


def step_idle(total, windows, window, samples):
    """the desktop left alone total seconds; over the last windows×window seconds, the processor time and the wakeups
    of each process measured, a window at a time; at the end its memory (PSS), samples times 20 s apart"""
    total, windows, window, samples = float(total), int(windows), float(window), int(samples)
    person = Person()
    rest = total - windows * window - (samples - 1) * 20
    time.sleep(max(0, rest))
    cpu, wake, sys_cpu, sys_ctxt = {}, {}, [], []
    hz = os.sysconf("SC_CLK_TCK")
    for _ in range(windows):
        t = {k: tree(v) for k, v in targets(person).items()}
        a = {p: ticks([p]) for ps in t.values() for p in ps}
        s0, t_0 = system_ticks(), now()
        time.sleep(window)
        b = {p: ticks([p]) for p in a if os.path.exists(f"/proc/{p}")}
        s1, dt = system_ticks(), now() - t_0
        for k, ps in t.items():
            both = [p for p in ps if p in b]
            if both:
                cpu.setdefault(k, []).append(round(sum(b[p][0] - a[p][0] for p in both) / hz / dt * 100, 2))
                wake.setdefault(k, []).append(round(sum(b[p][1] - a[p][1] for p in both) / dt, 1))
        busy = (s1[0] - s0[0]) - (s1[1] - s0[1])
        sys_cpu.append(round(busy / max(1, s1[0] - s0[0]) * 100, 2))
        sys_ctxt.append(round((s1[2] - s0[2]) / dt, 1))
    pss = {}
    for i in range(samples):
        if i:
            time.sleep(20)
        for k, v in targets(person).items():
            if v:
                pss.setdefault(k, []).append(pss_mb(tree(v)))
    out(ok=True, cpu=cpu, wakeups=wake, system_cpu=sys_cpu, system_ctxt=sys_ctxt, pss=pss,
        pids={k: v for k, v in targets(person).items()})


