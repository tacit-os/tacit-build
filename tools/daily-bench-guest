def out(**kw):
    """a step's answer, its last line; "outcome" is worked, failed, or unmeasured (could not measure: the step's own
    setup, or the computer, not Tacit)"""
    kw.setdefault("outcome", "worked" if kw.get("ok") else "failed")
    print(json.dumps(kw))
    sys.exit(0)


class Missed(Exception):
    """what was waited for, a thing Tacit does, did not happen: the step failed"""


class Unmeasurable(Exception):
    """the step could not measure: its own setup failed, or the computer did not answer; neither a pass nor Tacit's failure"""


def poll(cond, timeout, every=0.2):
    """cond() asked every `every` s until it gives something true, for at most `timeout` s: that value, or None. The
    one wait in this file that stands for "until": every other wait is a measurement and says so"""
    end = now() + timeout
    while True:
        v = cond()
        if v or now() >= end:
            return v
        time.sleep(min(every, max(0.0, end - now())))


def until(what, cond, timeout, every=0.2, setup=False):
    """poll(), and on the deadline "did not happen in N s: <what>": Missed, or Unmeasurable when it is the step's own setup"""
    v = poll(cond, timeout, every)
    if not v:
        raise (Unmeasurable if setup else Missed)(f"did not happen in {timeout:g} s: {what}")
    return v


def now():
    return time.monotonic()


def ms(a, b):
    return round((b - a) * 1000, 1)


def stats(values):
    v = sorted(x for x in values if x is not None)
    if not v:
        return None
    n = len(v)
    med = v[n // 2] if n % 2 else (v[n // 2 - 1] + v[n // 2]) / 2
    return {"median": med, "low": v[0], "high": v[-1], "n": n}


# ---------------------------------------------------------------- the person at the desktop

class NoDesktop(Exception):
    pass


def starttime(pid):
    try:
        return int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[19])
    except (OSError, IndexError, ValueError):
        return 0


def pids():
    return [int(p) for p in os.listdir("/proc") if p.isdigit()]


class Person:
    """The owner of the oldest process that carries the desktop's environment (one the session started), and that
    environment (tools/vm-smoke-guest's session())."""

    def __init__(self):
        for pid in sorted(pids(), key=starttime):
            try:
                if os.stat(f"/proc/{pid}").st_uid < 1000:
                    continue
                raw = open(f"/proc/{pid}/environ", "rb").read().split(b"\0")
            except OSError:
                continue
            if not any(e.startswith(b"HYPRLAND_INSTANCE_SIGNATURE=") for e in raw):
                continue
            self.uid = os.stat(f"/proc/{pid}").st_uid
            self.envs = [e for e in raw if e]
            self.env = dict(e.decode(errors="surrogateescape").split("=", 1) for e in self.envs if b"=" in e)
            import pwd
            p = pwd.getpwuid(self.uid)
            self.user, self.home = p.pw_name, p.pw_dir
            self.shell = os.path.realpath(self.env.get("TACIT_SHELL", ""))
            self.runtime = self.env.get("XDG_RUNTIME_DIR", f"/run/user/{self.uid}")
            self.sig = self.env["HYPRLAND_INSTANCE_SIGNATURE"]
            return
        raise NoDesktop("nobody's desktop is up (no process carries HYPRLAND_INSTANCE_SIGNATURE)")

    def argv(self, argv, extra=None):
        envs = self.envs + [f"{k}={v}".encode() for k, v in (extra or {}).items()]
        return ["runuser", "-u", self.user, "--", "env", "-i", *envs, *argv]

    def run(self, argv, timeout=10, input=None, extra=None):
        """(exit code, output, errors) of argv run as the person; 124 when it ran past timeout"""
        try:
            p = subprocess.run(self.argv(argv, extra), input=input, capture_output=True, timeout=timeout)
            return p.returncode, p.stdout, p.stderr
        except subprocess.TimeoutExpired:
            return 124, b"", b"timed out"

    def text(self, argv, timeout=10):
        code, o, _ = self.run(argv, timeout)
        return o.decode(errors="replace").strip() if code == 0 else None

    def spawn(self, argv, extra=None, log="/dev/null"):
        """argv started by Hyprland, as a key or the dock starts a program: in the person's session, so polkit takes it
        for the person at the computer (a process started from here is in no session, and Settings' and Apps' password-free
        and password asks are refused to it)"""
        env = " ".join(f"{k}={sh(v)}" for k, v in (extra or {}).items())
        cmd = f"{'env ' + env + ' ' if env else ''}{' '.join(sh(a) for a in argv)} >{sh(log)} 2>&1"
        return self.dispatch(f"hl.dsp.exec_cmd([==[{cmd}]==])")

    def which(self, name):
        dirs = [self.env.get("TACIT_BIN", ""), f"{self.shell}/bin", f"{self.shell}/scripts/viewer"]
        for d in dirs + self.env.get("PATH", "").split(":"):
            if d and os.access(f"{d}/{name}", os.X_OK):
                return f"{d}/{name}"
        return name

    def hypr(self, *args):
        o = self.text(["hyprctl", "-j", *args], 5)
        try:
            return json.loads(o) if o else None
        except ValueError:
            return None

    def dispatch(self, expr):
        return self.run(["hyprctl", "dispatch", expr], 5)[0] == 0

    def layers(self):
        names = []
        for mon in (self.hypr("layers") or {}).values():
            for level in mon.get("levels", {}).values():
                names += [layer.get("namespace", "") for layer in level]
        return names

    def clients(self):
        return self.hypr("clients") or []

    def ipc(self, path, *args, timeout=3):
        """one IPC call to the quickshell instance running path: its answer, or None when it did not answer"""
        return self.text(["qs", "-p", path, "ipc", *args], timeout)

    def locked(self):
        sid = self.env.get("XDG_SESSION_ID") or subprocess.run(["loginctl", "show-user", self.user, "-p", "Display", "--value"],
                                                               capture_output=True, text=True).stdout.strip()
        o = subprocess.run(["loginctl", "show-session", sid, "-p", "LockedHint", "--value"], capture_output=True,
                           text=True).stdout.strip() if sid else ""
        return o == "yes"

    def shot(self):
        """the screen now, a quarter of its size (grim, as the person): (width, height, RGB bytes) or None"""
        for args in (["-s", "0.25"], []):
            code, o, _ = self.run(["grim", *args, "-t", "ppm", "-"], 15)
            if code == 0 and o:
                return parse_ppm(o)
        return None

    def config(self):
        try:
            return json.load(open(f"{self.home}/.config/illogical-impulse/config.json"))
        except (OSError, ValueError):
            return {}


def sh(s):
    return "'" + str(s).replace("'", "'\\''") + "'"


def parse_ppm(b):
    """a binary PPM's (width, height, RGB bytes)"""
    fields, i = [], 2
    if b[:2] != b"P6":
        return None
    while len(fields) < 3:
        while b[i:i + 1].isspace():
            i += 1
        if b[i:i + 1] == b"#":
            i = b.index(b"\n", i) + 1
            continue
        j = i
        while not b[j:j + 1].isspace():
            j += 1
        fields.append(int(b[i:j]))
        i = j
    w, h, _ = fields
    return w, h, b[i + 1:i + 1 + w * h * 3]


# Screenshots are taken at a quarter of the screen's size (grim -s 0.25: 480x270 for 1920x1080) and judged so:
#   settled: two screenshots in a row that differ in at most SETTLE_SHARE of their pixels by more than SETTLE_DIFF in a
#     channel (an animation, a fade, a page still drawing are not settled); asked every 0.25 s, for at most 10 s;
#   a pattern colour: a pixel within NEAR (distance in RGB) of it, which takes scaling's blur at the cells' edges and a
#     moderate dimming, and not black: a black screen is no pattern colour.
SETTLE_DIFF, SETTLE_SHARE, NEAR = 24, 0.005, 80


def same_screen(a, b):
    if not (a and b) or a[:2] != b[:2]:
        return False
    da, db, n, diff = a[2], b[2], 0, 0
    for i in range(0, len(da) - 2, 3 * 3):
        n += 1
        diff += abs(da[i] - db[i]) > SETTLE_DIFF or abs(da[i + 1] - db[i + 1]) > SETTLE_DIFF or abs(da[i + 2] - db[i + 2]) > SETTLE_DIFF
    return n > 0 and diff / n <= SETTLE_SHARE


def settled(person, timeout=10):
    """the screen once it has stopped changing: the second of two equal screenshots in a row"""
    last = [person.shot()]

    def still():
        img = person.shot()
        same = same_screen(last[0], img)
        last[0] = img
        return img if same else None
    return until("the screen settled (two screenshots in a row the same)", still, timeout, every=0.25)


def dist2(r, g, b, c):
    return (r - c[0]) ** 2 + (g - c[1]) ** 2 + (b - c[2]) ** 2


def full_screen_match(img, grid):
    """the share of the screen showing the full-screen pattern `grid` (rows of colours) where it should: each pixel the
    pattern colour of its cell, within NEAR"""
    if not img:
        return 0.0
    w, h, d = img
    rows, cols = len(grid), len(grid[0])
    hit = total = 0
    for y in range(0, h, 2):
        cell = grid[min(rows - 1, y * rows // h)]
        for x in range(0, w, 2):
            i = (y * w + x) * 3
            total += 1
            hit += dist2(d[i], d[i + 1], d[i + 2], cell[min(cols - 1, x * cols // w)]) <= NEAR * NEAR
    return hit / total if total else 0.0


def find_pattern(img, grid, min_area):
    """where on the screen the picture `grid` (rows x cols of colours) shows: its first cell's colour found, the box it
    must span from there, and in each cell the share of pixels of that cell's colour. (found, share of its worst cell,
    share of the screen it takes); found when every cell is at least 80 % its colour and the box at least min_area of
    the screen"""
    if not img:
        return False, 0.0, 0.0
    w, h, d = img
    rows, cols = len(grid), len(grid[0])
    first = grid[0][0]
    xs, ys = [0] * w, [0] * h
    for y in range(h):
        for x in range(0, w):
            i = (y * w + x) * 3
            if dist2(d[i], d[i + 1], d[i + 2], first) <= NEAR * NEAR:
                xs[x] += 1
                ys[y] += 1
    span = lambda v: [i for i, n in enumerate(v) if n >= max(3, 0.3 * max(v))] if max(v) else []
    sx, sy = span(xs), span(ys)
    if not sx or not sy:
        return False, 0.0, 0.0
    cw, ch = sx[-1] - sx[0] + 1, sy[-1] - sy[0] + 1
    x0, y0 = sx[0], sy[0]
    worst = 1.0
    for r in range(rows):
        for c in range(cols):
            hit = total = 0
            for y in range(y0 + r * ch + ch // 8, min(h, y0 + (r + 1) * ch - ch // 8)):
                for x in range(x0 + c * cw + cw // 8, min(w, x0 + (c + 1) * cw - cw // 8)):
                    i = (y * w + x) * 3
                    total += 1
                    hit += dist2(d[i], d[i + 1], d[i + 2], grid[r][c]) <= NEAR * NEAR
            worst = min(worst, hit / total if total else 0.0)
    area = (cw * cols) * (ch * rows) / (w * h)
    return worst >= 0.8 and area >= min_area, round(worst, 3), round(area, 4)


def fraction(img, test, step=3):
    """the share of the picture's pixels (every step-th one) for which test(r, g, b) holds"""
    if not img:
        return 0.0
    _, _, d = img
    hit = total = 0
    for i in range(0, len(d) - 2, 3 * step):
        total += 1
        hit += test(d[i], d[i + 1], d[i + 2])
    return hit / total if total else 0.0


def near(c, tol=40):
    return lambda r, g, b: abs(r - c[0]) <= tol and abs(g - c[1]) <= tol and abs(b - c[2]) <= tol


def closer(c, other):
    d = lambda r, g, b, k: (r - k[0]) ** 2 + (g - k[1]) ** 2 + (b - k[2]) ** 2
    return lambda r, g, b: d(r, g, b, c) < d(r, g, b, other)


# ---------------------------------------------------------------- pictures, a PDF and a page, made here

def png(w, h, row):
    """a PNG whose every row is the RGB bytes row(y)"""
    raw = b"".join(b"\0" + row(y) for y in range(h))
    chunk = lambda t, d: struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d))
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


def solid(w, h, c):
    line = bytes(c) * w
    return png(w, h, lambda y: line)


def grid_png(w, h, grid):
    """a picture of rows x cols cells, each one colour of `grid`"""
    rows, cols = len(grid), len(grid[0])
    lines = [b"".join(bytes(grid[r][min(cols - 1, x * cols // w)]) for x in range(w)) for r in range(rows)]
    return png(w, h, lambda y: lines[min(rows - 1, y * rows // h)])


def pdf(bands, pages=None):
    """an A4 PDF, a page per list of colours in `pages` (or one page of `bands`), each page in horizontal bands, top
    first"""
    objs = [b"<< /Type /Catalog /Pages 2 0 R >>", None]
    kids = []
    for bs in pages or [bands]:
        n, ops = len(bs), []
        for k, c in enumerate(bs):
            y = 842 - (k + 1) * 842 / n
            ops.append(f"{c[0] / 255:.3f} {c[1] / 255:.3f} {c[2] / 255:.3f} rg 0 {y:.1f} 595 {842 / n:.1f} re f")
        page = "\n".join(ops).encode()
        kids.append(len(objs) + 1)
        objs.append(b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Contents %d 0 R >>" % (len(objs) + 2))
        objs.append(b"<< /Length %d >>\nstream\n" % len(page) + page + b"\nendstream")
    objs[1] = b"<< /Type /Pages /Kids [" + b" ".join(b"%d 0 R" % k for k in kids) + b"] /Count %d >>" % len(kids)
    body, offsets = b"%PDF-1.4\n", []
    for n, o in enumerate(objs, 1):
        offsets.append(len(body))
        body += b"%d 0 obj\n" % n + o + b"\nendobj\n"
    xref = len(body)
    body += b"xref\n0 %d\n0000000000 65535 f \n" % (len(objs) + 1) + b"".join(b"%010d 00000 n \n" % o for o in offsets)
    return body + b"trailer\n<< /Size %d /Root 1 0 R >>\nstartxref\n%d\n%%%%EOF\n" % (len(objs) + 1, xref)


