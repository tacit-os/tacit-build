def step_praxis():
    """Praxis started from the menu, until its session list has loaded from the agent host (no Claude account needed),
    and a new session opens in it"""
    person = Person()
    if running(person, "praxis"):
        quit_app(person, "praxis")
    qml = f"{person.shell}/claude.qml"
    t0 = now()
    launch(person, "praxis")
    state, listed = None, None
    while now() < t0 + 45:
        o = person.ipc(qml, "call", "claudeapp", "state")
        try:
            state = json.loads(o) if o else None
        except ValueError:
            state = None
        if state and state.get("connected"):
            listed = now()
            break
        time.sleep(0.2)
    if listed is None:
        out(ok=False, why="Praxis did not answer" if state is None else "Praxis did not reach the agent host: no session list")
    o = person.ipc(qml, "call", "claudeapp", "newSession")
    try:
        new = json.loads(o) if o else {}
    except ValueError:
        new = {}
    ok = str(new.get("title", "")).startswith("New session")
    out(ok=ok, list_ms=ms(t0, listed), history=state.get("history"), rows=state.get("rows"),
        why=None if ok else f"a new session did not open (Praxis says {o!r})")


def step_update_check():
    """Settings' Check for updates (tacit-fetch-updates-now, started by the person as Settings starts it): it ends well
    and the time of the last look moves"""
    person = Person()
    unit = "tacit-fetch-updates-now.service"
    w0, t0 = time.time(), now()
    before = unit_runs(unit)
    if not person.spawn(["systemctl", "start", "--no-block", unit], log=f"{STATE}/update-check.log"):
        out(ok=False, why="Hyprland did not take the command")
    state = {}
    while now() < t0 + 30 and unit_runs(unit) == before:
        time.sleep(0.5)
    if unit_runs(unit) == before:
        out(ok=False, why=f"the check did not start: {open(f'{STATE}/update-check.log').read().strip()[:200]}")
    while now() < t0 + 900:
        o = subprocess.run(["systemctl", "show", unit, "-p", "ActiveState,Result,ExecMainStatus"], capture_output=True,
                           text=True).stdout
        state = dict(line.split("=", 1) for line in o.splitlines() if "=" in line)
        if state.get("ActiveState") in ("inactive", "failed"):
            break
        time.sleep(1)
    try:
        checked = os.path.getmtime("/var/lib/tacit/updates-checked") >= w0 - 1
    except OSError:
        checked = False
    waiting = subprocess.run(["pacman", "-Qu"], capture_output=True, text=True).stdout.splitlines()
    ok = state.get("Result") == "success" and checked
    out(ok=ok, seconds=round(now() - t0, 1), waiting=len(waiting),
        why=None if ok else f"the check ended {state.get('ActiveState')}/{state.get('Result')} "
                            f"(status {state.get('ExecMainStatus')}){'' if checked else ', and the last look did not move'}")


def unit_runs(unit):
    """how many times the unit has been started (its invocation id changes each time)"""
    return subprocess.run(["systemctl", "show", unit, "-p", "InvocationID", "--value"], capture_output=True, text=True).stdout.strip()


PROBE = "tacit-daily-probe"


def step_probe_repo(n):
    """for the soak's update: a test repo on this computer (/var/tmp/daily/repo) with a package of its own at version n,
    [daily-test] in pacman.conf above the others; version 1 is installed first so there is something to update"""
    n = int(n)
    repo = f"{STATE}/repo"
    os.makedirs(repo, exist_ok=True)
    pkg = probe_package(repo, n)
    subprocess.run(["repo-add", "-q", f"{repo}/daily-test.db.tar.gz", pkg], check=True, capture_output=True)
    conf = open("/etc/pacman.conf").read()
    if "[daily-test]" not in conf:
        if not os.path.exists(f"{STATE}/pacman.conf"):
            open(f"{STATE}/pacman.conf", "w").write(conf)
        i = conf.find("\n[", conf.find("[options]") + 1)
        conf = conf[:i] + f"\n\n[daily-test]\nSigLevel = Optional TrustAll\nServer = file://{repo}\n" + conf[i:]
        open("/etc/pacman.conf", "w").write(conf)
    have = subprocess.run(["pacman", "-Q", PROBE], capture_output=True, text=True).stdout.split()
    if not have and n > 1:
        subprocess.run(["pacman", "-U", "--noconfirm", probe_package(repo, n - 1)], check=True, capture_output=True)
    out(ok=True, package=os.path.basename(pkg))


def probe_package(repo, n):
    import io, tarfile
    path = f"{repo}/{PROBE}-{n}-1-any.pkg.tar.gz"
    if os.path.exists(path):
        return path
    body = f"{n}\n".encode()
    info = (f"pkgname = {PROBE}\npkgbase = {PROBE}\npkgver = {n}-1\npkgdesc = Tacit Daily's update probe\n"
            f"url = https://tacitos.co\nbuilddate = {int(time.time())}\npackager = Tacit Daily\nsize = {len(body)}\n"
            f"arch = any\n").encode()
    with tarfile.open(path, "w:gz") as t:
        for name, data in ((".PKGINFO", info), (f"usr/share/{PROBE}/version", body)):
            ti = tarfile.TarInfo(name)
            ti.size, ti.mtime, ti.mode = len(data), int(time.time()), 0o644
            t.addfile(ti, io.BytesIO(data))
    return path


def step_update_arm():
    """what Settings' Check for updates and Restart run: the download, and the install armed for the next start"""
    person = Person()
    unit, arm = "tacit-fetch-updates-now.service", "tacit-update@now.service"
    for u in (unit, arm):
        before, t0 = unit_runs(u), now()
        person.spawn(["systemctl", "start", u], log=f"{STATE}/update-arm.log")
        while now() < t0 + 900 and (unit_runs(u) == before or subprocess.run(
                ["systemctl", "is-active", u], capture_output=True, text=True).stdout.strip() in ("activating", "active")):
            time.sleep(1)
        result = subprocess.run(["systemctl", "show", u, "-p", "Result", "--value"], capture_output=True, text=True).stdout.strip()
        if unit_runs(u) == before or result != "success":
            out(ok=False, why=f"{u} {'did not start' if unit_runs(u) == before else 'ended ' + result}: "
                              f"{open(f'{STATE}/update-arm.log').read().strip()[:200]}")
        if u == unit and not subprocess.run(["pacman", "-Qu", PROBE], capture_output=True, text=True).stdout.strip():
            out(ok=False, why="the download did not find the test repo's new version")
    out(ok=True)


def step_update_done(n):
    have = subprocess.run(["pacman", "-Q", PROBE], capture_output=True, text=True).stdout.split()
    try:
        result = json.load(open("/var/lib/tacit/update-result"))
    except (OSError, ValueError):
        result = None
    why = []
    if not have or have[1] != f"{n}-1":
        why.append(f"the probe is {have[1] if have else 'not installed'}, not {n}-1")
    if not (result or {}).get("ok"):
        why.append(f"the install at the restart said {result}")
    out(ok=not why, why="; ".join(why) or None)


