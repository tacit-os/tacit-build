def step_mark(quiet=True):
    """where the run starts: the time, how far each log has got, the surfaces and windows of the desktop at rest"""
    person = Person()
    m = {"wall": time.time(), "logs": {p: os.path.getsize(p) for p in qs_logs(person.uid)},
         "layers": sorted(set(person.layers())), "windows": [c.get("address") for c in person.clients()]}
    json.dump(m, open(f"{STATE}/mark.json", "w"))
