def step_page_load(runs):
    """tools/loadtime's method on Thyris: Navigation Timing over the DevTools protocol, the cache off and cleared before
    each load, so each load is a first one; the page is served from this computer"""
    person = Person()
    materials()
    if not (running(person, "thyris") and thyris_answers()):
        r = start_app(person, "thyris", cold=False)
        if not r["ok"]:
            out(ok=False, why=f"Thyris did not start with its DevTools port: {r['why']}")
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), lambda *a: Quiet(*a, directory=f"{STATE}/www"))
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    url = f"http://127.0.0.1:{srv.server_address[1]}/index.html"
    rows = page_loads(cdp_page(), url, int(runs))
    srv.shutdown()
    good = [r for r in rows if r.get("load")]
    out(ok=len(good) == len(rows), runs=rows, why=None if len(good) == len(rows) else f"{len(rows) - len(good)} loads did not finish")


class Quiet(http.server.SimpleHTTPRequestHandler):
    def log_message(self, *a):
        pass


READ = ("(() => { const n = performance.getEntriesByType('navigation')[0] || {};"
        "const fcp = (performance.getEntriesByType('paint').find(x => x.name === 'first-contentful-paint') || {}).startTime || 0;"
        "return JSON.stringify({ ttfb: Math.round(n.responseStart||0), dcl: Math.round(n.domContentLoadedEventEnd||0),"
        "load: Math.round(n.loadEventEnd||0), fcp: Math.round(fcp), title: document.title }); })()")


def page_loads(ws, url, runs):
    c = CDP(ws, timeout=30)
    for m in ("Page.enable", "Network.enable", "Runtime.enable"):
        c.send(m)
    c.send("Network.setCacheDisabled", {"cacheDisabled": True})
    rows = []
    origin = url.split("/index.html")[0]
    for _ in range(runs):
        c.send("Page.navigate", {"url": "about:blank"})
        time.sleep(0.4)
        c.events.clear()
        c.send("Network.clearBrowserCache")
        c.send("Storage.clearDataForOrigin", {"origin": origin, "storageTypes": "cache_storage,service_workers,shader_cache"})
        t0 = now()
        c.send("Page.navigate", {"url": url})
        c.wait("Page.loadEventFired", 60)
        row = {"error": "timed out"}
        for _ in range(20):
            time.sleep(0.25)
            r = c.send("Runtime.evaluate", {"expression": READ, "returnByValue": True})
            try:
                row = json.loads(r["result"]["result"]["value"])
            except (KeyError, TypeError, ValueError):
                continue
            if row.get("load", 0) > 0 and row.get("fcp", 0) > 0:      # the first paint can be noted after the load
                break
        row["wall"] = ms(t0, now())
        rows.append(row)
    c.close()
    return rows


