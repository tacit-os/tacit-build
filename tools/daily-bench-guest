def suites():
    """the workflow suites' steps (tools/daily-bench-suites, beside this file)"""
    import importlib.machinery
    return importlib.machinery.SourceFileLoader("suites", os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                                                       "daily-bench-suites")).load_module().STEPS


def main(argv):
    """one step, its answer printed; what went wrong mapped to the three outcomes"""
    steps = STEPS if argv and argv[0] in STEPS else suites()
    if not argv or argv[0] not in steps:
        sys.exit(__doc__)
    os.makedirs(STATE, exist_ok=True)
    try:
        steps[argv[0]](*argv[1:])
    except Missed as e:
        out(ok=False, outcome="failed", why=str(e))
    except (Unmeasurable, NoDesktop) as e:
        out(ok=False, outcome="unmeasured", why=str(e))
    except Exception as e:      # the bench's own fault: never a pass, never Tacit's failure
        import traceback
        out(ok=False, outcome="unmeasured", why=f"the bench's own error: {e!r} at {traceback.extract_tb(e.__traceback__)[-1].lineno}")


if __name__ == "__main__":
    main(sys.argv[1:])
