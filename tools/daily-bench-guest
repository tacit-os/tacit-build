READ = ("(() => { const n = performance.getEntriesByType('navigation')[0] || {};"
        "const fcp = (performance.getEntriesByType('paint').find(x => x.name === 'first-contentful-paint') || {}).startTime || 0;"
        "return JSON.stringify({ ttfb: Math.round(n.responseStart||0), dcl: Math.round(n.domContentLoadedEventEnd||0),"
        "load: Math.round(n.loadEventEnd||0), fcp: Math.round(fcp), title: document.title }); })()")


def page_loads(ws, url, runs):
    c = CDP(ws, timeout=30)
    for m in ("Page.enable", "Network.enable", "Runtime.enable"):
        c.send(m)
    c.send("Network.setCacheDisabled", {"cacheDisabled": True})
    rows = []
    origin = url.split("/index.html")[0]
    for _ in range(runs):
        c.events.clear()
        c.send("Page.navigate", {"url": "about:blank"})
        if not c.wait("Page.loadEventFired", 10):
            raise Unmeasurable("did not happen in 10 s: Thyris on about:blank between loads")
        c.events.clear()
        c.send("Network.clearBrowserCache")
        c.send("Storage.clearDataForOrigin", {"origin": origin, "storageTypes": "cache_storage,service_workers,shader_cache"})
        t0 = now()
        c.send("Page.navigate", {"url": url})
        c.wait("Page.loadEventFired", 60)
        got = [{"error": "timed out"}]

        def timing():
            r = c.send("Runtime.evaluate", {"expression": READ, "returnByValue": True})
            try:
                got[0] = json.loads(r["result"]["result"]["value"])
            except (KeyError, TypeError, ValueError):
                return False
            return got[0].get("load", 0) > 0 and got[0].get("fcp", 0) > 0     # the first paint can be noted after the load
        poll(timing, 5, every=0.25)
        row = got[0]
        row["wall"] = ms(t0, now())
        rows.append(row)
    c.close()
    return rows


