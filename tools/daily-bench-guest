def step_lang_vpn():
    """a VPN shown as connected: a WireGuard profile made here, needing no server (NetworkManager has it up without a
    peer), brought up, then the shell's Vpn service read in the person's language; the profile removed after"""
    person = Person()
    name = "tacit-daily-vpn"
    nm = lambda *a: subprocess.run(["nmcli", *a], capture_output=True, text=True, env=dict(os.environ, LC_ALL="C"))
    nm("connection", "delete", name)
    key = base64.b64encode(os.urandom(32)).decode()
    r = nm("connection", "add", "type", "wireguard", "ifname", "wg-daily", "con-name", name, "connection.autoconnect", "no",
           "wireguard.private-key", key, "ipv4.method", "manual", "ipv4.addresses", "10.213.0.2/32", "ipv6.method", "disabled")
    up = r.returncode == 0 and nm("connection", "up", name).returncode == 0
    if not up:
        nm("connection", "delete", name)
        out(ok=False, why=f"the stand-in VPN could not be brought up: {(r.stderr or r.stdout).strip()[:200]}")
    until("NetworkManager saying the stand-in VPN is activated", lambda: "activated" in nm(
        "-t", "-f", "GENERAL.STATE", "connection", "show", name).stdout, 20, every=0.5, setup=True)
    p = person_probe(person, lambda st: any(c.get("name") == name and c.get("active") for c in st.get("vpn") or []))
    nm("connection", "delete", name)
    mine = [c for c in p.get("vpn") or [] if c.get("name") == name]
    ok = bool(mine and mine[0].get("active")) and p.get("connected") is True
    out(ok=ok, seen=mine, lang=person.env.get("LANG"),
        why=None if ok else ("the probe did not run: " + p["error"] if "error" in p else
                             f"the shell does not show the VPN as connected in {person.env.get('LANG')} (it read {mine or 'no VPN'})"))


# ---------------------------------------------------------------- a lived-in home, before and after an update

# settings a person chose (not the defaults), which an update must keep
CHOICES = {"appearance.transparency.enable": False, "battery.low": 30, "light.night.colorTemperature": 4500}
OVERRIDE = 'hl.config({ input = { kb_layout = "us" } })\n'     # what Settings > Hyprland wrote up to 1.2.13
VCONSOLE, MIRRORS, UPDATE_RESULT = "/etc/vconsole.conf", "/etc/pacman.d/mirrorlist", "/var/lib/tacit/update-result"


def chosen_idle(text):
    """the packaged hypridle.conf as Settings' Lock & sleep copies it into the home when the person changes a time: the
    whole file, the lock's timeout (the first) set to their 600 s"""
    return re.sub(r"(timeout\s*=\s*)\d+", lambda m: m.group(1) + "600", text, count=1)


def dig(d, path, value=None, put=False):
    *head, last = path.split(".")
    for k in head:
        d = d.setdefault(k, {}) if put else (d.get(k) or {})
    if put:
        d[last] = value
    return d.get(last)


def packaged_hypridle():
    o = subprocess.run(["pacman", "-Qlq", "tacit-shell"], capture_output=True, text=True).stdout.split()
    return next((f for f in o if f.endswith("/hypr/hypridle.conf")), None)


def idle_lines(text):
    """hypridle.conf without the person's own numbers (the three timeouts), to compare one release's with another's"""
    return [re.sub(r"(timeout\s*=\s*)\d+", r"\1N", line).strip() for line in text.splitlines()
            if line.strip() and not line.strip().startswith("#")]


def step_lived_in_home(settings, day):
    """the home of someone who has used Tacit for a while, on the release before: that release's settings file with its
    old defaults (Loudest allowed 99, keyboard "us"), their pins, wallpaper and three settings of their own; a
    hypridle.conf copied once into the home by Settings' Lock & sleep (the lock at 10 minutes); the kb_layout line old
    Settings wrote into shellOverrides/main.lua; and a mirror list of their own without Tacit's server. Their files as
    they were are kept, to put back after the run."""
    person = Person()
    cfg = f"{person.home}/.config/illogical-impulse/config.json"
    idle = f"{person.home}/.config/hypr/hypridle.conf"
    over = f"{person.home}/.config/hypr/hyprland/shellOverrides/main.lua"
    mirrors = MIRRORS
    keep = f"{STATE}/lived-orig.json"
    if not os.path.exists(keep):
        json.dump({f: open(f).read() if os.path.exists(f) else None for f in (cfg, idle, over, mirrors)}, open(keep, "w"))
    c = json.load(open(settings))
    pins = list(c.setdefault("dock", {}).get("pinnedApps") or [])
    if "org.mozilla.firefox" not in pins:
        pins.insert(pins.index("foot") + 1 if "foot" in pins else len(pins), "org.mozilla.firefox")
    c["dock"]["pinnedApps"] = pins
    pic = sorted(glob.glob("/usr/share/tacit/**/*.jpg", recursive=True) + glob.glob("/usr/share/backgrounds/**/*.jpg", recursive=True))
    dig(c, "background.wallpaperPath", pic[0] if pic else f"{STATE}/wall-b.png", put=True)
    for k, v in CHOICES.items():
        dig(c, k, v, put=True)
    packaged = packaged_hypridle()
    before = open(packaged).read() if packaged else ""      # no packaged file: no copy is made (a blank one stops hypridle)
    copied = chosen_idle(before)
    want = {"maxAllowed": dig(c, "audio.protection.maxAllowed"), "kbLayout": dig(c, "hyprland.input.kbLayout"),
            "pins": pins, "wallpaper": dig(c, "background.wallpaperPath"), "choices": CHOICES, "idle_before": before,
            "packaged_idle": packaged, "session": subprocess.run(["pacman", "-Q", "tacit-session"], capture_output=True,
                                                                  text=True).stdout.split()[-1:]}
    json.dump(want, open(f"{STATE}/lived-home.json", "w"))
    for path, text in ((cfg, json.dumps(c, indent=2)), (idle, copied if before else None),
                       (over, (open(over).read() if os.path.exists(over) else "") + OVERRIDE)):
        if text is None:
            continue
        os.makedirs(os.path.dirname(path), exist_ok=True)
        open(path + ".daily", "w").write(text)
        os.replace(path + ".daily", path)
    subprocess.run(["chown", "-R", f"{person.uid}:", f"{person.home}/.config"])
    open(mirrors, "w").write(f"# my own mirror\nServer = https://archive.archlinux.org/repos/{day}/$repo/os/$arch\n")
    out(ok=True, settings=os.path.basename(settings), maxAllowed=want["maxAllowed"], kbLayout=want["kbLayout"],
        idle_packaged=packaged)


def step_lived_in_check(version):
    """after the update through Restart, on that home: each thing an update has to get right on a computer already in
    use, as {name: [ok, words]}; None where this release gives nothing to judge"""
    person = Person()
    want = json.load(open(f"{STATE}/lived-home.json"))
    c = person.config()
    have = subprocess.run(["pacman", "-Q", "tacit"], capture_output=True, text=True).stdout.split()[-1:]
    try:
        result = json.load(open(UPDATE_RESULT))
    except (OSError, ValueError):
        result = None
    r = {}
    v = have[0].split("-")[0] if have else "none"
    r["updated"] = [v == version and bool((result or {}).get("ok")),
                    f"tacit {v} installed at the restart" if v == version else f"tacit is {v}, not {version} (the install said {result})"]
    m = dig(c, "audio.protection.maxAllowed")
    r["old volume default"] = [m == 100, f"Loudest allowed is {m}" + ("" if m == 100 else f" (it was {want['maxAllowed']}; 100 is the default now)")]
    k = dig(c, "hyprland.input.kbLayout")
    r["old keyboard default"] = [k == "", f"the saved keyboard is {k!r}" + ("" if k == "" else " (an old default: the layout installed is \"\")")]
    pins = dig(c, "dock.pinnedApps") or []
    lost = [p for p in want["pins"] if p not in pins]
    r["pins kept"] = [not lost, "every pin kept" if not lost else f"pins lost: {lost}"]
    w = dig(c, "background.wallpaperPath")
    r["wallpaper kept"] = [w == want["wallpaper"], "the wallpaper kept" if w == want["wallpaper"] else f"the wallpaper became {w!r}"]
    changed = {k2: dig(c, k2) for k2, v2 in want["choices"].items() if dig(c, k2) != v2}
    r["choices kept"] = [not changed, "the person's own settings kept" if not changed else f"changed back: {changed}"]
    idle = f"{person.home}/.config/hypr/hypridle.conf"
    packaged = want["packaged_idle"] and packaged_hypridle()
    now_text = open(packaged).read() if packaged else ""
    used = open(idle).read() if os.path.exists(idle) else now_text
    lock = re.search(r"timeout\s*=\s*(\d+)", used)
    if not want["idle_before"]:
        r["idle time kept"] = r["idle fixes reach"] = [None, "no packaged hypridle.conf was found to copy"]
    else:
        r["idle time kept"] = [bool(lock) and lock.group(1) == "600", f"the lock comes after {lock.group(1) if lock else '?'} s (the person chose 600)"]
    if not want["idle_before"]:
        pass
    elif idle_lines(want["idle_before"]) == idle_lines(now_text):
        r["idle fixes reach"] = [None, "the packaged hypridle.conf did not change in this release: nothing to reach"]
    else:
        stale = idle_lines(used) != idle_lines(now_text)
        r["idle fixes reach"] = [not stale, "hypridle reads this release's file (with the person's times)" if not stale else
                                 "hypridle still reads the old copy in the home: this release's changes to it never reach this computer"]
    system = ""
    if os.path.exists(VCONSOLE):
        sm = re.search(r"^XKBLAYOUT=[\"']?([^\"'\s]*)", open(VCONSOLE).read(), re.M)
        system = sm.group(1) if sm else ""
    kb = (person.hypr("getoption", "input:kb_layout") or {}).get("str", "")
    if system in ("", "us"):
        r["keyboard as installed"] = [None, "the computer was installed with a US keyboard: run with --lang de to judge it"]
    else:
        r["keyboard as installed"] = [kb == system, f"the keyboard is {kb!r}" + ("" if kb == system else f", not {system!r} as installed (the old Settings' kb_layout line still wins)")]
    session = subprocess.run(["pacman", "-Q", "tacit-session"], capture_output=True, text=True).stdout.split()[-1:]
    if session == want["session"]:
        r["mirror list"] = [None, "tacit-session did not change in this release: its upgrade step did not run"]
    else:
        has = "mirror.tacitos.co" in open(MIRRORS).read()
        r["mirror list"] = [has, "Tacit's server is in front of the person's own" if has else "the person's mirror list did not get Tacit's server: the package's upgrade step did not do its work"]
    bad = [n for n, (ok, _) in r.items() if ok is False]
    out(ok=not bad, checks=r, why="; ".join(f"{n}: {r[n][1]}" for n in bad) or None)


