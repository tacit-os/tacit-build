def now():
    return time.monotonic()


def ms(a, b):
    return round((b - a) * 1000, 1)


def stats(values):
    v = sorted(x for x in values if x is not None)
    if not v:
        return None
    n = len(v)
    med = v[n // 2] if n % 2 else (v[n // 2 - 1] + v[n // 2]) / 2
    return {"median": med, "low": v[0], "high": v[-1], "n": n}


# ---------------------------------------------------------------- the person at the desktop

class NoDesktop(Exception):
    pass


def starttime(pid):
    try:
        return int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[19])
    except (OSError, IndexError, ValueError):
        return 0


def pids():
    return [int(p) for p in os.listdir("/proc") if p.isdigit()]


class Person:
    """The owner of the oldest process that carries the desktop's environment (one the session started), and that
    environment (tools/vm-smoke-guest's session())."""

    def __init__(self):
        for pid in sorted(pids(), key=starttime):
            try:
                if os.stat(f"/proc/{pid}").st_uid < 1000:
                    continue
                raw = open(f"/proc/{pid}/environ", "rb").read().split(b"\0")
            except OSError:
                continue
            if not any(e.startswith(b"HYPRLAND_INSTANCE_SIGNATURE=") for e in raw):
                continue
            self.uid = os.stat(f"/proc/{pid}").st_uid
            self.envs = [e for e in raw if e]
            self.env = dict(e.decode(errors="surrogateescape").split("=", 1) for e in self.envs if b"=" in e)
            import pwd
            p = pwd.getpwuid(self.uid)
            self.user, self.home = p.pw_name, p.pw_dir
            self.shell = os.path.realpath(self.env.get("TACIT_SHELL", ""))
            self.runtime = self.env.get("XDG_RUNTIME_DIR", f"/run/user/{self.uid}")
            self.sig = self.env["HYPRLAND_INSTANCE_SIGNATURE"]
            return
        raise NoDesktop("nobody's desktop is up (no process carries HYPRLAND_INSTANCE_SIGNATURE)")

    def argv(self, argv, extra=None):
        envs = self.envs + [f"{k}={v}".encode() for k, v in (extra or {}).items()]
        return ["runuser", "-u", self.user, "--", "env", "-i", *envs, *argv]

    def run(self, argv, timeout=10, input=None, extra=None):
        """(exit code, output, errors) of argv run as the person; 124 when it ran past timeout"""
        try:
            p = subprocess.run(self.argv(argv, extra), input=input, capture_output=True, timeout=timeout)
            return p.returncode, p.stdout, p.stderr
        except subprocess.TimeoutExpired:
            return 124, b"", b"timed out"

    def text(self, argv, timeout=10):
        code, o, _ = self.run(argv, timeout)
        return o.decode(errors="replace").strip() if code == 0 else None

    def spawn(self, argv, extra=None, log="/dev/null"):
        """argv started by Hyprland, as a key or the dock starts a program: in the person's session, so polkit takes it
        for the person at the computer (a process started from here is in no session, and Settings' and Apps' password-free
        and password asks are refused to it)"""
        env = " ".join(f"{k}={sh(v)}" for k, v in (extra or {}).items())
        cmd = f"{'env ' + env + ' ' if env else ''}{' '.join(sh(a) for a in argv)} >{sh(log)} 2>&1"
        return self.dispatch(f"hl.dsp.exec_cmd([==[{cmd}]==])")

    def which(self, name):
        dirs = [self.env.get("TACIT_BIN", ""), f"{self.shell}/bin", f"{self.shell}/scripts/viewer"]
        for d in dirs + self.env.get("PATH", "").split(":"):
            if d and os.access(f"{d}/{name}", os.X_OK):
                return f"{d}/{name}"
        return name

    def hypr(self, *args):
        o = self.text(["hyprctl", "-j", *args], 5)
        try:
            return json.loads(o) if o else None
        except ValueError:
            return None

    def dispatch(self, expr):
        return self.run(["hyprctl", "dispatch", expr], 5)[0] == 0

    def layers(self):
        names = []
        for mon in (self.hypr("layers") or {}).values():
            for level in mon.get("levels", {}).values():
                names += [layer.get("namespace", "") for layer in level]
        return names

    def clients(self):
        return self.hypr("clients") or []

    def ipc(self, path, *args, timeout=3):
        """one IPC call to the quickshell instance running path: its answer, or None when it did not answer"""
        return self.text(["qs", "-p", path, "ipc", *args], timeout)

    def locked(self):
        sid = self.env.get("XDG_SESSION_ID") or subprocess.run(["loginctl", "show-user", self.user, "-p", "Display", "--value"],
                                                               capture_output=True, text=True).stdout.strip()
        o = subprocess.run(["loginctl", "show-session", sid, "-p", "LockedHint", "--value"], capture_output=True,
                           text=True).stdout.strip() if sid else ""
        return o == "yes"

    def shot(self):
        """the screen now, a quarter of its size (grim, as the person): (width, height, RGB bytes) or None"""
        for args in (["-s", "0.25"], []):
            code, o, _ = self.run(["grim", *args, "-t", "ppm", "-"], 15)
            if code == 0 and o:
                return parse_ppm(o)
        return None

    def config(self):
        try:
            return json.load(open(f"{self.home}/.config/illogical-impulse/config.json"))
        except (OSError, ValueError):
            return {}


def sh(s):
    return "'" + str(s).replace("'", "'\\''") + "'"


def parse_ppm(b):
    """a binary PPM's (width, height, RGB bytes)"""
    fields, i = [], 2
    if b[:2] != b"P6":
        return None
    while len(fields) < 3:
        while b[i:i + 1].isspace():
            i += 1
        if b[i:i + 1] == b"#":
            i = b.index(b"\n", i) + 1
            continue
        j = i
        while not b[j:j + 1].isspace():
            j += 1
        fields.append(int(b[i:j]))
        i = j
    w, h, _ = fields
    return w, h, b[i + 1:i + 1 + w * h * 3]


def fraction(img, test, step=3):
    """the share of the picture's pixels (every step-th one) for which test(r, g, b) holds"""
    if not img:
        return 0.0
    _, _, d = img
    hit = total = 0
    for i in range(0, len(d) - 2, 3 * step):
        total += 1
        hit += test(d[i], d[i + 1], d[i + 2])
    return hit / total if total else 0.0


def near(c, tol=40):
    return lambda r, g, b: abs(r - c[0]) <= tol and abs(g - c[1]) <= tol and abs(b - c[2]) <= tol


def closer(c, other):
    d = lambda r, g, b, k: (r - k[0]) ** 2 + (g - k[1]) ** 2 + (b - k[2]) ** 2
    return lambda r, g, b: d(r, g, b, c) < d(r, g, b, other)


# ---------------------------------------------------------------- pictures, a PDF and a page, made here

def png(w, h, row):
    """a PNG whose every row is the RGB bytes row(y)"""
    raw = b"".join(b"\0" + row(y) for y in range(h))
    chunk = lambda t, d: struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d))
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


def solid(w, h, c):
    line = bytes(c) * w
    return png(w, h, lambda y: line)


def pdf(c):
    """a one-page A4 PDF filled with the colour c"""
    page = f"{c[0] / 255:.3f} {c[1] / 255:.3f} {c[2] / 255:.3f} rg 0 0 595 842 re f".encode()
    objs = [b"<< /Type /Catalog /Pages 2 0 R >>", b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
            b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Contents 4 0 R >>",
            b"<< /Length %d >>\nstream\n" % len(page) + page + b"\nendstream"]
    body, offsets = b"%PDF-1.4\n", []
    for n, o in enumerate(objs, 1):
        offsets.append(len(body))
        body += b"%d 0 obj\n" % n + o + b"\nendobj\n"
    xref = len(body)
    body += b"xref\n0 %d\n0000000000 65535 f \n" % (len(objs) + 1) + b"".join(b"%010d 00000 n \n" % o for o in offsets)
    return body + b"trailer\n<< /Size %d /Root 1 0 R >>\nstartxref\n%d\n%%%%EOF\n" % (len(objs) + 1, xref)


