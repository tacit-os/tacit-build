def cdp_get(path, timeout=2):
    with urllib.request.urlopen(f"http://127.0.0.1:{CDP_PORT}{path}", timeout=timeout) as r:
        return json.load(r)


class CDP:
    """the DevTools protocol over a WebSocket of its own (no packages in the guest): tools/loadtime.js's calls"""

    def __init__(self, url, timeout=10):
        host, _, path = url.split("://", 1)[1].partition("/")
        h, _, p = host.partition(":")
        self.s = socket.create_connection((h, int(p or 80)), timeout=timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall((f"GET /{path} HTTP/1.1\r\nHost: {host}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                        f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
        head = b""
        while b"\r\n\r\n" not in head:
            c = self.s.recv(4096)
            if not c:
                raise OSError("the browser closed the connection")
            head += c
        head, self.buf = head.split(b"\r\n\r\n", 1)
        if b" 101 " not in head.split(b"\r\n")[0]:
            raise OSError(head.split(b"\r\n")[0].decode(errors="replace"))
        accept = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest())
        if accept not in head:
            raise OSError("a WebSocket answer with the wrong key")
        self.n, self.events = 0, []

    def _recv(self, n):
        while len(self.buf) < n:
            c = self.s.recv(65536)
            if not c:
                raise OSError("the browser closed the connection")
            self.buf += c
        d, self.buf = self.buf[:n], self.buf[n:]
        return d

    def _frame(self, op, data):
        mask = os.urandom(4)
        n = len(data)
        head = bytes([0x80 | op]) + (bytes([0x80 | n]) if n < 126 else bytes([0xFE]) + struct.pack(">H", n)
                                     if n < 65536 else bytes([0xFF]) + struct.pack(">Q", n))
        self.s.sendall(head + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

    def message(self):
        data = b""
        while True:
            b0, b1 = self._recv(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._recv(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._recv(8))[0]
            mask = self._recv(4) if b1 & 0x80 else None
            d = self._recv(n)
            if mask:
                d = bytes(b ^ mask[i % 4] for i, b in enumerate(d))
            op = b0 & 0x0F
            if op == 9:
                self._frame(10, d)
                continue
            if op == 8:
                raise OSError("the browser closed the connection")
            data += d
            if b0 & 0x80:
                return json.loads(data)

    def send(self, method, params=None):
        self.n += 1
        self._frame(1, json.dumps({"id": self.n, "method": method, "params": params or {}}).encode())
        while True:
            m = self.message()
            if m.get("id") == self.n:
                return m
            if "method" in m:
                self.events.append(m)

    def wait(self, method, timeout):
        end = now() + timeout
        while now() < end:
            for i, m in enumerate(self.events):
                if m["method"] == method:
                    del self.events[i]
                    return m
            self.s.settimeout(max(0.05, end - now()))
            try:
                m = self.message()
            except socket.timeout:
                break
            if "method" in m:
                self.events.append(m)
        return None

    def close(self):
        self.s.close()


def cdp_page():
    for t in cdp_get("/json"):
        if t.get("type") == "page" and t.get("webSocketDebuggerUrl"):
            return t["webSocketDebuggerUrl"]
    return None


def thyris_answers():
    try:
        c = CDP(cdp_page(), timeout=3)
        r = c.send("Runtime.evaluate", {"expression": "1+1", "returnByValue": True})
        c.close()
        return r.get("result", {}).get("result", {}).get("value") == 2
    except (OSError, ValueError, TypeError, AttributeError):
        return False


def windows(person, app):
    """the app's mapped windows"""
    cl = [c for c in person.clients() if c.get("mapped", True)]
    if app == "files":
        shell = set(qs_pids(person.uid, person.shell))
        return [c for c in cl if c.get("pid") in shell and c.get("title", "").startswith("Files")]
    if app == "thyris":
        return [c for c in cl if c.get("class") == "browser-cef" or is_thyris(c.get("pid", 0))]
    mine = set(qs_pids(person.uid, f"{person.shell}/{APP_QML[app]}"))
    return [c for c in cl if c.get("pid") in mine or (app == "settings" and c.get("class") == "settings")]


def answers(person, app):
    """the app answers on its own main loop: an IPC call it takes and returns, or for Thyris a script its page runs"""
    if app == "thyris":
        return thyris_answers()
    if app == "files":
        return bool(person.ipc(person.shell, "call", "files", "windows"))
    if app == "settings":
        return person.ipc(f"{person.shell}/tacit-settings.qml", "show") is not None
    return person.ipc(f"{person.shell}/{APP_QML[app]}", "call", APP_TARGET[app], "state") is not None


def running(person, app):
    if app == "files":
        return bool(windows(person, app))
    if app == "thyris":
        return any(is_thyris(p) for p in pids())
    return bool(qs_pids(person.uid, f"{person.shell}/{APP_QML[app]}"))


def launch(person, app, cdp=True):
    """the app started as the dock and the menu start it"""
    if app == "thyris":
        flags = f"--remote-debugging-port={CDP_PORT} --remote-allow-origins=*" if cdp else ""
        return person.spawn([person.which("thyris"), "about:blank"], {"QTWEBENGINE_CHROMIUM_FLAGS": flags})
    argv = {"settings": ["settings-open"], "files": ["files-open"], "praxis": ["claude-app"], "graphis": ["code-open"],
            "viewer": ["viewer-open", f"{STATE}/picture.png"]}[app]
    return person.spawn([person.which(argv[0]), *argv[1:]])


def quit_app(person, app):
    """as the dock's Quit does it; a process still there after 5 s is stopped (TERM, then KILL)"""
    if app == "files":
        for c in windows(person, app):
            person.dispatch(f'hl.dsp.focus({{ window = "address:{c["address"]}" }})')
            person.dispatch("hl.dsp.window.close()")
    elif app == "thyris":
        subprocess.run(["pkill", "-u", str(person.uid), "-f", "^/usr/lib/tacit/thyris/browser"])
    elif app == "settings":
        person.ipc(f"{person.shell}/tacit-settings.qml", "call", "settingsApp", "close")
    else:
        person.ipc(f"{person.shell}/{APP_QML[app]}", "call", APP_TARGET[app], "quitNow" if app == "graphis" else "quit")
    for sig in (None, signal.SIGTERM, signal.SIGKILL):
        if sig and app not in ("files",):
            for p in ([q for q in pids() if is_thyris(q)] if app == "thyris"
                      else qs_pids(person.uid, f"{person.shell}/{APP_QML[app]}")):
                try:
                    os.kill(p, sig)
                except OSError:
                    pass
        end = now() + 5
        while now() < end and running(person, app):
            time.sleep(0.1)
        if not running(person, app):
            return True
    return False


def start_app(person, app, cold, limit=45):
    """the app started (after a drop of the file cache for a cold start) until its window is mapped and it answers"""
    if running(person, app) and not quit_app(person, app):
        return {"ok": False, "why": f"{app} could not be closed before its start"}
    if cold:
        os.sync()
        open("/proc/sys/vm/drop_caches", "w").write("3\n")
        time.sleep(1)
    try:
        events = Events(person)
    except OSError:
        events = None
    t0 = now()
    launch(person, app)
    mapped = None
    end = t0 + limit
    while mapped is None and now() < end:
        if events:
            t, _ = events.wait(lambda line: line.startswith("openwindow>>"), min(1, end - now()), after=t0)
            if t is not None and windows(person, app):
                mapped = t
        else:
            time.sleep(0.05)
        if mapped is None and windows(person, app):
            mapped = now()      # mapped before this looked (an event missed), or no event socket: when it was seen
    if mapped is None:
        return {"ok": False, "why": f"no window of {app} within {limit} s"}
    answered = None
    while now() < end:
        if answers(person, app):
            answered = now()
            break
        time.sleep(0.05)
    if answered is None:
        return {"ok": False, "mapped_ms": ms(t0, mapped), "why": f"{app}'s window is there but {app} did not answer"}
    return {"ok": True, "mapped_ms": ms(t0, mapped), "answers_ms": ms(t0, answered)}


