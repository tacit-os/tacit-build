def language(person):
    """the language the desktop runs in (its session's LANG) and the keyboard as Hyprland has it"""
    kb = (person.hypr("getoption", "input:kb_layout") or {}).get("str", "")
    keymaps = [k.get("active_keymap", "") for k in (person.hypr("devices") or {}).get("keyboards", []) if k.get("main")]
    return {"lang": person.env.get("LANG", ""), "layout": kb, "active": keymaps[0] if keymaps else ""}


LANG_FILES = ["/etc/locale.conf", "/etc/locale.gen", "/etc/vconsole.conf", "/etc/X11/xorg.conf.d/00-keyboard.conf"]


def step_lang_set(locale, layout):
    """the computer set to another language and keyboard as Setup sets them at install (scripts/setup/tacit-install): the
    locale generated and in /etc/locale.conf, the layout in vconsole.conf (Hyprland reads it there) and X11's file, two
    layouts switched with Alt+Shift; what was there first is kept to put back. Takes effect at the next sign-in."""
    keep = f"{STATE}/lang-orig.json"
    if not os.path.exists(keep):
        json.dump({f: open(f).read() if os.path.exists(f) else None for f in LANG_FILES}, open(keep, "w"))
    supported = [line.strip() for line in open("/usr/share/i18n/SUPPORTED")]
    line = next((x for x in supported if x in (f"{locale} UTF-8", f"{locale.split('.')[0]} UTF-8")), None)
    if not line:
        out(ok=False, why=f"glibc has no {locale}")
    gen = open("/etc/locale.gen").read()
    if not re.search(rf"^{re.escape(line)}$", gen, re.M):
        open("/etc/locale.gen", "a").write(f"\n{line}\n")
    p = subprocess.run(["locale-gen"], capture_output=True, text=True)
    if p.returncode:
        out(ok=False, why=f"locale-gen: {p.stderr[-200:]}")
    open("/etc/locale.conf", "w").write(f"LANG={line.split()[0]}\n")
    options = "grp:alt_shift_toggle" if "," in layout else ""
    os.makedirs("/etc/X11/xorg.conf.d", exist_ok=True)
    open(LANG_FILES[3], "w").write('Section "InputClass"\n    Identifier "system-keyboard"\n    MatchIsKeyboard "on"\n'
                                   f'    Option "XkbLayout" "{layout}"\n' + (f'    Option "XkbOptions" "{options}"\n' if options else "")
                                   + "EndSection\n")
    open("/etc/vconsole.conf", "w").write(f"XKBLAYOUT={layout}\n" + (f"XKBOPTIONS={options}\n" if options else ""))
    out(ok=True, locale=line.split()[0], layout=layout)


