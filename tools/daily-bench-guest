    raw = person.text(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device", "status"]) or ""
    ok = bool(r.get("ip"))
    out(ok=ok, ip=r.get("ip"), lang=person.env.get("LANG"), nmcli=raw.splitlines()[:3],
        why=None if ok else ("the probe did not run: " + r["error"] if "error" in r else
