def step_wallpaper():
    """a picture of one colour made the wallpaper as the picker does it (the shell's wallpapers apply): the settings
    file holds it, and a screenshot shows it over most of the screen. Timed from the ask to the screenshot that shows it."""
    person = Person()
    materials()
    a, b = (f"{STATE}/wall-a.png", WALL_A), (f"{STATE}/wall-b.png", WALL_B)
    cur = person.config().get("background", {}).get("wallpaperPath", "")
    (target, tc), (_, oc) = (b, a) if cur == a[0] else (a, b)
    back, empty = empty_workspace(person)
    first = fraction(person.shot(), closer(tc, oc))
    if first >= 0.5:        # the person's own picture is nearer this colour than the other: the other is the test
        (target, tc), (_, oc) = (b, a) if target == a[0] else (a, b)
        first = fraction(person.shot(), closer(tc, oc))
    t0 = now()
    person.ipc(person.shell, "call", "wallpapers", "apply", target, timeout=5)
    shown, frac = None, first
    while now() < t0 + 15:
        frac = fraction(person.shot(), closer(tc, oc))
        if frac >= 0.5:
            shown = now()
            break
    saved = False
    while now() < t0 + 20:
        if person.config().get("background", {}).get("wallpaperPath") == target:
            saved = True
            break
        time.sleep(0.2)
    if back is not None:
        person.dispatch(f"hl.dsp.focus({{ workspace = {back} }})")
    why = []
    if not saved:
        why.append("the settings file does not hold the new picture")
    if shown is None:
        why.append(f"the screen did not show it (its colour on {frac:.0%} of the screen, before {first:.0%})"
                   + ("" if empty else "; a window covered the desktop"))
    out(ok=not why, shown_ms=ms(t0, shown) if shown else None, before=round(first, 3), after=round(frac, 3),
        why="; ".join(why) or None)


def step_files_preview():
    """Files opened at a picture and at a PDF (files reveal, as Open folder does): each is previewed, its colour on the
    screen over a preview's area (2 %, a preview column's picture is more than 3 %, a list's thumbnail far less)"""
    person = Person()
