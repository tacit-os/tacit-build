                     "journal": du("/var/log/journal"), "package cache": du("/var/cache/pacman/pkg"),
                     "crash dumps": du("/var/lib/systemd/coredump"), "shell logs": du(f"/run/user/{person.uid}/quickshell")},
        used_mb=round((st.f_blocks - st.f_bfree) * st.f_frsize / 2**20, 1))


def step_reliability():
    """since the mark: crashes (coredumpctl), errors in the journal, new warnings and errors in quickshell's logs (the
    shell and every app; QML ones named apart), and the "not answering" the sampler saw"""
    person, m = Person(), mark_file()
    since = f"@{int(m.get('wall', time.time()))}"
    crashes = []
    o = subprocess.run(["coredumpctl", "list", "--no-pager", "--json=short", f"--since={since}"], capture_output=True, text=True).stdout
    try:
        crashes = [{"exe": c.get("exe"), "sig": c.get("sig"), "time": c.get("time")} for c in json.loads(o or "[]")]
    except ValueError:
        pass
    journal = {}
    o = subprocess.run(["journalctl", "--no-pager", "-p", "err", f"--since={since}", "-o", "json"], capture_output=True, text=True).stdout
    for line in o.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        msg = e.get("MESSAGE")
        msg = msg if isinstance(msg, str) else "(binary)"
        key = f"{e.get('SYSLOG_IDENTIFIER') or e.get('_COMM') or '?'}: {re.sub(r'[0-9]+', 'N', msg)[:160]}"
        journal[key] = journal.get(key, 0) + 1
    problems = set()
    for log in qs_logs(person.uid):
        try:
            with open(log, errors="replace") as f:
                f.seek(m.get("logs", {}).get(log, 0))
                problems |= log_problems(f)
        except OSError:
            pass
    qml = sorted(p for p in problems if re.search(r"\.qml:N", p) and "Binding loop detected" not in p)
    anr = []
    try:
        anr = [json.loads(line) for line in open(f"{STATE}/anr.jsonl") if json.loads(line)["wall"] >= m.get("wall", 0)]
    except (OSError, ValueError):
        pass
    out(ok=True, crashes=crashes, journal=journal, qml=qml, warnings=sorted(problems - set(qml)), not_answering=anr)


