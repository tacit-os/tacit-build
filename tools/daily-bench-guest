        i = conf.find("\n[", conf.find("[options]") + 1)
        conf = conf[:i] + f"\n\n[daily-test]\nSigLevel = Optional TrustAll\nServer = file://{repo}\n" + conf[i:]
        open("/etc/pacman.conf", "w").write(conf)
    have = subprocess.run(["pacman", "-Q", PROBE], capture_output=True, text=True).stdout.split()
    if not have and n > 1:
        subprocess.run(["pacman", "-U", "--noconfirm", probe_package(repo, n - 1)], check=True, capture_output=True)
    out(ok=True, package=os.path.basename(pkg))


def probe_package(repo, n):
    import io, tarfile
    path = f"{repo}/{PROBE}-{n}-1-any.pkg.tar.gz"
    if os.path.exists(path):
        return path
    body = f"{n}\n".encode()
    info = (f"pkgname = {PROBE}\npkgbase = {PROBE}\npkgver = {n}-1\npkgdesc = Tacit Daily's update probe\n"
            f"url = https://tacitos.co\nbuilddate = {int(time.time())}\npackager = Tacit Daily\nsize = {len(body)}\n"
            f"arch = any\n").encode()
    with tarfile.open(path, "w:gz") as t:
        for name, data in ((".PKGINFO", info), (f"usr/share/{PROBE}/version", body)):
            ti = tarfile.TarInfo(name)
            ti.size, ti.mtime, ti.mode = len(data), int(time.time()), 0o644
            t.addfile(ti, io.BytesIO(data))
    return path


