def log_problems(lines):
    """warnings and errors, without their times, QML line numbers taken out (tools/vm-smoke-guest's errors())"""
    found = set()
    for line in lines:
        if re.search(r"\b(WARN|ERROR|CRIT|FATAL)\b", line):
            found.add(re.sub(r"(\.qml):\d+(:\d+)?", r"\1:N", re.sub(r"^[0-9-]+ [0-9:.]+ +", "", line)).strip())
    return found


