# ---------------------------------------------------------------- Hyprland's events and the kernel's keys

class Events:
    """Hyprland's event socket (.socket2.sock): each line with the time it was read. Read while waiting, so the time is
    the event's."""

    def __init__(self, person):
        self.s = socket.socket(socket.AF_UNIX)
        self.s.connect(f"{person.runtime}/hypr/{person.sig}/.socket2.sock")
        self.s.setblocking(False)
        self.buf = b""
        self.lines = []

    def pump(self, timeout):
        r, _, _ = select.select([self.s], [], [], max(0, timeout))
        if not r:
            return
        chunk = self.s.recv(65536)
        if not chunk:
            raise OSError("Hyprland closed its event socket")
        t = now()
        self.buf += chunk
        *done, self.buf = self.buf.split(b"\n")
        self.lines += [(t, line.decode(errors="replace")) for line in done]

    def wait(self, pred, timeout, after=0.0):
        """the time of the first line after `after` for which pred holds, or None"""
        end = now() + timeout
        while True:
            for i, (t, line) in enumerate(self.lines):
                if t >= after and pred(line):
                    del self.lines[:i + 1]
                    return t, line
            self.lines = [x for x in self.lines if x[0] >= after]
            if now() >= end:
                return None, None
            self.pump(end - now())


EVENT = "llHHi"     # struct input_event on a 64-bit kernel: the time (s, us), type, code, value
EVIOCSCLOCKID = 0x400445A0
EV_KEY = 1


class Keys:
    """The keyboard's and the pointer's input events (/dev/input/event*, read beside Hyprland, not grabbed), each with
    the kernel's time stamp on the monotonic clock: the moment the key reached this computer."""

    def __init__(self, devices=None):
        self.fds = []
        for d in devices if devices is not None else sorted(glob.glob("/dev/input/event*")):
            try:
                fd = os.open(d, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue
            try:
                fcntl.ioctl(fd, EVIOCSCLOCKID, struct.pack("i", time.CLOCK_MONOTONIC))
            except OSError:
                pass
            self.fds.append(fd)
        self.size = struct.calcsize(EVENT)

    def read(self, timeout):
        """the key events that came within timeout: [(time, code, value)]"""
        r, _, _ = select.select(self.fds, [], [], max(0, timeout))
        got = []
        for fd in r:
            try:
                data = os.read(fd, self.size * 64)
            except BlockingIOError:
                continue
            for i in range(0, len(data) - self.size + 1, self.size):
                sec, usec, typ, code, value = struct.unpack_from(EVENT, data, i)
                if typ == EV_KEY:
                    got.append((sec + usec / 1e6, code, value))
        return got


# what the press is (an input event's key code and value: 1 down, 0 up), and what shows it worked: a line from
# Hyprland's events, or a state looked for every 50 ms. The search is Super's release (the shell raises the dock when
# Super is let go alone); the notch, Super+Space's Space; its Esc; a click outside it; Enter at the sign-in and at the
# lock; Super+L's L.
SPECS = {
    "search": (125, 0, "openlayer>>quickshell:overview", 10),
    "notch-open": (57, 1, "openlayer>>quickshell:islandAway", 10),
    "notch-esc": (1, 1, "closelayer>>quickshell:islandAway", 10),
    "notch-click": (272, 1, "closelayer>>quickshell:islandAway", 10),
    "lock": (38, 1, "locked", 15),
    "enter-unlocked": (28, 1, "unlocked", 30),
    "enter-usable": (28, 1, "usable", 120),
}


def usable(person):
    """the desktop after the sign-in: the boot lock let go (its marker there, its process gone), the shell answers, the
    notch is on the screen"""
    if not os.path.exists(f"{person.runtime}/martida-lock-ready") or bootlock_pid(person.uid):
        return False
    return person.ipc(person.shell, "show") is not None and "quickshell:island" in person.layers()


def unlocked(person):
    return not person.locked() and person.ipc(person.shell, "show") is not None


def listen(spec, ident):
    """started apart by arm: waits for the press, then for what shows it worked, and leaves the times in a file"""
    code, value, shows, limit = SPECS[spec]
    res = f"{STATE}/press-{ident}.json"
    person = Person()
    keys = Keys()
    events = Events(person) if ">>" in shows else None
    open(f"{STATE}/press-{ident}.ready", "w").close()
    end, press = now() + 20, None
    while press is None and now() < end:
        for t, c, v in keys.read(0.05):
            if c == code and v == value:
                press = t
                break
        if events:
            events.pump(0)
    result = {"spec": spec, "ok": False}
    if press is None:
        result["why"] = "the key never came"
    elif events:
        t, _ = events.wait(lambda line: line == shows, limit, after=press)
        result.update(ok=t is not None, ms=ms(press, t) if t else None,
                      why=None if t else f"no {shows} within {limit} s of the press")
    else:
        check = {"locked": lambda: person.locked(), "unlocked": lambda: unlocked(person), "usable": lambda: usable(person)}[shows]
        t = None
        while now() < press + limit:
            if check():
                t = now()
                break
            time.sleep(0.05)
        result.update(ok=t is not None, ms=ms(press, t) if t else None,
                      why=None if t else f"not {shows} within {limit} s of the press")
    with open(res + ".tmp", "w") as f:
        json.dump(result, f)
    os.replace(res + ".tmp", res)


# ---------------------------------------------------------------- processes: who is who, memory, processor, wakeups

def cmdline(pid):
    try:
        return open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")[:-1]
    except OSError:
        return []


def qs_pids(uid, path):
    """the quickshell processes of uid running path (qs ... -p <path>), newest first"""
    want, found = os.path.realpath(path), []
    for pid in pids():
        try:
            if os.stat(f"/proc/{pid}").st_uid != uid or open(f"/proc/{pid}/comm").read().strip() not in ("qs", "quickshell"):
                continue
        except OSError:
            continue
        a = cmdline(pid)
        if a and os.path.realpath(a[-1].decode(errors="replace")) == want:
            found.append(pid)
    return sorted(found, key=starttime, reverse=True)


def is_thyris(pid):
    for _ in range(16):
        if pid <= 1:
            return False
        try:
            if os.readlink(f"/proc/{pid}/exe").startswith("/usr/lib/tacit/thyris/"):
                return True
            pid = int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError):
            return False
    return False


def bootlock_pid(uid):
    for pid in pids():
        a = b" ".join(cmdline(pid))
        if b"bootlock.qml" in a and b" ipc " not in a:
            try:
                if os.stat(f"/proc/{pid}").st_uid == uid:
                    return pid
            except OSError:
                pass
    return None


def tree(roots):
    """roots and every process under them"""
    kids = {}
    for pid in pids():
        try:
            ppid = int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError):
            continue
        kids.setdefault(ppid, []).append(pid)
    seen, todo = set(), list(roots)
    while todo:
        p = todo.pop()
        if p not in seen:
            seen.add(p)
            todo += kids.get(p, [])
    return seen


APP_QML = {"settings": "tacit-settings.qml", "praxis": "claude.qml", "graphis": "code.qml", "viewer": "viewer.qml"}
APP_TARGET = {"praxis": "claudeapp", "graphis": "code", "viewer": "viewer"}
APPS = ["settings", "files", "thyris", "praxis", "graphis", "viewer"]


def targets(person):
    """the processes measured: the shell (Files lives in it), each app, Hyprland and Praxis's agent host"""
    t = {"shell": qs_pids(person.uid, person.shell)[-1:]}
    for app, qml in APP_QML.items():
        t[app] = qs_pids(person.uid, f"{person.shell}/{qml}")[:1]
    t["thyris"] = [p for p in pids() if is_thyris(p) and not is_thyris(parent(p))]
    t["hyprland"], t["agent-host"] = [], []
    for pid in pids():
        try:
            comm = open(f"/proc/{pid}/comm").read().strip()
        except OSError:
            continue
        if comm == "Hyprland":
            t["hyprland"].append(pid)
        elif comm.startswith("tacit-agent-hos"):
            t["agent-host"].append(pid)
    return t


def parent(pid):
    try:
        return int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError):
        return 0


def pss_mb(ps):
    total = 0
    for p in ps:
        try:
            for line in open(f"/proc/{p}/smaps_rollup"):
                if line.startswith("Pss:"):
                    total += int(line.split()[1])
        except OSError:
            pass
    return round(total / 1024, 1)


def ticks(ps):
    """processor time used (clock ticks) and context switches (each one a sleep the thread was woken from, or taken
    off the processor), summed over the processes and their threads"""
    cpu = cs = 0
    for p in ps:
        try:
            f = open(f"/proc/{p}/stat").read().rsplit(")", 1)[1].split()
            cpu += int(f[11]) + int(f[12])
        except (OSError, ValueError, IndexError):
            continue
        for st in glob.glob(f"/proc/{p}/task/*/status"):
            try:
                for line in open(st):
                    if line.startswith(("voluntary_ctxt_switches", "nonvoluntary_ctxt_switches")):
                        cs += int(line.split()[1])
            except OSError:
                pass
    return cpu, cs


def system_ticks():
    cpu = [int(x) for x in open("/proc/stat").readline().split()[1:]]
    ctxt = next(int(line.split()[1]) for line in open("/proc/stat") if line.startswith("ctxt"))
    return sum(cpu), cpu[3] + cpu[4], ctxt


