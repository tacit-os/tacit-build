    import hashlib
    open(f"{media}/recipe", "w").write(hashlib.sha256(json.dumps([tool.MEDIA, tool.TONE, 600]).encode()).hexdigest()[:12] + "\n")
    return repo


def bench(tmp, repo, *args, **env):
    remote = f"{tmp}/remote"
    shutil.rmtree(remote, ignore_errors=True)
    os.makedirs(remote)
    e = {k: v for k, v in os.environ.items() if k != "TACIT_VM_PASSWORD"}
    e.update(PATH=f"{tmp}/bin:{os.environ['PATH']}", FAKE_REMOTE=remote, TACIT_SHELL_RELEASES=f"{tmp}/releases", **env)
    t = time.time()
    p = subprocess.run([sys.executable, f"{repo}/tools/daily-bench", *args], capture_output=True, text=True, env=e, timeout=1200)
    fake = json.load(open(f"{remote}/tacit-vm/fake.json")) if os.path.exists(f"{remote}/tacit-vm/fake.json") else {}
    log = open(f"{remote}/tacit-vm/daily/run.log").read() if os.path.exists(f"{remote}/tacit-vm/daily/run.log") else ""
    print(f"  ({time.time() - t:.0f} s)")
    return p, fake, log


def latest(repo, base):
    """the newest run of a kind: daily-1.2.15, then daily-1.2.15.2, ..."""
    names = [f[:-5] for f in os.listdir(f"{repo}/out/x86_64") if re.fullmatch(re.escape(base) + r"(\.\d+)?\.json", f)]
    return max(names, key=lambda n: int(n.rsplit(".", 1)[1]) if re.search(r"\.\d+$", n[len(base):]) else 1)


def read(repo, name):
    out = f"{repo}/out/x86_64/{name}"
    return json.load(open(out + ".json")), open(out + ".md").read()


def order(log, *items):
    """the items appear in the fake's log in this order"""
    at = 0
    for it in items:
        try:
            at = next(i for i in range(at, len(log)) if log[i].startswith(it)) + 1
        except StopIteration:
            return False
    return True


