#!/usr/bin/env python3
"""tools/daily-bench-test: tools/daily-bench against stand-ins, as tools/vm-smoke was checked: no VM, no cloud machine.
A copy of this checkout's tools in a scratch folder, with a stand-in tools/vm that answers each step the way a test
computer would (as a good release, or as a release with the faults 1.2.14 had and the OBS recording's dark window),
and a stand-in gcloud that runs the cloud machine's half here. Then the parts that can run for real on this computer:
the page-load method on a headless Chromium (Thyris's engine), the pictures, the PDFs and the screen arithmetic.
Exits non-zero on any failure."""
import importlib.machinery, json, os, shutil, subprocess, sys, tempfile, time

HERE = os.path.dirname(os.path.abspath(__file__))
FAILED = []


def check(what, cond, detail=""):
    print(f"  {'ok  ' if cond else 'FAIL'}  {what}{'' if cond else ': ' + str(detail)[:400]}")
    if not cond:
        FAILED.append(what)


