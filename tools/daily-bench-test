def lived_check(g, d, old_idle, new_idle, fixed):
    """step_lived_in_check run on stand-in files: the home after an update that got it right, or one that did not"""
    import contextlib, io
    os.makedirs(f"{d}/state")
    os.makedirs(f"{d}/home/.config/hypr")
    g.STATE, g.VCONSOLE, g.MIRRORS, g.UPDATE_RESULT = f"{d}/state", f"{d}/vconsole.conf", f"{d}/mirrorlist", f"{d}/update-result"
    open(g.VCONSOLE, "w").write("XKBLAYOUT=de\n")
    open(g.MIRRORS, "w").write("# Tacit\nServer = https://mirror.tacitos.co/$repo/os/$arch\n" if fixed else "Server = https://archive.example/$repo\n")
    open(g.UPDATE_RESULT, "w").write('{"ok": true}')
    open(f"{d}/hypridle.conf", "w").write(new_idle)
    g.packaged_hypridle = lambda: f"{d}/hypridle.conf"
    json.dump({"maxAllowed": 99, "kbLayout": "us", "pins": ["praxis", "foot", "org.mozilla.firefox"], "wallpaper": "/w.jpg",
               "choices": g.CHOICES, "idle_before": old_idle, "packaged_idle": f"{d}/hypridle.conf", "session": ["0.2.1-58"]},
              open(f"{d}/state/lived-home.json", "w"))
    cfg = {"audio": {"protection": {"maxAllowed": 100 if fixed else 99}}, "hyprland": {"input": {"kbLayout": "" if fixed else "us"}},
           "dock": {"pinnedApps": ["praxis", "foot", "org.mozilla.firefox"]}, "background": {"wallpaperPath": "/w.jpg"}}
    for k, v in g.CHOICES.items():
        g.dig(cfg, k, v, put=True)
    open(f"{d}/home/.config/hypr/hypridle.conf", "w").write(g.chosen_idle(new_idle if fixed else old_idle))

    class P:
        home = f"{d}/home"

        def config(self):
            return cfg

        def hypr(self, *a):
            return {"str": "de" if fixed else "us"}
    g.Person = P
    real_run = g.subprocess.run

    def pac(argv, **kw):
        if argv[:2] == ["pacman", "-Q"]:
            return subprocess.CompletedProcess(argv, 0, {"tacit": "tacit 1.2.15-1\n", "tacit-session": "tacit-session 0.2.1-59\n"}[argv[2]], "")
        return real_run(argv, **kw)
    g.subprocess.run = pac
    buf = io.StringIO()
    try:
        with contextlib.redirect_stdout(buf):
            g.step_lived_in_check("1.2.15")
    except SystemExit:
        pass
    finally:
        g.subprocess.run = real_run
    return json.loads(buf.getvalue().strip().splitlines()[-1])


