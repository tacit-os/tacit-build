def real_parts(tmp):
    print("the parts that run for real here")
    g = importlib.machinery.SourceFileLoader("guest", f"{HERE}/daily-bench-guest").load_module()
    s = importlib.machinery.SourceFileLoader("suites", f"{HERE}/daily-bench-suites").load_module()
    # the test patterns, decoded by tools that are not ours, and found by the pattern judge in what they decode to
    open(f"{tmp}/m.png", "wb").write(g.grid_png(480, 270, g.WALL_A_GRID))
    open(f"{tmp}/c.pdf", "wb").write(g.pdf(g.PDF_BANDS))
    open(f"{tmp}/two.pdf", "wb").write(s.two_page_pdf())
    if shutil.which("pdftoppm"):
        for f, grids in (("c.pdf", [g.PDF_BANDS]), ("two.pdf", s.VIEWER_PAGES)):
            r = subprocess.run(["pdftoppm", "-r", "20", f"{tmp}/{f}", f"{tmp}/p-{f}"], capture_output=True)
            imgs = sorted(x for x in os.listdir(tmp) if x.startswith(f"p-{f}"))
            found = [g.find_pattern(g.parse_ppm(open(f"{tmp}/{x}", "rb").read()), [[c] for c in bands], 0.5)[0]
                     for x, bands in zip(imgs, grids)]
            check(f"{f}: pdftoppm reads it, {len(grids)} page(s), each its bands top to bottom", r.returncode == 0
                  and len(imgs) == len(grids) and all(found), (r.stderr, imgs, found))
        r = subprocess.run(["pdftoppm", "-r", "20", f"{tmp}/two.pdf", f"{tmp}/q"], capture_output=True)
        first = g.parse_ppm(open(sorted(f"{tmp}/{x}" for x in os.listdir(tmp) if x.startswith("q"))[0], "rb").read())
        check("page 1 is not taken for page 2 (the bands the other way round)", not g.find_pattern(first, [[c] for c in s.VIEWER_PAGES[1]], 0.5)[0])
    else:
        print("  (no pdftoppm here: the PDFs not decoded)")
    if shutil.which("magick") or shutil.which("convert"):
        conv = shutil.which("magick") or shutil.which("convert")
        r = subprocess.run([conv, f"{tmp}/m.png", "ppm:-"], capture_output=True)
        check("the wallpaper pattern: ImageMagick reads it, and it is itself all over", r.returncode == 0
              and g.full_screen_match(g.parse_ppm(r.stdout), g.WALL_A_GRID) > 0.99)
    # the strict screen checks on made-up screens of 480x270 (a quarter of 1920x1080, as grim -s 0.25 gives them)
    W_, H_ = 480, 270

    def screen(grid=None, fill=(0, 0, 0), dim=1.0, cover=0.0, mirror=False):
        rows = []
        for y in range(H_):
            line = bytearray()
            for x in range(W_):
                if y < cover * H_:
                    c = (40, 40, 48)                        # the shell's bar and the like, over the top
                elif grid:
                    xx = W_ - 1 - x if mirror else x
                    c = grid[y * len(grid) // H_][xx * len(grid[0]) // W_]
                else:
                    c = fill
                line += bytes(int(v * dim) for v in c)
            rows.append(bytes(line))
        return (W_, H_, b"".join(rows))
    m = g.full_screen_match
    check("the wallpaper as itself, the bar over 10 % of the screen: shown", m(screen(g.WALL_A_GRID, cover=0.1), g.WALL_A_GRID) >= g.WALL_MATCH)
    check("dimmed by 10 %: still shown", m(screen(g.WALL_A_GRID, dim=0.9), g.WALL_A_GRID) >= g.WALL_MATCH)
    check("a black screen, whatever the settings say: not shown (2026-11-12)", m(screen(fill=(0, 0, 0)), g.WALL_A_GRID) < 0.05)
    check("the other wallpaper: not taken for this one", m(screen(g.WALL_B_GRID), g.WALL_A_GRID) < 0.2)
    check("mirrored: not shown", m(screen(g.WALL_A_GRID, mirror=True), g.WALL_A_GRID) < 0.5)
    check("a quarter of it covered: not shown (under 80 %)", m(screen(g.WALL_A_GRID, cover=0.25), g.WALL_A_GRID) < g.WALL_MATCH)

    def with_picture(grid, x0, y0, w, h, base=(235, 235, 240), blank=None):
        rows = []
        for y in range(H_):
            line = bytearray()
            for x in range(W_):
                if x0 <= x < x0 + w and y0 <= y < y0 + h:
                    r_, c_ = (y - y0) * len(grid) // h, (x - x0) * len(grid[0]) // w
                    line += bytes((128, 128, 128) if blank == (r_, c_) else grid[r_][c_])
                else:
                    line += bytes(base)
            rows.append(bytes(line))
        return (W_, H_, b"".join(rows))
    fp = g.find_pattern
    check("Files' preview of the picture (75x56 of 480x270, 3 %): found", fp(with_picture(g.PICTURE_GRID, 380, 60, 75, 56), g.PICTURE_GRID, g.PREVIEW_AREA)[0])
    check("a list's thumbnail of it (12x9): too small to be the preview", not fp(with_picture(g.PICTURE_GRID, 20, 40, 12, 9), g.PICTURE_GRID, g.PREVIEW_AREA)[0])
    check("the preview with one cell blank (half drawn): not found", not fp(with_picture(g.PICTURE_GRID, 380, 60, 75, 56, blank=(1, 1)),
                                                                           g.PICTURE_GRID, g.PREVIEW_AREA)[0])
    check("the PDF's bands in order: found", fp(with_picture([[c] for c in g.PDF_BANDS], 390, 30, 60, 85), [[c] for c in g.PDF_BANDS], g.PREVIEW_AREA)[0])
    check("the bands the other way round: not found", not fp(with_picture([[c] for c in reversed(g.PDF_BANDS)], 390, 30, 60, 85),
                                                            [[c] for c in g.PDF_BANDS], g.PREVIEW_AREA)[0])
    # settled, the wait helper, and the guest's mapping of what went wrong to the three outcomes
    shots = iter([screen(fill=(10, 10, 10)), screen(fill=(60, 60, 60)), screen(g.WALL_A_GRID), screen(g.WALL_A_GRID)])

    class Shots:
        def shot(self):
            return next(shots)
    got = g.settled(Shots(), 5)
    check("settled: the second of two equal screenshots in a row, after the changing ones", m(got, g.WALL_A_GRID) > 0.99)
    flick = iter([screen(fill=(0, 0, 0)), screen(fill=(255, 255, 255))] * 100)

    class Flicker:
        def shot(self):
            return next(flick)
    try:
        g.settled(Flicker(), 0.6)
        check("a screen that never stops changing: not settled", False)
    except g.Missed as e:
        check("a screen that never stops changing: not settled, said so", str(e).startswith("did not happen in 0.6 s: the screen settled"), str(e))
    t0 = time.time()
    try:
        g.until("a window of Settings mapped", lambda: False, 0.3, every=0.05)
    except g.Missed as e:
        check("until: on the deadline, \"did not happen in N s: <what>\", no sooner", str(e) == "did not happen in 0.3 s: a window of Settings mapped"
              and 0.3 <= time.time() - t0 < 0.6, (str(e), time.time() - t0))
    try:
        g.until("the key listener ready", lambda: False, 0.1, setup=True)
    except g.Unmeasurable:
        check("until on a step's own setup: could not measure, not a failure", True)
    n = [0]
    check("until gives the condition's value as soon as it holds", g.until("x", lambda: (n.__setitem__(0, n[0] + 1) or n[0] >= 3) and "yes", 5, every=0.01) == "yes")
    import contextlib, io
    g.STATE = f"{tmp}/state"
    for argv, want in ((["result", "nobody", "0.2"], "unmeasured"), (["start"], "unmeasured")):
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            try:
                g.main(argv)
            except SystemExit:
                pass
        r = json.loads(buf.getvalue().strip().splitlines()[-1])
        check(f"the guest's {argv[0]} without what it needs: {want}, said why", r["outcome"] == want and r["why"], r)
    # the OBS check's judging half: recordings encoded as OBS encodes them (x264), one of window B in use (light grey 225)
    # and one as inactive_opacity = 0.82 leaves it over black (184): read back by the step's own frame reader
    if shutil.which("ffmpeg"):
        rec = {}
        for name, grey in (("in-use", 225), ("not-in-use", round(225 * 0.82))):
            rec[name] = f"{tmp}/{name}.mkv"
            subprocess.run(["ffmpeg", "-v", "error", "-f", "lavfi", "-i", f"color=c=0x{grey:02X}{grey:02X}{grey:02X}:s=640x360:d=4:r=30",
                            "-c:v", "libx264", "-pix_fmt", "yuv420p", rec[name]], check=True)
        a, b = s.brightness(rec["in-use"]), s.brightness(rec["not-in-use"])
        check("a recording dimmed by inactive_opacity 0.82 reads back at about 82 % brightness", a and b and 0.79 < b / a < 0.85, (a, b))
        check("and the step calls it dark, naming inactive_opacity", (s.dark(b / a, 0.82) or "").startswith("the window not in use came out at 8")
              and "inactive_opacity is 0.82" in s.dark(b / a, 0.82), s.dark(b / a, 0.82))
