    if shutil.which("pdftoppm"):
        for f, pages, colours in (("c.pdf", 1, [g.CYAN]), ("two.pdf", 2, [(0, 255, 255), (255, 255, 0)])):
            r = subprocess.run(["pdftoppm", "-r", "20", f"{tmp}/{f}", f"{tmp}/p-{f}"], capture_output=True)
            imgs = sorted(x for x in os.listdir(tmp) if x.startswith(f"p-{f}"))
            ok = r.returncode == 0 and len(imgs) == pages and all(
                g.fraction(g.parse_ppm(open(f"{tmp}/{i}", "rb").read()), g.near(c), 1) > 0.95 for i, c in zip(imgs, colours))
            check(f"{f}: pdftoppm reads it, {pages} page(s) of the right colour", ok, (r.stderr, imgs))
    else:
        print("  (no pdftoppm here: the PDFs not decoded)")
    if shutil.which("magick") or shutil.which("convert"):
        conv = shutil.which("magick") or shutil.which("convert")
        r = subprocess.run([conv, f"{tmp}/m.png", "ppm:-"], capture_output=True)
        check("the PNG: ImageMagick reads it, all magenta", r.returncode == 0 and g.fraction(g.parse_ppm(r.stdout), g.near(g.MAGENTA), 1) == 1.0)
    else:
        import zlib
        raw = zlib.decompress(open(f"{tmp}/m.png", "rb").read()[33 + 8:-12])
        check("the PNG: its pixel data is magenta", raw[1:4] == bytes(g.MAGENTA))
    # the OBS check's judging half: recordings encoded as OBS encodes them (x264), one of window B in use (light grey 225)
    # and one as inactive_opacity = 0.82 leaves it over black (184): read back by the step's own frame reader
    if shutil.which("ffmpeg"):
        rec = {}
        for name, grey in (("in-use", 225), ("not-in-use", round(225 * 0.82))):
            rec[name] = f"{tmp}/{name}.mkv"
            subprocess.run(["ffmpeg", "-v", "error", "-f", "lavfi", "-i", f"color=c=0x{grey:02X}{grey:02X}{grey:02X}:s=640x360:d=4:r=30",
                            "-c:v", "libx264", "-pix_fmt", "yuv420p", rec[name]], check=True)
        a, b = s.brightness(rec["in-use"]), s.brightness(rec["not-in-use"])
        check("a recording dimmed by inactive_opacity 0.82 reads back at about 82 % brightness", a and b and 0.79 < b / a < 0.85, (a, b))
        check("and the step calls it dark, naming inactive_opacity", (s.dark(b / a, 0.82) or "").startswith("the window not in use came out at 8")
              and "inactive_opacity is 0.82" in s.dark(b / a, 0.82), s.dark(b / a, 0.82))
        check("a recording as bright as in use passes", s.dark(s.brightness(rec["in-use"]) / a, 1.0) is None)
    else:
        print("  (no ffmpeg here: the recording check's frames not read)")
    # the screen arithmetic on a made-up screenshot: 30 % red wallpaper, the rest grey
    w, h = 100, 50
    d = bytes(g.WALL_A) * (w * 15) + bytes((128, 128, 128)) * (w * 35)
    img = g.parse_ppm(b"P6\n# a comment\n%d %d\n255\n" % (w, h) + d)
    check("a screenshot's share of a colour", abs(g.fraction(img, g.closer(g.WALL_A, g.WALL_B), 1) - 0.3) < 0.01)
    check("stats: median and spread", g.stats([5, 1, 3]) == {"median": 3, "low": 1, "high": 5, "n": 3})
    # the log filter, as tools/vm-smoke-guest's
    lines = ["2026-11-12 10:00:00.123 WARN  qml: modules/ii/bar/Bar.qml:120:5: TypeError: x", "2026-11-12 10:00:01.000 INFO  fine"]
    check("QML errors without their times or line numbers", g.log_problems(lines) == {"WARN  qml: modules/ii/bar/Bar.qml:N: TypeError: x"})
    # the key listener, on a pipe of input events in the kernel's own layout
    import struct
    rfd, wfd = os.pipe()
    os.write(wfd, struct.pack(g.EVENT, 100, 250000, 4, 4, 7) + struct.pack(g.EVENT, 100, 500000, 1, 125, 0))
    k = g.Keys(devices=[])
    k.fds = [rfd]
    os.set_blocking(rfd, False)
    check("an input event's key and the kernel's time", k.read(1) == [(100.5, 125, 0)])
    # Hyprland's event socket, by a stand-in
    import socket, threading
    sock = f"{tmp}/hypr/sig/.socket2.sock"
    os.makedirs(os.path.dirname(sock))
    srv = socket.socket(socket.AF_UNIX)
    srv.bind(sock)
    srv.listen(1)
    def feed():
        c, _ = srv.accept()
        c.sendall(b"openlayer>>quickshell:bar\n")
        time.sleep(0.2)
        c.sendall(b"openlayer>>quickshell:overview\nopenwin")
        time.sleep(0.1)
        c.sendall(b"dow>>abc,1,x,y\n")
        time.sleep(1)
    threading.Thread(target=feed, daemon=True).start()
    P = type("P", (), {"runtime": tmp, "sig": "sig"})
    ev = g.Events(P())
    t0 = g.now()
    t, line = ev.wait(lambda x: x == "openlayer>>quickshell:overview", 3, after=t0)
    check("Hyprland's event, with the time it came", line == "openlayer>>quickshell:overview" and 0.15 < t - t0 < 1, (line, t and t - t0))
    t, line = ev.wait(lambda x: x.startswith("openwindow>>"), 3)
    check("an event split across two reads", line == "openwindow>>abc,1,x,y", line)
    # the page-load method (tools/loadtime's) and the call page, on a headless Chromium, Thyris's engine
    browser = shutil.which("chromium") or shutil.which("google-chrome-stable")
    if not browser:
        print("  (no Chromium here: the DevTools parts not run)")
        return
    g.materials = lambda: None
    www = f"{tmp}/www"
    g.fixture(www)
    import http.server
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), lambda *a: g.Quiet(*a, directory=www))
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    port = 9399
    prof = f"{tmp}/chromium"
    b = subprocess.Popen([browser, "--headless=new", "--disable-gpu", "--no-first-run", f"--user-data-dir={prof}",
                          f"--remote-debugging-port={port}", "--remote-allow-origins=*", "about:blank"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        g.CDP_PORT = port
        for _ in range(100):
            try:
                ws = g.cdp_page()
                break
            except OSError:
                time.sleep(0.1)
        check("a script runs in the page (how Thyris answers)", g.thyris_answers())
        rows = g.page_loads(ws, f"http://127.0.0.1:{srv.server_address[1]}/index.html", 3)
        check("three cold loads of the fixture page, each with its load and first paint",
              len(rows) == 3 and all(r.get("load", 0) > 0 and r.get("fcp", 0) > 0 and r["title"].startswith("daily ") for r in rows), rows)
        print("    ", rows[0])
        # the call page: the microphone has no device here and the screen has no picker; the peers and the counting do
        c = g.CDP(g.cdp_page(), timeout=20)
        c.send("Page.enable")
        os.makedirs(f"{tmp}/pages")
        open(f"{tmp}/pages/call.html", "w").write(s.PAGES["call.html"])
        open(f"{tmp}/pages/ide.html", "w").write(s.PAGES["ide.html"])
        srv2 = http.server.ThreadingHTTPServer(("127.0.0.1", 0), lambda *a: g.Quiet(*a, directory=f"{tmp}/pages"))
        threading.Thread(target=srv2.serve_forever, daemon=True).start()
        c.events.clear()
        c.send("Page.navigate", {"url": f"http://127.0.0.1:{srv2.server_address[1]}/ide.html"})
        c.wait("Page.loadEventFired", 20)
        c.send("Input.insertText", {"text": "x"})
        time.sleep(0.5)
        paints = json.loads(s.js(c, "JSON.stringify(window.paints)"))
        check("the web IDE page draws again on a key, with the wall-clock time of it", len(paints) == 1 and abs(paints[0] / 1000 - time.time()) < 5, paints)
        c.events.clear()
        c.send("Page.navigate", {"url": f"http://127.0.0.1:{srv2.server_address[1]}/call.html"})
        c.wait("Page.loadEventFired", 20)
        r = s.js(c, "window.call()", wait=True)
        check("the call page's peers connect and count what arrives (nothing to send here)", r == "{}", r)
        rr = json.loads(s.js(c, "JSON.stringify(window.r)"))
        check("no device and no permission here: the microphone is refused, and said so", str(rr.get("mic", "")).startswith("error:"), rr)
        open(f"{tmp}/pages/click.html", "w").write('<button id=b style="width:200px;height:60px" onclick="document.title = String(event.isTrusted)">b</button>')
        c.events.clear()
        c.send("Page.navigate", {"url": f"http://127.0.0.1:{srv2.server_address[1]}/click.html"})
        c.wait("Page.loadEventFired", 20)
        s.click(c, "document.getElementById('b')")
        time.sleep(0.3)
        check("the run's click is a person's click to the page (trusted: it may open a picker)", s.js(c, "document.title") == "true", s.js(c, "document.title"))
        c.close()
    finally:
        b.terminate()
        b.wait()
    # the call with something to send: Chromium's own stand-in microphone and camera, its permission prompt answered
    b = subprocess.Popen([browser, "--headless=new", "--disable-gpu", "--no-first-run", f"--user-data-dir={prof}2",
                          "--use-fake-device-for-media-stream", "--use-fake-ui-for-media-stream",
                          f"--remote-debugging-port={port}", "--remote-allow-origins=*", "about:blank"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        for _ in range(100):
            try:
                ws = g.cdp_page()
                break
            except OSError:
                time.sleep(0.1)
        c = g.CDP(ws, timeout=30)
        c.send("Page.enable")
        c.send("Page.navigate", {"url": f"http://127.0.0.1:{srv2.server_address[1]}/call.html"})
        c.wait("Page.loadEventFired", 20)
        time.sleep(2)
        rr = json.loads(s.js(c, "JSON.stringify(window.r)"))
        got = json.loads(s.js(c, "window.call()", wait=True) or "{}")
        check("a stand-in microphone and camera: live tracks, and the call carries the sound (bytes arrive)",
              rr.get("mic") == ["live"] and rr.get("camera") == ["live"] and got.get("audio", {}).get("bytes", 0) > 0, (rr, got))
        c.close()
    finally:
        b.terminate()
        b.wait()


def main():
    tmp = tempfile.mkdtemp(prefix="daily-bench-test.")
    try:
        if "--real-only" not in sys.argv:
            fake_runs(tmp)
        if "--fake-only" not in sys.argv:
            real_parts(tmp)
        if "--keep" in sys.argv:
            print("kept:", tmp)
    finally:
        if "--keep" not in sys.argv:
            shutil.rmtree(tmp, ignore_errors=True)
    print(f"\n{'all passed' if not FAILED else str(len(FAILED)) + ' FAILED: ' + '; '.join(FAILED)}")
