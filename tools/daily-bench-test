FAKE_GCLOUD = r'''#!/usr/bin/env python3
# a stand-in gcloud: the cloud machine is the folder in FAKE_REMOTE, its commands run here
import os, shutil, subprocess, sys
a, home = sys.argv[1:], os.environ["FAKE_REMOTE"]
def remote(p): return os.path.join(home, p.split(":", 1)[1].replace("~/", "")) if ":" in p and not p.startswith("/") else p
if a[:2] == ["compute", "ssh"]:
    cmd = a[a.index("--command") + 1]
    sys.exit(subprocess.run(["bash", "-c", cmd], env=dict(os.environ, HOME=home)).returncode)
if a[:2] == ["compute", "scp"]:
    src, dst = remote(a[-2]), remote(a[-1])
    if dst.endswith("/"): os.makedirs(dst, exist_ok=True)
    shutil.copy(src, dst)
    sys.exit(0)
sys.exit(f"fake gcloud: {a}")
'''


def setup(tmp):
    repo = f"{tmp}/repo"
    os.makedirs(f"{repo}/tools")
    os.makedirs(f"{repo}/tacit")
    os.makedirs(f"{repo}/out/x86_64")
    for f in ("daily-bench", "daily-bench-guest", "daily-bench-suites", "vm-smoke-guest"):
        shutil.copy(f"{HERE}/{f}", f"{repo}/tools/")
    open(f"{repo}/tools/vm", "w").write(FAKE_VM)
    os.chmod(f"{repo}/tools/vm", 0o755)
    json.dump({"releases": [{"version": "1.2.16"}, {"version": "1.2.15"}, {"version": "1.2.14"}]}, open(f"{repo}/tacit/notes.json", "w"))
    os.makedirs(f"{tmp}/bin")
    open(f"{tmp}/bin/gcloud", "w").write(FAKE_GCLOUD)
    os.chmod(f"{tmp}/bin/gcloud", 0o755)
    return repo


def bench(tmp, repo, *args, **env):
    remote = f"{tmp}/remote"
    shutil.rmtree(remote, ignore_errors=True)
    os.makedirs(remote)
    e = {k: v for k, v in os.environ.items() if k != "TACIT_VM_PASSWORD"}
    e.update(PATH=f"{tmp}/bin:{os.environ['PATH']}", FAKE_REMOTE=remote, **env)
    t = time.time()
    p = subprocess.run([sys.executable, f"{repo}/tools/daily-bench", *args], capture_output=True, text=True, env=e, timeout=1200)
    fake = json.load(open(f"{remote}/tacit-vm/fake.json")) if os.path.exists(f"{remote}/tacit-vm/fake.json") else {}
    log = open(f"{remote}/tacit-vm/daily/run.log").read() if os.path.exists(f"{remote}/tacit-vm/daily/run.log") else ""
    print(f"  ({time.time() - t:.0f} s)")
    return p, fake, log


def read(repo, name):
    out = f"{repo}/out/x86_64/{name}"
    return json.load(open(out + ".json")), open(out + ".md").read()


def order(log, *items):
    """the items appear in the fake's log in this order"""
    at = 0
    for it in items:
        try:
            at = next(i for i in range(at, len(log)) if log[i].startswith(it)) + 1
        except StopIteration:
            return False
    return True


def fake_runs(tmp):
    repo = setup(tmp)

    print("a good release (1.2.15), with every suite and the password")
    p, fake, log = bench(tmp, repo, "1.2.15", "--runs", "2", "--suite", "all", TACIT_VM_PASSWORD="pw-4711", FAKE_SCENARIO="good")
    check("it ends well", p.returncode == 0, p.stderr[-500:] + log[-800:])
    rec, md = read(repo, "daily-1.2.15")
    want = {k for k in ("sound", "wallpaper", "files-preview", "lock", "sleep", "update-check", "search", "notch", "praxis")}
