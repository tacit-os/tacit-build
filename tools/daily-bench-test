            pr = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "stream=codec_name:format=duration", "-of", "json", f],
                                capture_output=True, text=True)
            info = json.loads(pr.stdout or "{}")
            codecs = sorted(x["codec_name"] for x in info.get("streams", []))
            check(f"{os.path.basename(f)}: {video} with Opus sound, 3 s", codecs == sorted([video, "opus"])
                  and abs(float(info.get("format", {}).get("duration", 0)) - 3) < 0.2, (codecs, info.get("format")))
            frames = [subprocess.run(["ffmpeg", "-v", "error", "-ss", str(t), "-i", f, "-frames:v", "1", "-f", "image2pipe",
                                      "-vcodec", "ppm", "-"], capture_output=True).stdout for t in (0.5, 2.5)]
            check(f"{os.path.basename(f)}: the pattern moves", frames[0] and frames[1] and frames[0] != frames[1])
            raw = subprocess.run(["ffmpeg", "-v", "error", "-i", f, "-f", "s16le", "-ac", "1", "-ar", "16000", "-"], capture_output=True).stdout
            import struct
            n = len(raw) // 2
            peak = max((abs(v) for v in struct.unpack(f"<{n}h", raw[:n * 2])), default=0) / 32768 if n else 0
            check(f"{os.path.basename(f)}: the tone is in it (loudest sample {peak:.2f})", peak > 0.2)
