        json.dump({"configVersion": 4, "audio": {"protection": {"maxAllowed": 99}}, "hyprland": {"input": {"kbLayout": "us"}},
                   "dock": {"pinnedApps": ["praxis", "foot", "thyris"]}, "background": {"wallpaperPath": ""}}, open(f"{tmp}/releases/lived.json", "w"))
    # the local video, as made: small stand-ins under the recipe's stamp, so no 10-minute video is made here
