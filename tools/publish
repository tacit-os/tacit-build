#!/bin/bash
# tools/publish <package file> ...: signs Tacit packages and adds them to [tacit], the repo in the Google Cloud bucket
# (gs://tacit-packages-2aafc574/<arch>/, private while Tacit is). An "any" package goes into every arch's repo. Each
# package gets a detached signature by Tacit's signing subkey (tools/tacit-key; the keyring in
# ~/.config/tacit-packages/gnupg), the repo's database too. Older versions stay in the bucket, so an update can be
# taken back; the database names the newest only.
set -eu
bucket=gs://tacit-packages-2aafc574
mirror=${TACIT_REPO_MIRROR:-$HOME/.cache/tacit-repo}
export GNUPGHOME=$HOME/.config/tacit-packages/gnupg
export GPGKEY=$(cat "$HOME/.config/tacit-packages/signing-key")
[ $# -gt 0 ] || { echo "usage: tools/publish <package file> ..." >&2; exit 1; }
# the gate (RELEASE.md, step 6): nothing is signed or sent until tools/release-check passes for the Tacit this
# checkout's recipe names
here=$(dirname "$(dirname "$(readlink -f "$0")")")
release=$(cd "$here/tacit" && bash -c 'source PKGBUILD; echo "$pkgver"')
"$here/tools/release-check" "$release" || { echo "publish: tools/release-check $release did not pass; nothing was published" >&2; exit 1; }
# the exact pins (name=version) a package in the repo database $1 has on another of its packages, or on what one
# provides, that none there meets, each as "<pin>, which <packages> need"
unmet() {
	bsdtar -xOf "$1" --include '*/desc' 2>/dev/null | awk '
		/^%[A-Z0-9]+%$/ { k = $0; next }
		/^$/ { k = ""; next }
		k == "%NAME%" { n = $0; own[n] = 1 }
		k == "%VERSION%" { has[n "=" $0] = 1; v = $0; sub(/-[^-]*$/, "", v); has[n "=" v] = 1 }
		k == "%PROVIDES%" { has[$0] = 1; p = $0; sub(/[<>=].*/, "", p); own[p] = 1 }
		k == "%DEPENDS%" && /^[^<>=]+=[^=]/ { need[$0] = (need[$0] ? need[$0] " and " : "") n; c[$0]++ }
		END { for (d in need) { m = d; sub(/=.*/, "", m); if ((m in own) && !(d in has)) print d ", which " need[d] (c[d] > 1 ? " need" : " needs") } }' | sort
}
declare -A by_arch
for f in "$@"; do
	[ -f "$f" ] || { echo "publish: no file $f" >&2; exit 1; }
	a=$(bsdtar -xOf "$f" .PKGINFO | sed -n 's/^arch = //p')
	case "$a" in
		any) for each in aarch64 x86_64; do by_arch[$each]+=" $(readlink -f "$f")"; done ;;
		aarch64|x86_64) by_arch[$a]+=" $(readlink -f "$f")" ;;
		*) echo "publish: $f is for $a" >&2; exit 1 ;;
	esac
done
# the arches the bucket has a repo for; offline or signed out, nothing is published
held=$(gcloud storage ls "$bucket/") || { echo "publish: $bucket could not be read; nothing was published" >&2; exit 1; }
for a in "${!by_arch[@]}"; do
	dir=$mirror/$a
	mkdir -p "$dir"
	# the repo as the bucket has it (a first publish starts it). A copy that failed or stopped part way is the end: the
	# database made from it would name only these packages, and its upload would drop every other one from [tacit]
	if grep -qx "$bucket/$a/" <<<"$held"; then
		gcloud storage rsync -q "$bucket/$a" "$dir" || { echo "publish: $bucket/$a could not be copied; nothing was published for $a" >&2; exit 1; }
	fi
	# never back: a file older than the version the database names (an old build named by mistake, a glob that sorts
	# -100 before -77) would take its place, below what tacit pins, and every update would stop; -p below keeps the
	# newest of several given at once
	for f in ${by_arch[$a]}; do
		n=$(bsdtar -xOf "$f" .PKGINFO | sed -n 's/^pkgname = //p'); v=$(bsdtar -xOf "$f" .PKGINFO | sed -n 's/^pkgver = //p')
		had=$(tar -tf "$dir/tacit.db.tar.zst" 2>/dev/null | sed -n "s|^$n-\([0-9][^/]*\)/$|\1|p")
		[ -z "$had" ] || [ "$(vercmp "$v" "$had")" -ge 0 ] \
			|| { echo "publish: ${f##*/} is older than $n $had in [tacit] $a; nothing was published for $a" >&2; exit 1; }
		# nor another file under the same version: no computer that has it would update, and one that downloaded it
		# already would fail its signature (RELEASE.md, step 3: a version is never reused); the same file again is fine
		[ -z "$had" ] || [ "$(vercmp "$v" "$had")" != 0 ] || cmp -s "$f" "$dir/${f##*/}" \
			|| { echo "publish: ${f##*/} is not the $n $had in [tacit] $a: give it a new pkgrel; nothing was published for $a" >&2; exit 1; }
	done
	# no exact pin between [tacit]'s own packages broken by these (tacit-thyris and tacit-cef-sdk on tacit-cef=154.0.34): a
	# tacit-cef published without the Thyris built on it refused the whole update on every computer with Thyris. The
	# database these would make, in a copy, against the one there now
	t=$(mktemp -d)
	[ ! -f "$dir/tacit.db.tar.zst" ] || cp "$dir/tacit.db.tar.zst" "$t/"
	repo-add -q -p "$t/tacit.db.tar.zst" ${by_arch[$a]} >/dev/null
	broken=$(comm -13 <(unmet "$dir/tacit.db.tar.zst") <(unmet "$t/tacit.db.tar.zst"))
	rm -rf "$t"
	[ -z "$broken" ] || { echo "publish: [tacit] $a would then lack ${broken//$'\n'/; }: publish them together; nothing was published for $a" >&2; exit 1; }
	new=()
	for f in ${by_arch[$a]}; do
		cp -f "$f" "$dir/"
		gpg --batch --yes --detach-sign --no-armor -u "$GPGKEY" -o "$dir/$(basename "$f").sig" "$dir/$(basename "$f")"
		new+=("$dir/$(basename "$f")")
	done
	repo-add -q -p --sign --key "$GPGKEY" --verify "$dir/tacit.db.tar.zst" "${new[@]}"
	# the bucket has no links: the names pacman asks for as files
	for n in tacit.db tacit.files tacit.db.sig tacit.files.sig; do
		[ -L "$dir/$n" ] && cp --remove-destination "$(readlink -f "$dir/$n")" "$dir/$n"
	done
	# the packages and their signatures first, then the database that names them: sent together, in no set order, the
	# small database could land first, and a computer checking for updates meanwhile failed to retrieve a package
	gcloud storage rsync -q --exclude '^tacit\.(db|files)' "$dir" "$bucket/$a"
	gcloud storage rsync -q "$dir" "$bucket/$a"
	echo "[tacit] $a: $(printf '%s ' "${new[@]##*/}")"
done
