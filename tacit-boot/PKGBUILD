# Tacit: the boot splash - one picture from the first frame to the lock screen.
pkgname=tacit-boot
pkgver=0.3.0
pkgrel=4
pkgdesc="Tacit: boot and shutdown splash"
arch=('aarch64' 'x86_64')
url="https://github.com/ciscobugger/tacit-boot"
license=('GPL-3.0-or-later')
# The Hyprland plugins are built for one build of Hyprland: pin that build, Arch's pkgrel too, so Hyprland only moves when
# this package is rebuilt with it. Pinned by version alone, Arch's rebuild of 0.57.0 as -3 (against aquamarine 0.16 and
# hyprgraphics 0.6, whose structures the plugins read) went in under plugins built for -1: Hyprland's own check, its
# commit, was the same.
_hyprver=$(pacman -Q hyprland 2>/dev/null | cut -d' ' -f2)
depends=('libdrm' 'glib2' 'python' 'python-numpy' 'python-pillow' 'systemd' "hyprland=${_hyprver:-0}")
makedepends=('git' 'hyprland' 'pixman' 'pkgconf' 'libinput' 'libxkbcommon' 'wayland')
conflicts=('plymouth')
install=tacit-boot.install
source=("git+https://github.com/ciscobugger/tacit-boot.git#commit=8d4207641c2dbde6e3b979314c66a96eeee9eae9")
sha256sums=('SKIP')
options=('!debug')

build() {
	cd tacit-boot
	make
}

package() {
	cd tacit-boot
	install -Dm755 tacit-bootd tacit-boot-ground -t "$pkgdir/usr/lib/tacit/"
	install -Dm755 tacit-ground.so tacit-frame.so -t "$pkgdir/usr/lib/tacit/hyprland/"
	install -Dm644 tacit-bootd.service tacit-bootd-release.service tacit-shutdown.service \
		-t "$pkgdir/usr/lib/systemd/system/"
	install -Dm644 sddm.service.d/*.conf -t "$pkgdir/usr/lib/systemd/system/sddm.service.d/"
	install -Dm644 80-tacit-boot.preset -t "$pkgdir/usr/lib/systemd/system-preset/"
	install -Dm755 tacit-dusk -t "$pkgdir/usr/lib/tacit/"
	install -Dm644 tacit-dusk.service -t "$pkgdir/usr/lib/systemd/user/"
	install -Dm644 80-tacit-boot-user.preset "$pkgdir/usr/lib/systemd/user-preset/80-tacit-boot.preset"
}
