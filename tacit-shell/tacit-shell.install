# On for every person on the computer: the session's services start with it.
post_install() {
	systemctl --global preset focus-priority.service quiet-btagent.service quiet-filemanager1.service >/dev/null 2>&1 || true
}
# Once more at an update from before 1.0.2 (0.2.1-31), the first package with this step: a computer set up before it may
# never have had them on. Not on every update: the preset would turn a service back on for everyone after an
# administrator turned it off.
post_upgrade() {
	if (( $(vercmp "$2" 0.2.1-31) < 0 )); then
		post_install
	fi
}
