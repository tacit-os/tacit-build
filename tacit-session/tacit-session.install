# Tacit's updates on (session/updates: the background download, the install while the computer restarts), and a mirror
# list with a server in it
post_install() {
	systemctl preset tacit-fetch-updates.timer tacit-system-update.service >/dev/null 2>&1 || true
	_mirrors
	_nvidia
	_network
	_zsh
	_memory
	_keyring
}
post_upgrade() {
	post_install
}
# The mirror list: Tacit's tested copy of Arch (mirror.tacitos.co, Arch as it was on the day Tacit tested), so an update
# from Restart or from pacman installs that set and nothing newer. Moved there from the list Setup wrote before 1.0.2
# (Arch's worldwide mirrors, whatever Arch had that day) and from one with no server at all (the package's own has every
# line commented out, and then nothing could install or update). A list the person changed is theirs, but it gets Tacit's
# server in front when it has none: without it a full update came from Arch's newest day, whose Hyprland the plugins
# (tacit-boot, tacit-portal) are not built for, and refused. A mention of the server, even commented out, is the
# person's own choice and stays.
_mirrors() {
	local m=/etc/pacman.d/mirrorlist
	if [ "$(uname -m)" = aarch64 ]; then
		grep -q '^Server' "$m" 2>/dev/null || echo 'Server = http://mirror.archlinuxarm.org/$arch/$repo' > "$m"
		return
	fi
	local old='Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch'
	if ! grep -q '^Server' "$m" 2>/dev/null || [ "$(grep -v '^\s*$' "$m")" = "$old" ]; then
		printf '%s\n' '# Tacit: Arch as Tacit tested it. Updates come through here, from Restart or from pacman.' \
			'Server = https://mirror.tacitos.co/$repo/os/$arch' > "$m"
	elif ! grep -q 'mirror\.tacitos\.co' "$m"; then
		{ printf '%s\n' '# Tacit: Arch as Tacit tested it, ahead of your own servers. Comment the line out to use only your own.' \
			'Server = https://mirror.tacitos.co/$repo/os/$arch' ''; cat "$m"; } > "$m.tacit" && mv "$m.tacit" "$m"
	fi
}

# An NVIDIA display card: its video memory kept across sleep, by NVIDIA's own suspend services (NVIDIA's and the Arch
# wiki's setup). Off, sleep lost what the card held and Hyprland could die on waking (an RTX 4050 laptop, Discord
# 2026-10-20: both services disabled). A computer without the card, or without the driver, is left alone.
_nvidia() {
	local d card=0
	for d in /sys/bus/pci/devices/*; do
		[ "$(cat "$d/vendor" 2>/dev/null)" = 0x10de ] && case "$(cat "$d/class" 2>/dev/null)" in 0x03*) card=1 ;; esac
	done
	[ "$card" = 1 ] && [ -e /usr/lib/systemd/system/nvidia-suspend.service ] || return 0
	# done before (by an earlier upgrade or by Setup): the person's own choice since then stands
	local conf=/etc/modprobe.d/tacit-nvidia-sleep.conf
	[ -e "$conf" ] && return 0
	printf '%s\n' '# Tacit (tacit-session): NVIDIA video memory kept across sleep, for nvidia-suspend/-hibernate/-resume' \
		'options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp' > "$conf"
	systemctl enable nvidia-suspend.service nvidia-hibernate.service nvidia-resume.service >/dev/null 2>&1 || true
}

# Installs before 1.0.2 had systemd-networkd, its wait-online (two minutes of waiting at a start that asked for the
# network) and homed turned on beside NetworkManager by systemd's own first-boot preset. Off once, where NetworkManager
# runs and no networkd configuration says otherwise; from the next start (an update restarts anyway).
_network() {
	local done=/var/lib/tacit/network-presets
	[ -e "$done" ] && return 0
	systemctl is-enabled -q NetworkManager.service 2>/dev/null || return 0
	ls /etc/systemd/network/*.network >/dev/null 2>&1 && return 0
	systemctl disable systemd-networkd.service systemd-networkd.socket systemd-networkd-wait-online.service \
		systemd-homed.service >/dev/null 2>&1 || true
	mkdir -p /var/lib/tacit && touch "$done"
}

# zsh, for those who use it: Tacit's prompt, colours and aliases (/usr/share/tacit/zsh/tacit.zsh) from an /etc/zsh/zshenv
# of one line, written only where there is none (not a package file: one made by hand would stop the update). Removed
# with the package only while it is still that line.
_zsh_line='[[ -o interactive && -r /usr/share/tacit/zsh/tacit.zsh ]] && source /usr/share/tacit/zsh/tacit.zsh  # Tacit (tacit-session)'
_zsh() {
	[ -e /etc/zsh/zshenv ] && return 0
	mkdir -p /etc/zsh && printf '%s\n' "$_zsh_line" > /etc/zsh/zshenv
}
pre_remove() {
	[ "$(cat /etc/zsh/zshenv 2>/dev/null)" = "$_zsh_line" ] && rm -f /etc/zsh/zshenv
	return 0
}

# earlyoom turned on (computers installed before 1.2.9 too; 80-tacit-memory.preset says the same for presets):
# turned on once, its settings (memory/earlyoom.service.d) read first; the person's own choice since then stands
_memory() {
	local done=/var/lib/tacit/memory-guard
	[ -e "$done" ] && return 0
	systemctl daemon-reload >/dev/null 2>&1 || true
	systemctl enable --now earlyoom.service >/dev/null 2>&1 || true
	mkdir -p /var/lib/tacit && touch "$done"
}

# The lock's password opens the login keyring (computers installed before Setup did this, 2026-10-16, have neither line):
# PAM's login service, the one the lock checks the password with, hands it to gnome-keyring, and a password changed in
# Settings (passwd) changes the keyring's too. The keyring's socket is turned on where the login line was missing, as
# Setup's presets do. The lines are Setup's; written once, the person's own choice since then stands
_keyring() {
	local done=/var/lib/tacit/keyring-pam
	[ -e "$done" ] && return 0
	if _pam_line /etc/pam.d/login '-auth      optional     pam_gnome_keyring.so'; then
		systemctl --global preset gnome-keyring-daemon.socket >/dev/null 2>&1 || true
	fi
	_pam_line /etc/pam.d/passwd '-password  optional     pam_gnome_keyring.so use_authtok'
	mkdir -p /var/lib/tacit && touch "$done"
}
# the line at the end of the PAM file, on a line of its own, when the file is there and names no pam_gnome_keyring
_pam_line() {
	[ -f "$1" ] && ! grep -q pam_gnome_keyring "$1" || return 1
	[ -z "$(tail -c1 "$1")" ] || echo >> "$1"
	printf '%s\n' "$2" >> "$1"
}
